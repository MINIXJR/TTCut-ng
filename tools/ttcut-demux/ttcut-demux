#!/bin/bash
#
# ttcut-demux - Demux and normalize TS files for TTCut
# Similar to ProjectX for MPEG-2, but for H.264/H.265 (AVC/HEVC)
#
# Supported video codecs: H.264 (AVC), H.265 (HEVC), MPEG-2
# Supported audio codecs: MP2, AC3, EAC3 (DD+), AAC, MP3
#
# Multi-core optimization: Video and audio streams are extracted in parallel,
# audio padding also runs in parallel for all tracks.
#
# Usage: ttcut-demux [-e] [-A] [--subs|--no-subs] [-n name] <input.ts> [output_dir]
#
# Output: elementary streams (.264/.265/.m2v + audio files + .info).
# -e is accepted for compatibility (ES demux has always been the TTCut
# workflow and is the only mode since the normalized-MKV mode was removed).
#

set -e

# Track all temp files/dirs we create so a failure (set -e abort, SIGINT,
# disk-full, ...) doesn't leave multi-GB junk in $OUTDIR. Files are removed;
# directories are removed recursively (via rm -rf inside the trap below).
_CLEANUP_FILES=()
_CLEANUP_DIRS=()

# Audio-gap detection (Rev 1, existing function uses hardcoded 5.0; constant for documentation)
readonly GAP_THRESHOLD_AUDIO=5.0

_cleanup_temps() {
    local rc=$?
    if [ ${#_CLEANUP_FILES[@]} -gt 0 ]; then
        rm -f "${_CLEANUP_FILES[@]}" 2>/dev/null || true
    fi
    if [ ${#_CLEANUP_DIRS[@]} -gt 0 ]; then
        rm -rf "${_CLEANUP_DIRS[@]}" 2>/dev/null || true
    fi
    exit $rc
}
trap _cleanup_temps EXIT

# INT/TERM must abort the whole run, not just the current step. Bash defers
# the trap until the foreground child returns, and ffmpeg catches SIGINT and
# exits NORMALLY (trailer written, rc 255) - without an explicit abort exit
# here, a Ctrl-C would only skip the current ffmpeg invocation and the
# script would march on to the next step. Kill background jobs (parallel
# extraction / padding subshells), then exit 130; the EXIT trap above does
# the temp cleanup exactly once.
_abort_demux() {
    echo "" >&2
    echo "[ABORT] Interrupted - stopping and cleaning up" >&2
    local pids
    pids=$(jobs -p 2>/dev/null)
    [ -n "$pids" ] && kill $pids 2>/dev/null
    exit 130
}
trap _abort_demux INT TERM

# Colors for output (disabled when stdout is not a terminal)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    CYAN='\033[1;36m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    CYAN=''
    NC=''
fi

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }
step() { echo -e "${CYAN}[STEP]${NC} $1"; }

# Map an ffprobe codec_name to the file extension we use for the demuxed
# audio track.
audio_ext_for_codec() {
    case "$1" in
        mp2|mp3) echo "mp2" ;;
        ac3)     echo "ac3" ;;
        eac3)    echo "eac3" ;;
        aac)     echo "aac" ;;
        *)       echo "$1" ;;
    esac
}

# First video packet PTS of $1, codec-aware (reads $VIDEO_CODEC, so call
# only after stream discovery):
# H.264/H.265: minimum PTS over the first 2s = first DISPLAY frame (leading
# B-frames have a lower PTS than the I-frame that precedes them in decode
# order). MPEG-2: first packet PTS (the I-frame).
probe_first_video_pts() {
    local src=$1
    if [ "$VIDEO_CODEC" = "hevc" ] || [ "$VIDEO_CODEC" = "h265" ] || [ "$VIDEO_CODEC" = "h264" ]; then
        ffprobe -v error -select_streams v:0 -read_intervals "%+2" \
            -show_entries packet=pts_time -of csv=p=0 "$src" 2>/dev/null | \
            tr -d ',' | sort -n | head -1
    else
        ffprobe -v error -select_streams v:0 -show_entries packet=pts_time \
            -of csv=p=0 "$src" 2>/dev/null | head -1 | tr -d ','
    fi
}

# Probe audio stream properties of $1 into the APROBE_* globals.
# Values failing numeric validation become empty; the bitrate gets the
# codec-dependent default (mp2 192k, ac3 384k, aac 192k). sample_rate,
# channels, and channel_layout are left empty on probe failure — each call
# site applies its own fallback exactly as before. Shared by the mid-stream
# silence repair and the end-padding block; the two MECHANISMS stay separate
# by design (re-encode insert vs. bit-preserving concat padding).
#
# Known unfixable limitation: ffprobe cannot distinguish AC3 dual-mono
# (acmod 0, two independent mono programs) from stereo (acmod 2) — both
# report channel_layout=stereo. Silence generated for a dual-mono source
# therefore falls back to plain stereo; there is no ffprobe signal to do
# better.
probe_audio_props() {
    local af=$1
    APROBE_CODEC=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name \
        -of default=noprint_wrappers=1:nokey=1 "$af" 2>/dev/null)
    APROBE_SAMPLE_RATE=$(ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate \
        -of default=noprint_wrappers=1:nokey=1 "$af" 2>/dev/null)
    APROBE_CHANNELS=$(ffprobe -v error -select_streams a:0 -show_entries stream=channels \
        -of default=noprint_wrappers=1:nokey=1 "$af" 2>/dev/null)
    APROBE_BITRATE=$(ffprobe -v error -select_streams a:0 -show_entries stream=bit_rate \
        -of default=noprint_wrappers=1:nokey=1 "$af" 2>/dev/null)
    APROBE_CHANNEL_LAYOUT=$(ffprobe -v error -select_streams a:0 -show_entries stream=channel_layout \
        -of default=noprint_wrappers=1:nokey=1 "$af" 2>/dev/null)
    [[ "$APROBE_SAMPLE_RATE" =~ ^[0-9]+$ ]] || APROBE_SAMPLE_RATE=""
    [[ "$APROBE_CHANNELS" =~ ^[0-9]+$ ]] || APROBE_CHANNELS=""
    [[ "$APROBE_BITRATE" =~ ^[0-9]+$ ]] || APROBE_BITRATE=""
    # "unknown" is ffprobe's literal output when it cannot map the channel
    # count/config to a named layout; treat it the same as empty.
    [ "$APROBE_CHANNEL_LAYOUT" = "unknown" ] && APROBE_CHANNEL_LAYOUT=""
    case "$APROBE_CODEC" in
        mp2)  [ -n "$APROBE_BITRATE" ] || APROBE_BITRATE=192000 ;;
        ac3)  [ -n "$APROBE_BITRATE" ] || APROBE_BITRATE=384000 ;;
        aac)  [ -n "$APROBE_BITRATE" ] || APROBE_BITRATE=192000 ;;
    esac
}

# One shared filter for surfacing ffmpeg log lines as warnings (superset of
# the per-site patterns that existed before; may surface a few more lines).
readonly FFMPEG_WARN_PATTERN='error|warning|invalid|corrupt|failed|suppress|too many|repeated|mismatch'

# Echo matching lines of log file $1 as warnings, prefixed with $2 (optional).
# $3 (optional): extended regex; matching lines are skipped.
warn_ffmpeg_log() {
    local logfile=$1 prefix=${2:-} skip=${3:-}
    grep -iE "$FFMPEG_WARN_PATTERN" "$logfile" 2>/dev/null | \
        while IFS= read -r line; do
            [ -n "$skip" ] && [[ "$line" =~ $skip ]] && continue
            warn "${prefix}ffmpeg: $line"
        done
}

# Lines ffmpeg emits for one damaged packet. Only the middle one carries a
# position, so they are silenced as a group or not at all.
readonly FFMPEG_PACKET_CORRUPT_PATTERN='PES packet size mismatch|Packet corrupt \(stream|corrupt input packet in stream'
# How far from either end of the recording still counts as its edge. The
# partial packet a recording is cut off in measures 0.3-0.8 s from the end on
# real material; 2 s is generous towards that and still nowhere near the
# middle of a recording.
readonly FFMPEG_EDGE_WINDOW_S=2

# ffmpeg_audio_corruption_is_edge_only LOGFILE START_PTS DURATION_S
#
# True when the log holds at least one "Packet corrupt (stream = N, dts = M)"
# for an AUDIO stream (N != 0) and EVERY one of them sits within
# FFMPEG_EDGE_WINDOW_S of either end of the recording - i.e. the recording was
# cut mid-packet, which is normal and not worth a warning. False when any of
# them sits further in (then the whole group is reported as before, since the
# context-less companion lines cannot be attributed to one packet or another),
# and false when there are none at all - nothing to silence.
#
# Video (stream 0) is deliberately ignored: those packets already drive
# corrupt_frame_ranges further down.
ffmpeg_audio_corruption_is_edge_only() {
    local logfile=$1 start_pts=$2 duration=$3
    [ -r "$logfile" ] || return 1
    [ -n "$start_pts" ] && [ -n "$duration" ] || return 1

    local ticks
    ticks=$(grep -oE 'Packet corrupt \(stream = [1-9][0-9]*, dts = [0-9]+' "$logfile" 2>/dev/null \
            | grep -oE '[0-9]+$' || true)
    [ -n "$ticks" ] || return 1

    # A flag rather than "exit 1" in the body: awk's exit jumps to END, whose
    # own exit would overwrite the status and report every log as edge-only.
    echo "$ticks" | awk -v s="$start_pts" -v d="$duration" -v w="$FFMPEG_EDGE_WINDOW_S" '
        { off = $1 / 90000.0 - s
          if (off > w && off < d - w) inside = 1 }
        END { exit (inside ? 1 : 0) }'
}

# Detect audio packet gaps in source TS via ffprobe.
# Output format (one gap per line):
#   <gap_start_pts_source> <gap_end_pts_source> <gap_size_ms>
# All values are SOURCE PTS (relative to TS PCR, NOT first_video_pts).
# Conversion to frame indices happens later when first_video_pts is known.
#
# Threshold: caller-supplied (frame-scale, see Rev-2 block); anything smaller
# falls into the existing end-padding bucket, which handles sub-threshold
# drift cumulatively.
detect_audio_gaps() {
    local source_ts=$1 stream_index=$2 out_file=$3 threshold_s=$4
    : > "$out_file"
    ffprobe -v error -select_streams "$stream_index" -show_packets \
        -show_entries packet=pts_time "$source_ts" 2>/dev/null | \
    awk -F= -v threshold="$threshold_s" '
        /^pts_time=/ {
            curr = $2
            # Skip N/A or empty timestamps without updating prev (transparent to gap detection)
            if (curr == "N/A" || curr == "") next
            if (prev != "" && curr - prev > threshold) {
                gap_size_ms = (curr - prev) * 1000
                printf "%.6f %.6f %.0f\n", prev, curr, gap_size_ms
            }
            prev = curr
        }
    ' >> "$out_file"
}

# Detect video packet gaps in source TS via ffprobe.
# Outputs to $out_file: one line per gap, "prev_pts curr_pts gap_ms"
# (all PTS values are source-PTS, NOT relative).
#
# Used by classify_audio_gap() to decide whether an audio gap is part of
# a combined A+V transport-stream loss (in which case audio repair is skipped).
#
# Detection uses DTS (decode order), not PTS: ffprobe -show_packets emits
# packets in transport/decode order, and with B-frames present consecutive
# packet PTS values are NOT monotonic (B-frame display reordering swings
# them by 1-2 frame durations even with zero data loss). At the coarse
# Rev-1 threshold (1.0s) that reorder noise was harmless; at the frame-scale
# threshold below it would fire on every packet. DTS is monotonic in a
# healthy stream, so a DTS jump is the correct signal for an actual
# transport-stream discontinuity. The reported gap boundaries stay in the
# PTS domain (prev/curr packet's PTS) so callers doing overlap math against
# audio PTS gaps keep comparing like with like.
#
# Args:
#   $1 = source TS file path
#   $2 = output file path (will be truncated to empty if no gaps)
#   $3 = threshold in seconds (frame-scale, see Rev-2 block)
#
# NOTE: gap sizes are measured on decode-order boundaries; B-frame reorder lag
# can overestimate a gap by a few frame durations (bias is always upward).
detect_video_gaps() {
    local source_ts=$1 out_file=$2 threshold_s=$3
    : > "$out_file"
    ffprobe -v error -select_streams v:0 -show_packets \
        -show_entries packet=pts_time,dts_time "$source_ts" 2>/dev/null | \
    awk -F= -v threshold="$threshold_s" '
        /^pts_time=/ { curr_pts = $2 }
        /^dts_time=/ {
            curr_dts = $2
            # Skip N/A or empty timestamps without updating prev_* (transparent to gap detection)
            if (curr_dts == "N/A" || curr_dts == "" || curr_pts == "N/A" || curr_pts == "") next
            if (prev_dts != "" && curr_dts - prev_dts > threshold) {
                gap_size_ms = (curr_pts - prev_pts) * 1000
                printf "%.6f %.6f %.0f\n", prev_pts, curr_pts, gap_size_ms
            }
            prev_dts = curr_dts
            prev_pts = curr_pts
        }
    ' >> "$out_file"
}

# VDR multi-file variant of detect_video_gaps(): scans every segment (not
# just the first) and additionally reports the splice gap BETWEEN segments.
#
# Why this is needed: for a single-file recording, detect_video_gaps("$INPUT")
# sees the whole thing. For VDR multi-file, "$ORIGINAL_INPUT" was always just
# argv[1] (00001.ts) - segments 2..N were never scanned, so any real content
# loss inside them (corrupt GOPs, dropped packets) never reached
# es_missing_ranges=. Measured on a real 5-segment signal-loss recording:
# segment 3 alone had ~25s of within-segment holes invisible to the old scan.
#
# The 4 VDR_SEGMENTS files share ONE continuous PCR/PTS clock (this is a
# normal, size-triggered VDR split, not a new tuner session), so each
# segment's own start_time/duration are directly comparable absolute PTS -
# no coordinate translation needed, and this stays in the same domain as
# FIRST_VIDEO_PTS (which is also probed from raw, un-repaired input).
#
# The splice gap (end of segment i vs start of segment i+1) matters because
# the concat DEMUXER used later for extraction (see FFMPEG_INPUT_ARGS)
# stitches segments seamlessly - it re-bases segment i+1 to start right where
# segment i ended, silently discarding whatever real broadcast time separated
# them. From the merged output ES's point of view this is exactly like a
# within-segment hole (frame N is immediately followed by frame N+1 with no
# gap in the file, even though real content in between was never captured),
# so it is reported the same way.
#
# This function finds actual packet-level content loss at exact positions.
# An earlier, separate function additionally compared each segment's
# container-level PTS SPAN (last-first) between audio and video to catch
# small, systematic audio-trim-carry drift across boundaries; it was removed
# with the disturbance-zone model (build_disturbance_zones/build_zone_edits),
# which balances each zone once instead of accumulating per-row offsets.
detect_video_gaps_multifile() {
    local out_file=$1 threshold_s=$2
    : > "$out_file"
    local n=${#VDR_SEGMENTS[@]}
    local i seg_gaps prev_end=""
    for ((i = 0; i < n; i++)); do
        seg_gaps="${out_file}.seg${i}"
        _CLEANUP_FILES+=("$seg_gaps")
        detect_video_gaps "${VDR_SEGMENTS[$i]}" "$seg_gaps" "$threshold_s"
        cat "$seg_gaps" >> "$out_file"
        rm -f "$seg_gaps"

        local seg_start seg_dur
        # ffprobe's csv writer appends an empty trailing field to the stream
        # row for SOME streams, and the numeric test below rejects the
        # "1000.845000," that results. Measured on a VDR .ts: the video row
        # comes back "program,stream,1000.845000," while the audio row of the
        # same file is clean "program,stream,1000.000000"; a raw .m2v carries
        # the comma too, a raw .264 does not. So every probe of v:0 here fell
        # into the "ffprobe failed" branch and the splice gap was never
        # measured on any multi-file recording, while the audio function's
        # own track probes were unaffected - its fallback to video timing was
        # not. Stripping is a no-op where no comma appears, so it is applied
        # to every one of them. Same comma the count-check further down
        # strips; format= entries never carry it.
        # ffprobe emits the stream= row twice for a raw .ts segment (global
        # stream list + per-program stream list both match "v:0"); take the
        # first line only (same defensive pattern as START_PTS/NEW_VIDEO_PTS
        # above).
        seg_start=$(ffprobe -v error -select_streams v:0 -show_entries stream=start_time -of csv=p=0 "${VDR_SEGMENTS[$i]}" 2>/dev/null | head -1)
        seg_start="${seg_start%,}"
        seg_dur=$(ffprobe -v error -select_streams v:0 -show_entries stream=duration -of csv=p=0 "${VDR_SEGMENTS[$i]}" 2>/dev/null | head -1)
        seg_dur="${seg_dur%,}"
        if [[ "$seg_start" =~ ^[0-9]+\.?[0-9]*$ && "$seg_dur" =~ ^[0-9]+\.?[0-9]*$ ]]; then
            # %f formatting via awk (not bash's printf builtin, which is
            # locale-sensitive - a comma-decimal locale turns "3663.6" into
            # "3663,000000" here and corrupts every downstream PTS compare).
            if [ -n "$prev_end" ]; then
                awk -v ps="$prev_end" -v ss="$seg_start" -v th="$threshold_s" \
                    'BEGIN { if ((ss - ps) > th) printf "%.6f %.6f %.0f\n", ps, ss, (ss - ps) * 1000 }' >> "$out_file"
            fi
            prev_end=$(awk -v s="$seg_start" -v d="$seg_dur" 'BEGIN {printf "%.6f", s + d}')
        else
            echo "detect_video_gaps_multifile: ffprobe failed on segment $i (${VDR_SEGMENTS[$i]}) - splice gap around it not measured" >&2
            prev_end=""
        fi
    done
    sort -n -o "$out_file" "$out_file"
}

# VDR multi-file variant of detect_audio_gaps() - same rationale as
# detect_video_gaps_multifile() above, per audio track.
detect_audio_gaps_multifile() {
    local stream_idx=$1 out_file=$2 threshold_s=$3
    : > "$out_file"
    local n=${#VDR_SEGMENTS[@]}
    local i seg_gaps prev_end=""
    for ((i = 0; i < n; i++)); do
        seg_gaps="${out_file}.seg${i}"
        _CLEANUP_FILES+=("$seg_gaps")
        detect_audio_gaps "${VDR_SEGMENTS[$i]}" "$stream_idx" "$seg_gaps" "$threshold_s"
        cat "$seg_gaps" >> "$out_file"
        rm -f "$seg_gaps"

        local seg_start seg_dur
        # ffprobe's csv writer appends an empty trailing field to the stream
        # row for SOME streams, and the numeric test below rejects the
        # "1000.845000," that results. Measured on a VDR .ts: the video row
        # comes back "program,stream,1000.845000," while the audio row of the
        # same file is clean "program,stream,1000.000000"; a raw .m2v carries
        # the comma too, a raw .264 does not. So every probe of v:0 here fell
        # into the "ffprobe failed" branch and the splice gap was never
        # measured on any multi-file recording, while the audio function's
        # own track probes were unaffected - its fallback to video timing was
        # not. Stripping is a no-op where no comma appears, so it is applied
        # to every one of them. Same comma the count-check further down
        # strips; format= entries never carry it.
        # See detect_video_gaps_multifile() above: take the first line only.
        seg_start=$(ffprobe -v error -select_streams "$stream_idx" -show_entries stream=start_time -of csv=p=0 "${VDR_SEGMENTS[$i]}" 2>/dev/null | head -1)
        seg_start="${seg_start%,}"
        seg_dur=$(ffprobe -v error -select_streams "$stream_idx" -show_entries stream=duration -of csv=p=0 "${VDR_SEGMENTS[$i]}" 2>/dev/null | head -1)
        seg_dur="${seg_dur%,}"
        # A badly damaged segment can leave this track's own duration
        # unprobeable ("N/A" - ffprobe's fast container-index duration probe
        # returning N/A: observed on the real 5-segment fixture for the
        # AC3/mis tracks in the heaviest-corrupted segment). Falling back to
        # "" here would break the prev_end chain and silently drop the splice
        # gaps on BOTH sides of this segment. Fall back to the segment's own
        # video timing as the least-wrong estimate (assumes this track's
        # start/end roughly tracks video in that segment, which is the same
        # assumption the "no additional drift" fallback below makes).
        if [[ ! "$seg_start" =~ ^[0-9]+\.?[0-9]*$ || ! "$seg_dur" =~ ^[0-9]+\.?[0-9]*$ ]]; then
            echo "detect_audio_gaps_multifile: track $stream_idx duration unavailable on segment $i (${VDR_SEGMENTS[$i]}) - falling back to video timing for splice-gap purposes" >&2
            seg_start=$(ffprobe -v error -select_streams v:0 -show_entries stream=start_time -of csv=p=0 "${VDR_SEGMENTS[$i]}" 2>/dev/null | head -1)
            seg_start="${seg_start%,}"
            seg_dur=$(ffprobe -v error -select_streams v:0 -show_entries stream=duration -of csv=p=0 "${VDR_SEGMENTS[$i]}" 2>/dev/null | head -1)
            seg_dur="${seg_dur%,}"
        fi
        if [[ "$seg_start" =~ ^[0-9]+\.?[0-9]*$ && "$seg_dur" =~ ^[0-9]+\.?[0-9]*$ ]]; then
            # See detect_video_gaps_multifile() above: awk formatting only,
            # never bash's locale-sensitive printf builtin.
            if [ -n "$prev_end" ]; then
                awk -v ps="$prev_end" -v ss="$seg_start" -v th="$threshold_s" \
                    'BEGIN { if ((ss - ps) > th) printf "%.6f %.6f %.0f\n", ps, ss, (ss - ps) * 1000 }' >> "$out_file"
            fi
            prev_end=$(awk -v s="$seg_start" -v d="$seg_dur" 'BEGIN {printf "%.6f", s + d}')
        else
            echo "detect_audio_gaps_multifile: ffprobe failed on segment $i track $stream_idx (${VDR_SEGMENTS[$i]}) - splice gap around it not measured" >&2
            prev_end=""
        fi
    done
    sort -n -o "$out_file" "$out_file"
}

# Verschmilzt Video- und Audio-Gap-Fenster zu Stoerzonen.
#
# Eine Stoerzone ist ein Fenster auf der Quell-PTS-Achse, in dem mindestens
# einer der Stroeme Material verloren hat. Ein realer Sendeausfall trifft
# beide Stroeme zur selben Realzeit, aber der PES-Muxer-Vorlauf des Videos
# (0.5-1 s) verschiebt die Fenster gegeneinander - derselbe Ausfall erscheint
# als zwei Fenster. Frueher erzeugte das zwei Zeilen, die BEIDE den
# Positions-Offset erhoehten: ein Ausfall zaehlte doppelt (gemessen 2026-08-24
# auf "03x15": 26.328 + 26.480 statt ~26.4 s, jede spaetere Reparatur landete
# 26.4 s zu frueh, Ton lief 808 ms hinter dem Bild).
#
# Verschmelzen ist die sichere Richtung: die Bilanz einer Zone ist die Summe
# der Verluste je Strom, und Summen bleiben korrekt, egal wie grob gruppiert
# wird. Zu fein gruppieren erzeugt den Defekt; zu grob kostet hoechstens einen
# kleinen Versatz ueber die wenigen Sekunden zwischen zwei Zonen.
#
# Args: $1=Video-Gaps  $2=Audio-Gaps (eine Spur)  $3=Toleranz s  $4=Ausgabe
# Ausgabe je Zone: "zone_start zone_end video_lost_s audio_lost_s"
build_disturbance_zones() {
    local v_gaps=$1 a_gaps=$2 tol=$3 out=$4
    : > "$out"
    { [ -s "$v_gaps" ] && awk '{printf "%.6f %.6f v\n", $1, $2}' "$v_gaps"
      [ -s "$a_gaps" ] && awk '{printf "%.6f %.6f a\n", $1, $2}' "$a_gaps"
      true; } \
    | sort -g -k1,1 \
    | awk -v tol="$tol" '
        NR==1 { zs=$1; ze=$2 }
        NR>1 && $1 - ze > tol {
            printf "%.6f %.6f %.6f %.6f\n", zs, ze, vl, al
            zs=$1; ze=$2; vl=0; al=0
        }
        { if ($2 > ze) ze=$2
          if ($3=="v") vl += $2-$1; else al += $2-$1 }
        END { if (NR>0) printf "%.6f %.6f %.6f %.6f\n", zs, ze, vl, al }
      ' > "$out"
}

# Rechnet Stoerzonen in Reparatur-Edits um.
#
# balance = audio_lost - video_lost:
#   > 0  Ton hat mehr verloren  -> Stille einfuegen
#   < 0  Bild hat mehr verloren -> Ton kuerzen (Sync-Regel)
#   = 0  echter A+V-Ausfall     -> nichts zu tun, der Sync traegt sich selbst
#
# Der Offset acc waechst AUSSCHLIESSLICH um audio_lost. pos ist eine Position
# im getrimmten Ton-ES, und dorthin uebersetzt nur Ton-Verlust. Video-Verluste
# koennen den Offset nicht mehr erreichen - genau daran scheiterte das alte
# Zeilenmodell.
#
# Schwelle 20 ms: identisch zur bisherigen Untergrenze der frueheren,
# zeilenweisen Video-only-Kuerzung. Darunter rundet die Frame-Quantisierung
# der Assembly ohnehin auf 0 Frames, und eine alleinstehende Sub-Frame-
# Insertion hat 2026-08-17 eine Tonspur zerstoert (1-Frame-Datei, die der
# mp3-Demuxer nicht oeffnen kann).
#
# Args: $1=Zonendatei  $2=erster PTS des GETRIMMTEN Ton-ES
# Ausgabe je Edit: "pos_s balance_ms"
build_zone_edits() {
    local zones=$1 first_pts=$2
    [ -s "$zones" ] || return 0
    awk -v fp="$first_pts" -v thr=20 '
        { zs=$1; vl=$3; al=$4
          bal_ms = (al - vl) * 1000
          pos = zs - fp - acc
          if (pos < 0) pos = 0
          if (bal_ms >= thr || bal_ms <= -thr) printf "%.6f %.0f\n", pos, bal_ms
          acc += al }
    ' "$zones"
}

# audiofix_ranges_to_video_frames JUNK_CSV CRC_CSV FPS
# Takes "IDX@MS:BYTES,..." (junk_regions) and "IDX@MS-IDX@MS,..." or
# "IDX@MS,..." (crc_bad_frames — a single bad frame prints without the
# trailing "-..." part), extracts all ms positions, converts to video
# frames (ms/1000*fps) and clusters with the same <=2s rule as
# corrupt_frame_ranges. Output: "S-E,S-E,...".
audiofix_ranges_to_video_frames() {
    local junk_csv="$1" crc_csv="$2" fps="$3"
    { echo "$junk_csv" | tr ',' '\n' | grep -oP '@\K[0-9]+' ;
      echo "$crc_csv"  | tr ',' '\n' | grep -oP '@\K[0-9]+' ; } |
    sort -n | awk -v fps="$fps" '
        { f = int($1/1000*fps + 0.5); frames[n++] = f }
        END {
            if (n == 0) exit
            gap = 2*fps; s = frames[0]; e = frames[0]; out = ""
            for (i = 1; i < n; i++) {
                if (frames[i] - e <= gap) { e = frames[i] }
                else { out = out (out?",":"") s "-" e; s = frames[i]; e = frames[i] }
            }
            out = out (out?",":"") s "-" e
            print out
        }'
}

# format_ranges_hms RANGES FPS
# Render a frame-range CSV ("S-E,S-E,..." — an optional ":MS" suffix per
# range, as in es_missing_ranges, is ignored) human-readable for the log:
# "S-E (~H:MM:SS), ..." with the timestamp of each range start derived
# from the video frame rate. With no usable fps the ranges pass through
# without timestamps — the log line still names the frames.
# Width of the range text itself (the caller's message prefix sits in front of
# the first line) and the indent that marks every continuation line. A badly
# damaged recording produced a single 7189-character line here - unreadable in
# an editor, and it is the caller's last log line that the VDR wrapper puts in
# its progress dialog. Breaks are placed BETWEEN ranges, never inside one, so
# a wrapped list still reads as a list.
RANGES_WRAP_COLS=80
RANGES_WRAP_INDENT="           "

format_ranges_hms() {
    local ranges="$1" fps="$2"
    if ! awk -v f="$fps" 'BEGIN { exit (f+0 > 0) ? 0 : 1 }'; then
        echo "$ranges" | tr ',' '\n' | sed 's/:.*//' | awk -v w="$RANGES_WRAP_COLS" -v ind="$RANGES_WRAP_INDENT" '
            $0 != "" {
                if (n++ == 0) { line = $0; next }
                if (length(line) + 2 + length($0) > w) { out = out line ",\n" ind; line = $0 }
                else { line = line ", " $0 }
            }
            END { if (n) printf "%s%s\n", out, line }'
        return
    fi
    echo "$ranges" | tr ',' '\n' | awk -F'[-:]' -v fps="$fps" \
        -v w="$RANGES_WRAP_COLS" -v ind="$RANGES_WRAP_INDENT" '
        NF >= 2 {
            t = int($1 / fps)
            item = sprintf("%s-%s (~%d:%02d:%02d)", $1, $2,
                           int(t/3600), int((t%3600)/60), t%60)
            if (n++ == 0) { line = item; next }
            if (length(line) + 2 + length(item) > w) {
                out = out line ",\n" ind
                line = item
            } else {
                line = line ", " item
            }
        }
        END { if (n) printf "%s%s\n", out, line }'
}

# True playing time of a raw audio elementary stream, in seconds.
#
# Deliberately NOT ffprobe's format=duration: a raw ES has no container to
# ask, so ffprobe extrapolates the FIRST frame's bitrate across the whole file
# size. One bitrate switch - stereo 192k to 5.1 384k, i.e. the jump between a
# programme and its ad break - and the answer is off by whatever share of the
# file runs at the other rate. Measured on the Tux corpus AC3 (66.9% of frames
# at 192k, 33.1% at 384k): 2391.104s reported against 1797.056s real, +33%.
# That number feeds the drift arithmetic and the repair validation below, so a
# wrong one there discards a good repair or skips a needed pad.
#
# Reading the last packet's timestamp instead costs ~0.17s on a 57MB track
# (against ~0.08s for the wrong answer) and needs no frame duration passed in,
# so a sample-rate change cannot mislead it either. On damaged material it
# stays within a single codec frame of the truth - measured against
# constructed ground truth: junk bytes between frames +24ms, a half-written
# final frame +24ms, a 1000-frame hole exact - three orders of magnitude under
# the 1s tolerance the repair validation works with.
#
# Echoes the duration, or "0" (and returns non-zero) if the track is unreadable.
audio_es_duration() {
    local last
    last=$(ffprobe -v error -select_streams a:0 \
        -show_entries packet=pts_time,duration_time -of csv=p=0 "$1" 2>/dev/null | tail -1)
    if [ -z "$last" ]; then
        echo "0"
        return 1
    fi
    awk -v l="$last" 'BEGIN {
        n = split(l, f, ",")
        if (n < 1 || f[1] == "" || f[1] == "N/A") { print "0"; exit 1 }
        d = (n < 2 || f[2] == "" || f[2] == "N/A") ? 0 : f[2]
        printf "%.6f\n", f[1] + d
    }'
}

# Round a source time UP to the next whole codec-frame boundary.
#
# The two ways of cutting a span out of an elementary stream quantize in
# OPPOSITE directions: ffmpeg's output-side "-i file -ss X -to Y" keeps the
# packets with pts >= X and pts < Y (the frame at or AFTER the point), while
# the concat demuxer's inpoint lands on the frame at or BEFORE it. Feeding
# raw cut points to inpoint therefore gains roughly one extra frame per
# segment - measured 287 extra frames over 300 segments on the MP2 gate,
# which the duration validation in repair_audio_with_silence_inserts would
# reject outright. Pre-rounding every cut point onto the frame grid makes the
# one-pass concat select exactly the packet set the per-segment calls did
# (measured byte-identical on both gates).
quantize_up_to_frame() {
    awk -v x="$1" -v f="$2" 'BEGIN {
        k = int(x / f)
        if (x / f - k > 1e-9) k = k + 1
        printf "%.6f", k * f
    }'
}

# ---- Overall progress for a supervising wrapper ----
#
# A single 0..100 for THIS recording, written to a file the wrapper polls.
# It replaces the wrapper's own guess (bytes written into the output
# directory over 2.2x the input size), which froze for minutes whenever the
# work happened elsewhere - the gap repair writes into a hidden work dir -
# and was shown twice, raw in the label and again folded into the bar.
#
# The band widths are NOT fixed, because no fixed set fits: on a 6730-gap
# recording the repair measured 83% of a 184s run, on a clean one it is
# zero and the extraction is everything. So the repair band is sized once
# the gap count is known (progress_plan below), and collapses to nothing
# when there is nothing to repair.
#
# Two constants carry the modelling, both from one measured run
# (Futurama 06x03, 1.5 GB, 6730 gaps, warm page cache) and both approximate
# - a cold cache shifts the ratio. They only skew how fast the bar moves
# through a phase; it stays monotone and never freezes either way.
PROGRESS_MS_PER_GAP=23          # 6730 gaps took 153s of repair
PROGRESS_SECS_PER_GB=10         # pad + info file took ~16s for 1.5 GB

# The fixed marks below the repair band are spaced by measured duration, from
# a gapless 10.4 GB run on an idle machine (2026-08-26, 63s total): analysis
# 6s (no mark - several ffprobe calls with nothing to poll), remux 8s, ES
# extraction 8s, PTS analysis 13s, A/V check 6s, per-track gap detection 5s.
# The tail marks were spaced the same way: gap analysis 9s, padding 7s,
# offset plus info file under a second. Before that the tail sat at 2/10,
# 4/10 and 6/10 of the remaining band and all three fell into the last few
# seconds, so the upper half of the scale was never walked at all.
# Measure on an IDLE machine: a parallel transcode stretched the same run to
# 242s and shifted the phases against each other by up to a factor of eight.

PROGRESS_FILE=""
PROGRESS_LAST=-1
PROGRESS_REMUX_END=8            # where the timestamp-repair remux band ends
PROGRESS_PRE_END=40             # everything up to and including gap detection
PROGRESS_REPAIR_BASE=40         # where the repair band starts
PROGRESS_REPAIR_END=40          # and where it ends; equal = no repair

# Size the repair band once the gap count is known.
#
# It cannot be sized earlier - the count only exists after gap detection -
# so the phases before it report on a nominal 0..PROGRESS_PRE_END scale and
# whatever has been reached becomes the base here. The REMAINDER is then
# split between the repair and the tail by their estimated cost, which keeps
# the whole thing monotone by construction and needs no guess about the
# repair before anything is known about it. With no gaps the band is empty
# and the tail simply takes over.
progress_plan() {
    local gaps=$1 in_bytes=$2
    local repair_s tail_s
    repair_s=$(awk -v g="$gaps" -v m="$PROGRESS_MS_PER_GAP" 'BEGIN {printf "%.3f", g * m / 1000.0}')
    tail_s=$(awk -v b="$in_bytes" -v r="$PROGRESS_SECS_PER_GB" \
        'BEGIN {s = b / 1073741824.0 * r; if (s < 3) s = 3; printf "%.3f", s}')
    PROGRESS_REPAIR_BASE=$PROGRESS_LAST
    [ "$PROGRESS_REPAIR_BASE" -lt 0 ] && PROGRESS_REPAIR_BASE=0
    PROGRESS_REPAIR_END=$(awk -v base="$PROGRESS_REPAIR_BASE" -v r="$repair_s" -v t="$tail_s" \
        'BEGIN { f = r / (r + t); if (f > 0.9) f = 0.9; printf "%d", base + (100 - base) * f }')
}

progress_set() {
    local pct=$1
    [ -n "$PROGRESS_FILE" ] || return 0
    [ "$pct" -gt 100 ] && pct=100
    [ "$pct" -lt 0 ] && pct=0
    # Monotone: never pull the bar backwards, whatever a re-estimate says.
    [ "$pct" -le "$PROGRESS_LAST" ] && return 0
    PROGRESS_LAST=$pct
    printf '%s\n' "$pct" > "$PROGRESS_FILE" 2>/dev/null || true
}

# Map a 0..100 within the repair onto the overall scale.
progress_set_repair() {
    progress_set $(( PROGRESS_REPAIR_BASE + $1 * (PROGRESS_REPAIR_END - PROGRESS_REPAIR_BASE) / 100 ))
}

# Progress line for the gap repair, throttled to one line per five per cent.
#
# Covers the WHOLE repair, not just its ffmpeg call. Measured on a 3364-gap
# track: 76s in total, of which the first 38s go into reading the classified
# rows, coalescing them and building the concat list - all of it silent
# before this existed, so the caller's log line (which the VDR wrapper shows
# in its progress dialog) stood unchanged for half the phase.
#
# Bands, from that same measurement: intake 0-20, coalesce 20-25, assembly
# 25-50, concat 50-100. Capped at 99 - the "applied" line reports completion.
_REPAIR_PCT_LAST=-1
_REPAIR_TRACK_IDX=0
_REPAIR_TRACK_N=1
repair_progress() {
    local p=$1 label=$2
    [ "$p" -gt 99 ] && p=99
    [ "$p" -lt 0 ] && p=0
    [ "$p" -ge $((_REPAIR_PCT_LAST + 5)) ] || return 0
    _REPAIR_PCT_LAST=$p
    info "    ${label}: repairing... ${p}%"
    # Two tracks share one band, so track i contributes its own half.
    progress_set_repair $(( (_REPAIR_TRACK_IDX * 100 + p) / _REPAIR_TRACK_N ))
}

# Repair audio file by splitting at gap positions and inserting silence.
# Multi-gap support: N gaps -> N+1 audio segments + N silence segments.
#
# Args:
#   $1 = audio file path (will be replaced with repaired version)
#   $2 = classified gap file (one line per gap: src_start src_end gap_ms silence_ms)
#        silence_ms is the amount of silence to insert at the gap position.
#        For combined A+V loss: silence_ms = audio_gap_ms - matching_video_gap_ms
#        (often a small remainder like 256ms). For audio-only loss: silence_ms ≈ gap_ms.
#        Gaps with silence_ms=0 are skipped (no audio insertion needed).
#   $3 = first_audio_pts (the SOURCE PTS where this audio track starts;
#        gap positions in the audio FILE = src_pts - first_audio_pts)
#
# Returns 0 on success, non-zero on failure (audio file untouched on error).
repair_audio_with_silence_inserts() {
    local audio_file=$1 gap_file=$2 first_audio_pts=$3
    local audio_ext="${audio_file##*.}"
    local work_dir
    work_dir="$(dirname "$audio_file")/.gap_repair_$$"
    mkdir -p "$work_dir"

    # Probe original audio properties for silence generation
    probe_audio_props "$audio_file"
    local codec="$APROBE_CODEC"
    local sample_rate="${APROBE_SAMPLE_RATE:-48000}"
    local channels="${APROBE_CHANNELS:-2}"
    local channel_layout="$APROBE_CHANNEL_LAYOUT"
    local bitrate="$APROBE_BITRATE"

    # Per-entry arrays. silence_dur is signed: positive = insert silence of
    # that many seconds at pos; negative = truncate |dur| seconds from the
    # after-part at pos.
    local -a gap_positions
    local -a gap_durations  # signed seconds
    local accumulated_collapse=0

    _REPAIR_PCT_LAST=-1
    local rp_label rp_rows rp_row=0
    rp_label=$(basename "$audio_file")
    rp_rows=$(grep -c . "$gap_file" 2>/dev/null || echo 0)
    [ "$rp_rows" -gt 0 ] || rp_rows=1

    while IFS=' ' read -r src_start src_end gap_ms silence_ms; do
        rp_row=$((rp_row + 1))
        repair_progress $((rp_row * 20 / rp_rows)) "$rp_label"
        [ -z "$src_start" ] && continue
        # silence_ms exactly 0 means pure A+V loss (no patching needed)
        if [ "${silence_ms:-0}" = "0" ]; then
            accumulated_collapse=$(awk "BEGIN {printf \"%.6f\", $accumulated_collapse + ($src_end - $src_start)}")
            continue
        fi
        local pos dur source_gap
        pos=$(awk "BEGIN {printf \"%.6f\", $src_start - $first_audio_pts - $accumulated_collapse}")
        # silence_ms is signed; dur is signed in seconds
        dur=$(awk "BEGIN {printf \"%.6f\", $silence_ms / 1000.0}")
        source_gap=$(awk "BEGIN {printf \"%.6f\", $src_end - $src_start}")
        gap_positions+=("$pos")
        gap_durations+=("$dur")
        accumulated_collapse=$(awk "BEGIN {printf \"%.6f\", $accumulated_collapse + $source_gap}")
    done < "$gap_file"

    # --- Coalesce overlapping/touching gap windows ---
    # Dense micro-gap clusters (signal degrading gradually before a full
    # outage) can produce entries whose effective windows overlap: a
    # truncate entry (dur<0) at pos_i skips [pos_i, pos_i+|dur_i|), and if
    # the NEXT entry's pos_j falls inside that window, the assembly loop
    # below emits "-ss pos_i(effective) -to pos_j" with pos_j < the actual
    # cut point -> ffmpeg aborts with "-to value smaller than -ss", the
    # whole call fails, and the caller falls back to leaving the audio
    # unrepaired (see TODO.md, commit 9c345ea). Fix: merge any entry whose
    # pos lies inside the previous entry's effective window into one
    # combined edit at the earlier pos, summing the signed durations. This
    # only changes how the LOCAL edit operations are grouped for assembly;
    # it must NOT touch gap_positions/gap_durations semantics that later
    # entries were computed from - and it doesn't, because pos_j for every
    # entry was already fixed by the intake loop above from src_start/
    # accumulated_collapse, both of which are driven solely by each
    # original CLASSIFIED_FILE row's OWN src_start/src_end/gap_ms/
    # silence_ms (independent of how neighboring entries get grouped
    # later). Merging here only changes assembly bookkeeping, not any
    # position that has already been computed.
    if [ ${#gap_positions[@]} -gt 1 ]; then
        # Establish ascending pos order first. CLASSIFIED_FILE is sorted by
        # src_start, but gap_positions[] is NOT guaranteed ascending from
        # that alone: an audio-gap row and a video-only-truncation row can
        # cover overlapping SOURCE windows (e.g. a truncation row's
        # src_start falls inside the preceding audio-gap row's [src_start,
        # src_end)). accumulated_collapse advances by the full source_gap of
        # every processed row regardless of type, so when the next row's
        # src_start hasn't advanced past the previous row's src_end, its pos
        # (= src_start - accumulated_collapse) can end up EARLIER than the
        # previous entry's pos despite src_start being non-decreasing.
        # Measured on real Gate-1 (07x11) data: rows 2/3 in one track had
        # pos 96975.346633 then 96975.332900 (a ~13.7ms regression). The
        # merge sweep below only detects overlap looking forward, so it
        # requires true ascending pos order - sort explicitly rather than
        # relying on src_start order. This reorders only the local walk
        # used for grouping; it does not alter any already-computed pos or
        # dur value.
        local -a _sorted_pos=() _sorted_dur=()
        while IFS=' ' read -r sp sd; do
            _sorted_pos+=("$sp")
            _sorted_dur+=("$sd")
        done < <(paste -d' ' <(printf '%s\n' "${gap_positions[@]}") \
                             <(printf '%s\n' "${gap_durations[@]}") | sort -g -k1,1)
        gap_positions=("${_sorted_pos[@]}")
        gap_durations=("${_sorted_dur[@]}")

        local -a coalesced_positions=()
        local -a coalesced_durations=()
        local n_raw=${#gap_positions[@]}
        local ci=0
        while ((ci < n_raw)); do
            local cur_pos="${gap_positions[$ci]}"
            local cur_dur="${gap_durations[$ci]}"
            local window_end
            window_end=$(awk -v p="$cur_pos" -v d="$cur_dur" \
                'BEGIN {e = (d < 0) ? -d : 0; printf "%.6f", p + e}')
            local cj=$((ci + 1))
            while ((cj < n_raw)); do
                local next_pos="${gap_positions[$cj]}"
                # <= (not strict <): two back-to-back audio-gap rows with
                # zero source-time between them (row A's src_end == row B's
                # src_start) collapse to the SAME pos - a real, measured
                # case (Gate-1 track 2: two 0.216s/0.280s inserts both at
                # pos=3048.576000). A strict "<" leaves them unmerged, and
                # the assembly loop then emits a zero-width "-ss X -to X"
                # segment, which ffmpeg also rejects as "-to value smaller
                # than -ss". Touching windows must merge just like
                # overlapping ones.
                if ! awk -v np="$next_pos" -v we="$window_end" 'BEGIN {exit !(np <= we)}'; then
                    break
                fi
                local next_dur="${gap_durations[$cj]}"
                cur_dur=$(awk -v a="$cur_dur" -v b="$next_dur" 'BEGIN {printf "%.6f", a + b}')
                window_end=$(awk -v p="$cur_pos" -v d="$cur_dur" \
                    'BEGIN {e = (d < 0) ? -d : 0; printf "%.6f", p + e}')
                cj=$((cj + 1))
            done
            # A merged sum near zero means the combined edit is a no-op -
            # drop it instead of emitting a degenerate segment.
            if ! awk -v d="$cur_dur" 'BEGIN {a = (d < 0) ? -d : d; exit !(a < 0.001)}'; then
                coalesced_positions+=("$cur_pos")
                coalesced_durations+=("$cur_dur")
            fi
            ci=$cj
        done
        gap_positions=("${coalesced_positions[@]}")
        gap_durations=("${coalesced_durations[@]}")
    fi

    if [ ${#gap_positions[@]} -eq 0 ]; then
        rm -rf "$work_dir"
        return 0  # nothing to do
    fi

    # --- Segment-copy assembly (no re-encode of original content) ---
    # Silence template: encoded ONCE per parameter set, then trimmed per gap.
    # 40s covers every realistic single silence (huge gaps are A+V-shared ->
    # silence_ms~=0 there); a lone audio-only gap > 40s is YAGNI (would need
    # -stream_loop on the master) so it is capped with a warning instead.
    # Prefer the probed channel_layout (e.g. "3.0", "5.1(side)", "quad") over
    # a bare channel count: ffmpeg's DEFAULT layout for a count does not
    # always match the source's AC3 acmod (3ch defaults to 2.1 not 3.0/
    # surround; 4ch defaults to 4.0 not 2/2 quad). Spliced silence with the
    # wrong acmod is the exact defect this feature must avoid. Falls back to
    # "${channels}c" when the layout is unknown/unprobeable.
    local sil_layout="${channels}c"
    [ -n "$channel_layout" ] && sil_layout="$channel_layout"
    local sil_master="$work_dir/silence_master.${audio_ext}"
    ffmpeg -y -hide_banner -loglevel error \
        -f lavfi -t 40 -i "anullsrc=r=${sample_rate}:cl=${sil_layout}" \
        -c:a "$codec" -b:a "$bitrate" "$sil_master" || { rm -rf "$work_dir"; return 1; }
    # Codec frame duration, probed from the master itself (MP2@48k 24ms,
    # AC3 32ms, ...) - used to round each silence insert to the NEAREST
    # whole-frame amount below. Empty/zero on probe failure -> no rounding.
    local sil_frame_dur
    sil_frame_dur=$(ffprobe -v error -select_streams a:0 -show_entries \
        packet=duration_time -of csv=p=0 "$sil_master" 2>/dev/null | head -1)
    sil_frame_dur="${sil_frame_dur%,}"

    # Frame grid of the SOURCE track. Probed from the source and not reused
    # from sil_frame_dur above: the master is a re-encode that only happens
    # to share the grid, and the cut points below belong to the source.
    local src_frame_dur
    src_frame_dur=$(ffprobe -v error -select_streams a:0 -show_entries \
        packet=duration_time -of csv=p=0 "$audio_file" 2>/dev/null | head -1)
    src_frame_dur="${src_frame_dur%,}"

    # One-pass assembly: reference the SOURCE FILE directly with inpoint/
    # outpoint directives, the same way the silence master is already
    # referenced, instead of extracting every [prev_end, pos) span into its
    # own file first. The old form spawned one ffmpeg per gap with the seek
    # as an OUTPUT option ("-i file -ss pos"), so each call re-demuxed the
    # track from byte 0 up to pos - quadratic over the list, and measurably
    # so: the rate fell from 450 to 356 segments/min as pos grew from 958s to
    # 1548s on the recording that prompted this (3364 gaps in one track of
    # two, ~9 minutes each). Measured on identical input, this function
    # against its predecessor: 50.7s -> 11.7s (400 MP2 gaps), 32.6s -> 7.0s
    # (300 AC3 gaps), output byte-identical both times.
    # Dropping the per-segment files also drops the failure mode where
    # ffmpeg writes a 0-byte segment and still exits 0, which the concat
    # demuxer then chokes on mid-list (see the duration validation below).
    # Aligning the cut points needs the frame grid; without it, fall back to
    # the per-segment path, which is correct on its own - just slow.
    local use_onepass=false src_abs=""
    if awk -v f="${src_frame_dur:-0}" 'BEGIN {exit !(f > 0)}' 2>/dev/null; then
        use_onepass=true
        src_abs=$(readlink -f "$audio_file")
        # The list entry carries the real path now, and that path ends in the
        # user's -n basename ("Tatort - Der Fall O'Brien"). An apostrophe in
        # it closes the concat demuxer's quoted string early: measured, the
        # entry silently becomes "Der Fall OBrien_deu.ac3" and the whole list
        # fails to open. Escape it the way the demuxer expects - close, quote,
        # reopen. The old per-segment entries were generated basenames and
        # never carried user text, so this could not bite before.
        src_abs=${src_abs//\'/\'\\\'\'}
    fi

    local concat_list="$work_dir/concat.txt"
    : > "$concat_list"
    local prev_end=0 seg_idx=0 applied_sum=0
    local n=${#gap_positions[@]}
    local i
    for ((i = 0; i < n; i++)); do
        repair_progress $((25 + i * 25 / (n > 0 ? n : 1))) "$rp_label"
        local pos="${gap_positions[$i]}" dur="${gap_durations[$i]}"
        # Original segment [prev_end, pos) as a stream-copy
        if $use_onepass; then
            printf "file '%s'\ninpoint %s\noutpoint %s\n" "$src_abs" \
                "$(quantize_up_to_frame "$prev_end" "$src_frame_dur")" \
                "$(quantize_up_to_frame "$pos" "$src_frame_dur")" >> "$concat_list"
        else
            local seg="$work_dir/seg${seg_idx}.${audio_ext}"
            ffmpeg -y -hide_banner -loglevel error -i "$audio_file" \
                -ss "$prev_end" -to "$pos" -c copy "$seg" || { rm -rf "$work_dir"; return 1; }
            # ffmpeg's concat demuxer resolves relative "file" entries relative
            # to the DIRECTORY OF THE LIST FILE ITSELF, not the process CWD.
            # concat_list lives inside work_dir, and so do the segments - so a
            # work_dir-prefixed path here gets work_dir prepended TWICE by
            # ffmpeg (observed: "./.gap_repair_PID/./.gap_repair_PID/seg0.mp2",
            # "Impossible to open"). Write the basename only. The one-pass
            # branch above writes an ABSOLUTE path instead - it points outside
            # work_dir, and the concat call passes -safe 0 for exactly that.
            echo "file '$(basename "$seg")'" >> "$concat_list"
        fi
        seg_idx=$((seg_idx + 1))
        if awk "BEGIN {exit !($dur > 0)}"; then
            if awk "BEGIN {exit !($dur > 40)}"; then
                warn "repair_audio_with_silence_inserts: silence gap ${dur}s exceeds 40s master, capping"
                dur=40
            fi
            # Insert silence by referencing the MASTER with an outpoint
            # directive - never a per-gap trimmed file. A trim shorter than
            # 2 codec frames (e.g. 8ms of MP2) yields a 1-frame file the
            # mp3 demuxer cannot open ("Failed to find two consecutive
            # MPEG audio frames"); the concat demuxer then aborts the list
            # mid-way but ffmpeg still EXITS 0, silently truncating the
            # track to the first segment (measured 2026-08-17 "Gerber":
            # 16.464s left of a 7198s track).
            # Stream-copy quantizes to whole codec frames either way; round
            # to the NEAREST frame count (a plain outpoint=dur rounds UP,
            # costing up to a full frame of sync error per insert). n=0:
            # skip the insert entirely - the sub-half-frame remainder is a
            # smaller error than one full frame of silence. The half-frame
            # margin on the outpoint keeps float jitter in packet dts from
            # flipping the packet count at exact frame-multiple boundaries.
            local n_frames ins_dur
            if awk -v f="$sil_frame_dur" 'BEGIN {exit !(f > 0)}'; then
                n_frames=$(awk -v d="$dur" -v f="$sil_frame_dur" 'BEGIN {printf "%d", int(d/f + 0.5)}')
                ins_dur=$(awk -v n="$n_frames" -v f="$sil_frame_dur" 'BEGIN {printf "%.6f", n * f}')
            else
                n_frames=1
                ins_dur="$dur"
            fi
            if [ "$n_frames" -gt 0 ]; then
                printf "file '%s'\noutpoint %s\n" "$(basename "$sil_master")" \
                    "$(awk -v n="$n_frames" -v f="$sil_frame_dur" -v d="$ins_dur" \
                        'BEGIN {printf "%.6f", (f > 0) ? (n - 0.5) * f : d}')" >> "$concat_list"
                applied_sum=$(awk -v a="$applied_sum" -v d="$ins_dur" 'BEGIN {printf "%.6f", a + d}')
            fi
            prev_end="$pos"
        else
            local abs_dur
            abs_dur=$(awk -v d="$dur" 'BEGIN {printf "%.6f", (d<0)?-d:d}')
            prev_end=$(awk -v p="$pos" -v a="$abs_dur" 'BEGIN {printf "%.6f", p+a}')
            applied_sum=$(awk -v a="$applied_sum" -v d="$abs_dur" 'BEGIN {printf "%.6f", a - d}')
        fi
    done
    # Tail segment [prev_end, EOF) - no outpoint, it runs to the end.
    if $use_onepass; then
        printf "file '%s'\ninpoint %s\n" "$src_abs" \
            "$(quantize_up_to_frame "$prev_end" "$src_frame_dur")" >> "$concat_list"
    else
        local seg="$work_dir/seg${seg_idx}.${audio_ext}"
        ffmpeg -y -hide_banner -loglevel error -i "$audio_file" \
            -ss "$prev_end" -c copy "$seg" || { rm -rf "$work_dir"; return 1; }
        echo "file '$(basename "$seg")'" >> "$concat_list"
    fi

    # Expected result duration. Needed twice: as the yardstick for the
    # progress percentage below, and by the validation after the concat -
    # so it is measured once, here, before the long-running call.
    local orig_dur rep_dur exp_dur
    orig_dur=$(audio_es_duration "$audio_file")
    exp_dur=$(awk -v o="$orig_dur" -v s="$applied_sum" 'BEGIN {printf "%.6f", o + s}')

    # The concat is ONE ffmpeg call over the whole list, and it says nothing
    # until it is done - measured at ~70s per track on a recording with 3364
    # gaps, during which every caller watching the log (the VDR wrapper puts
    # the last line in its progress dialog) sees the same line and cannot
    # tell a slow repair from a hung one. Run it in the background against
    # -progress and report how far it has got.
    local repaired="$work_dir/repaired.${audio_ext}"
    local prog_file="$work_dir/progress.txt"
    : > "$prog_file"
    ffmpeg -y -hide_banner -loglevel error -progress "$prog_file" -nostats \
        -f concat -safe 0 -i "$concat_list" -c copy "$repaired" \
        2>>"$work_dir/repair.log" &
    local ff_pid=$! ff_rc=0 out_us pct
    while kill -0 "$ff_pid" 2>/dev/null; do
        sleep 2
        # out_time_us counts the output timeline in microseconds; against the
        # expected duration that is a percentage. Capped at 99 so a rounding
        # overshoot never announces completion before the call returns.
        out_us=$(grep '^out_time_us=' "$prog_file" 2>/dev/null | tail -1 | cut -d= -f2)
        [ -n "$out_us" ] || continue
        pct=$(awk -v u="$out_us" -v d="$exp_dur" \
            'BEGIN { p = (d > 0) ? int(u / (d * 10000.0)) : 0; if (p > 99) p = 99; if (p < 0) p = 0; print p }')
        repair_progress $((50 + pct / 2)) "$rp_label"
    done
    wait "$ff_pid" || ff_rc=$?
    [ "$ff_rc" -eq 0 ] || { rm -rf "$work_dir"; return 1; }

    # A clean exit code does NOT prove the concat succeeded: a mid-list
    # demux error ("Impossible to open ...") stops consuming the list but
    # ffmpeg still exits 0 with whatever prefix it wrote. Validate the
    # result duration against orig + sum of signed edits before replacing
    # the original; 1s tolerance covers per-edit frame rounding.
    rep_dur=$(audio_es_duration "$repaired")
    if ! awk -v r="$rep_dur" -v e="$exp_dur" 'BEGIN {d = r - e; if (d < 0) d = -d; exit !(d <= 1.0)}'; then
        warn "repair_audio_with_silence_inserts: result duration ${rep_dur}s deviates from expected ${exp_dur}s - keeping original"
        rm -rf "$work_dir"
        return 1
    fi

    # Replace original
    mv "$repaired" "$audio_file"
    rm -rf "$work_dir"
    return 0
}

# Parse arguments
ES_MODE=true   # ES demux is the only mode; -e is kept as a no-op for compatibility
AC3FIX=true
OUTPUT_NAME=""
EXPORT_SUBS=false   # subtitle export is opt-in (--subs); default: skip extraction
# Long-option shim: getopts only handles short options, so map the
# documented long forms onto their short equivalents before parsing.
_SHIM_ARGS=()
for _a in "$@"; do
    case "$_a" in
        --subs)    _SHIM_ARGS+=("-s") ;;
        --no-subs) _SHIM_ARGS+=("-S") ;;
        *)         _SHIM_ARGS+=("$_a") ;;
    esac
done
set -- "${_SHIM_ARGS[@]}"
unset _SHIM_ARGS _a
while getopts "ehAsSn:" opt; do
    case $opt in
        e) ES_MODE=true ;;
        A) AC3FIX=false ;;
        s) EXPORT_SUBS=true ;;
        S) EXPORT_SUBS=false ;;
        n) OUTPUT_NAME="$OPTARG" ;;
        h)
            echo "Usage: $0 [-e] [-A] [--subs|--no-subs] [-n name] <input.ts> [output_dir]"
            echo ""
            echo "Demux and normalize H.264/H.265/MPEG-2 TS files for TTCut."
            echo "Similar to ProjectX for MPEG-2."
            echo ""
            echo "Output: video.264/.265/.m2v + audio.mp2/.ac3/.eac3 + info file"
            echo "Filler NALUs are automatically stripped for H.264/H.265."
            echo ""
            echo "Options:"
            echo "  -e  Elementary stream mode (the default; kept for compatibility)"
            echo "  -A  Disable AC3 header repair (enabled by default)"
            echo "      Fixes corrupt acmod field in DVB AC3 streams (stereo->5.1)"
            echo "  --subs / -s     Export subtitle streams (DVB bitmap -> .mks,"
            echo "                  embedded SubRip -> .srt). Default: off."
            echo "  --no-subs / -S  Explicitly disable subtitle export (the default;"
            echo "                  wrappers pass one of the two so runs are explicit)"
            echo "  -n  Set output basename (default: input filename)"
            echo "      Example: -n 'Tatort' → Tatort.264, Tatort_deu.ac3, Tatort.info"
            echo ""
            echo "VDR Integration:"
            echo "  If a 'marks' file exists in the input directory (from vdr-plugin-markad),"
            echo "  the markers are automatically parsed and added to the .info file."
            echo "  See: https://github.com/kfb77/vdr-plugin-markad"
            echo ""
            echo "Examples:"
            echo "  $0 input.ts output_dir/           # Elementary stream output"
            echo "  $0 /video/rec/00001.ts .          # VDR recording (auto-concat splits)"
            echo "  $0 -n Tatort /video/rec/00001.ts  # VDR recording with custom name"
            echo "  $0 -A input.ts output_dir/        # ES without AC3 header repair"
            exit 0
            ;;
        \?) error "Invalid option: -$OPTARG" ;;
    esac
done
shift $((OPTIND-1))

# Check arguments
if [ -z "$1" ]; then
    echo "Usage: $0 [-e] [-A] [--subs|--no-subs] [-n name] <input.ts> [output_dir]"
    echo "Use -h for help."
    exit 1
fi

INPUT="$1"
ORIGINAL_INPUT="$1"  # Save original path before any modifications

# ffmpeg input expression as a bash array. Default for single-file recordings;
# overridden by the VDR multi-file detection block below to use the concat
# demuxer with a list file. ffprobe continues to use $INPUT directly.
declare -a FFMPEG_INPUT_ARGS
FFMPEG_INPUT_ARGS=(-i "$ORIGINAL_INPUT")

# Handle different extensions
BASENAME=$(basename "$INPUT")
BASENAME="${BASENAME%.*}"  # Remove any extension
OUTDIR="${2:-$(dirname "$INPUT")}"

# Check input file exists
[ -f "$INPUT" ] || error "Input file not found: $INPUT"

INPUT_DIR=$(dirname "$INPUT")

#############################################################################
# VDR MULTI-FILE DETECTION
# VDR splits recordings into 2GB segments: 00001.ts, 00002.ts, ...
# Automatically detect siblings and use ffmpeg concat protocol.
#############################################################################
VDR_MULTIFILE=false
VDR_SEGMENTS=()
INPUT_FILENAME=$(basename "$INPUT")

if [[ "$INPUT_FILENAME" =~ ^[0-9]{5}\.ts$ ]]; then
    # VDR >= 1.7.x format: 00001.ts, 00002.ts, ...
    VDR_PATTERN="[0-9][0-9][0-9][0-9][0-9].ts"
elif [[ "$INPUT_FILENAME" =~ ^[0-9]{3}\.vdr$ ]]; then
    # VDR < 1.7.x format: 001.vdr, 002.vdr, ...
    VDR_PATTERN="[0-9][0-9][0-9].vdr"
else
    VDR_PATTERN=""
fi

if [ -n "$VDR_PATTERN" ]; then
    while IFS= read -r -d '' seg; do
        VDR_SEGMENTS+=("$seg")
    done < <(find "$INPUT_DIR" -maxdepth 1 -name "$VDR_PATTERN" -print0 2>/dev/null | sort -z)

    if [ ${#VDR_SEGMENTS[@]} -gt 1 ]; then
        VDR_MULTIFILE=true
        # Build concat protocol string
        CONCAT_STR=""
        TOTAL_SIZE=0
        for seg in "${VDR_SEGMENTS[@]}"; do
            [ -n "$CONCAT_STR" ] && CONCAT_STR="${CONCAT_STR}|"
            CONCAT_STR="${CONCAT_STR}${seg}"
            seg_size=$(stat -c%s "$seg" 2>/dev/null || echo 0)
            TOTAL_SIZE=$((TOTAL_SIZE + seg_size))
        done
        INPUT="concat:${CONCAT_STR}"
        TOTAL_SIZE_GB=$(awk "BEGIN {printf \"%.1f\", $TOTAL_SIZE / 1073741824}")
        info "VDR multi-file recording detected: ${#VDR_SEGMENTS[@]} segments (${TOTAL_SIZE_GB} GB total)"
        for seg in "${VDR_SEGMENTS[@]}"; do
            info "  $(basename "$seg") ($(du -h "$seg" | cut -f1))"
        done
    fi
fi

# If -n was provided, override BASENAME
if [ -n "$OUTPUT_NAME" ]; then
    BASENAME="$OUTPUT_NAME"
fi

# Create output directory if needed
mkdir -p "$OUTDIR"

# Progress file for a supervising wrapper. Registered for cleanup, so it is
# gone when the run ends - including on an abort, which the EXIT trap covers.
PROGRESS_FILE="$OUTDIR/.${BASENAME}.progress"
_CLEANUP_FILES+=("$PROGRESS_FILE")
progress_set 0

# Write concat-demuxer list file for VDR multi-file recordings. ffmpeg's
# concat: protocol mishandles PTS resets at segment boundaries (audio
# packets discarded when DTS appears to go backward); the concat demuxer
# treats each segment as a separate input and stitches them logically,
# surviving PTS resets.
if [ "$VDR_MULTIFILE" = true ]; then
    CONCAT_LIST_FILE="$OUTDIR/.concat_list_$$.txt"
    : > "$CONCAT_LIST_FILE"
    for seg in "${VDR_SEGMENTS[@]}"; do
        # realpath: list file paths must be absolute, otherwise ffmpeg's
        # concat demuxer resolves them relative to the list file's own
        # directory (OUTDIR), not the working directory of ttcut-demux.
        printf "file '%s'\n" "$(realpath "$seg")" >> "$CONCAT_LIST_FILE"
    done
    _CLEANUP_FILES+=("$CONCAT_LIST_FILE")
    FFMPEG_INPUT_ARGS=(-f concat -safe 0 -i "$CONCAT_LIST_FILE")
fi

# Initialize cleanup flag for repaired temp file
CLEANUP_REPAIRED=false

# Check for VDR marks file (markad plugin)
MARKS_FILE=""
VDR_MARKS=()

if [ -f "$INPUT_DIR/marks" ]; then
    MARKS_FILE="$INPUT_DIR/marks"
elif [ -f "$INPUT_DIR/marks.vdr" ]; then
    MARKS_FILE="$INPUT_DIR/marks.vdr"
fi

if [ -n "$MARKS_FILE" ]; then
    info "Found VDR marks file: $MARKS_FILE"

    # Parse marks file
    # Format: H:MM:SS.FF [( FRAME) [*] start|stop method ...]
    while IFS= read -r line || [ -n "$line" ]; do
        # Skip empty lines and comments
        [[ -z "$line" || "$line" =~ ^# ]] && continue

        # Extract timestamp (first field, format H:MM:SS.FF)
        timestamp=$(echo "$line" | grep -oE '^[0-9]+:[0-9]{2}:[0-9]{2}\.[0-9]{2}')
        [ -z "$timestamp" ] && continue

        # Extract frame number if present
        frame=$(echo "$line" | grep -oE '\( *[0-9]+\)' | grep -oE '[0-9]+' | head -1)

        # Determine marker type (start = content starts, stop = content stops/ad starts)
        marker_type="mark"
        if echo "$line" | grep -qi "start"; then
            marker_type="start"  # Content starts (ad ends)
        elif echo "$line" | grep -qi "stop"; then
            marker_type="stop"   # Content stops (ad starts)
        fi

        # Check if verified (has *)
        verified=""
        echo "$line" | grep -q '\*' && verified="*"

        # Store marker: timestamp|frame|type|verified
        VDR_MARKS+=("$timestamp|${frame:-0}|$marker_type|$verified")

    done < "$MARKS_FILE"

    info "  Found ${#VDR_MARKS[@]} markers"
fi

info "Analyzing: $INPUT"
info "Mode: Elementary Stream (for TTCut)"
echo ""

# Get stream information with language tags
VIDEO_STREAM=""
AUDIO_STREAMS=()
SUBTITLE_STREAMS=()
VIDEO_CODEC=""
VIDEO_WIDTH=""
VIDEO_HEIGHT=""
FRAME_RATE=""

# Get video stream info
VIDEO_INFO=$(ffprobe -v error -select_streams v:0 -show_entries stream=index,codec_name,width,height,r_frame_rate -of csv "$INPUT" 2>&1 | grep "^stream," | head -1)
if [ -n "$VIDEO_INFO" ]; then
    IFS=',' read -r _ idx codec_name width height frame_rate <<< "$VIDEO_INFO"
    VIDEO_STREAM="$idx"
    VIDEO_CODEC="$codec_name"
    VIDEO_WIDTH="$width"
    VIDEO_HEIGHT="$height"
    FRAME_RATE="$frame_rate"
    info "Video stream $idx: $codec_name ${width}x${height} @ ${frame_rate}"
fi

# Get audio streams with language (deduplicate by index, prefer entries with language)
declare -A AUDIO_MAP
while IFS=',' read -r _ idx codec_name lang; do
    [ -z "$idx" ] && continue
    # If we already have this index with a language, skip
    if [ -n "${AUDIO_MAP[$idx]}" ]; then
        # Only replace if current has no language and new one does
        old_lang="${AUDIO_MAP[$idx]##*:}"
        if [ "$old_lang" = "und" ] && [ -n "$lang" ]; then
            AUDIO_MAP[$idx]="$idx:$codec_name:$lang"
        fi
    else
        lang="${lang:-und}"
        AUDIO_MAP[$idx]="$idx:$codec_name:$lang"
    fi
done < <(ffprobe -v error -select_streams a -show_entries stream=index,codec_name:stream_tags=language -of csv "$INPUT" 2>&1 | grep "^stream,")

# Convert map to array, sorted by index
for idx in $(echo "${!AUDIO_MAP[@]}" | tr ' ' '\n' | sort -n); do
    AUDIO_STREAMS+=("${AUDIO_MAP[$idx]}")
    IFS=':' read -r _ codec lang <<< "${AUDIO_MAP[$idx]}"
    info "Audio stream $idx: $codec [$lang]"
done

# Get subtitle streams with language (deduplicate by index, prefer entries with language)
declare -A SUB_MAP
while IFS=',' read -r _ idx codec_name lang; do
    [ -z "$idx" ] && continue
    if [ -n "${SUB_MAP[$idx]}" ]; then
        old_lang="${SUB_MAP[$idx]##*:}"
        if [ "$old_lang" = "und" ] && [ -n "$lang" ]; then
            SUB_MAP[$idx]="$idx:$codec_name:$lang"
        fi
    else
        lang="${lang:-und}"
        SUB_MAP[$idx]="$idx:$codec_name:$lang"
    fi
done < <(ffprobe -v error -select_streams s -show_entries stream=index,codec_name:stream_tags=language -of csv "$INPUT" 2>&1 | grep "^stream,")

for idx in $(echo "${!SUB_MAP[@]}" | tr ' ' '\n' | sort -n); do
    SUBTITLE_STREAMS+=("${SUB_MAP[$idx]}")
    IFS=':' read -r _ codec lang <<< "${SUB_MAP[$idx]}"
    info "Subtitle stream $idx: $codec [$lang]"
done

echo ""

# Check we have video
[ -n "$VIDEO_STREAM" ] || error "No video stream found"

# Determine video extension based on codec
case "$VIDEO_CODEC" in
    h264)
        VIDEO_EXT="264"
        info "Video codec: H.264/AVC"
        ;;
    hevc|h265)
        VIDEO_EXT="265"
        info "Video codec: H.265/HEVC"
        ;;
    mpeg2video)
        VIDEO_EXT="m2v"
        info "Video codec: MPEG-2"
        ;;
    *)
        VIDEO_EXT="$VIDEO_CODEC"
        warn "Video codec $VIDEO_CODEC may not be fully supported"
        ;;
esac

# Get original timestamps and duration for info (from container - fast!)
START_PTS=$(ffprobe -v error -select_streams v:0 -show_entries stream=start_time -of csv "$INPUT" 2>&1 | grep "^stream," | head -1 | cut -d',' -f2)
AUDIO_START_PTS=$(ffprobe -v error -select_streams a:0 -show_entries stream=start_time -of csv "$INPUT" 2>&1 | grep "^stream," | head -1 | cut -d',' -f2)

# Get duration — for VDR multi-file, sum individual segment durations
# (ffprobe with concat protocol only reports first segment's duration)
if [ "$VDR_MULTIFILE" = true ]; then
    CONTAINER_VIDEO_DURATION="0"
    for seg in "${VDR_SEGMENTS[@]}"; do
        seg_dur=$(ffprobe -v error -show_entries format=duration \
            -of default=noprint_wrappers=1:nokey=1 "$seg" 2>/dev/null | grep -E '^[0-9]' || echo "0")
        CONTAINER_VIDEO_DURATION=$(awk "BEGIN {printf \"%.6f\", $CONTAINER_VIDEO_DURATION + $seg_dur}")
    done
    info "Total duration across ${#VDR_SEGMENTS[@]} segments: ${CONTAINER_VIDEO_DURATION}s"
else
    CONTAINER_VIDEO_DURATION=$(ffprobe -v error -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 "$INPUT" 2>/dev/null | grep -E '^[0-9]' || echo "")
    if [ -n "$CONTAINER_VIDEO_DURATION" ]; then
        info "Container duration: ${CONTAINER_VIDEO_DURATION}s"
    fi
fi

info "Original video start time: ${START_PTS:-unknown}s"
info "Original audio start time: ${AUDIO_START_PTS:-unknown}s"
echo ""

#############################################################################
# TIMESTAMP REPAIR (normalize timestamps before demuxing)
# This fixes A/V sync issues similar to ProjectX stream repair
#############################################################################
step "Repairing timestamps (normalizing to start at 0)..."

REPAIRED_INPUT="$OUTDIR/.${BASENAME}_repaired.ts"
_CLEANUP_FILES+=("$REPAIRED_INPUT")

# Calculate A/V offset BEFORE repair (from original file)
# For H.264/H.265: use minimum PTS from first 2 seconds (= first display frame PTS)
# because leading B-frames have lower PTS than the I-frame which comes first in decode order.
# For MPEG-2: use first packet PTS (I-frame); B-frame skipping is handled separately below.
ORIG_VIDEO_PTS=$(probe_first_video_pts "$INPUT")
# Per-track audio PTS probe: each track gets its own trim value
declare -a ORIG_AUDIO_PTS_ARR=()   # Original PTS per audio track
declare -a AUDIO_TRIM_SECS=()      # Trim value per audio track
AUDIO_TRIM_SEC="0"                 # Legacy: maximum trim (for B-frame skip base)

for i in "${!AUDIO_STREAMS[@]}"; do
    IFS=':' read -r idx codec lang <<< "${AUDIO_STREAMS[$i]}"
    TRACK_PTS=$(ffprobe -v error -select_streams $idx -show_entries packet=pts_time -of csv=p=0 "$INPUT" 2>/dev/null | head -1 | tr -d ',')
    ORIG_AUDIO_PTS_ARR[$i]="${TRACK_PTS:-0}"

    if [ -n "$ORIG_VIDEO_PTS" ] && [ -n "$TRACK_PTS" ]; then
        TRACK_AHEAD=$(awk "BEGIN {printf \"%.6f\", $ORIG_VIDEO_PTS - $TRACK_PTS}")
        TRACK_AHEAD_MS=$(awk "BEGIN {printf \"%.0f\", ($ORIG_VIDEO_PTS - $TRACK_PTS) * 1000}")

        if awk "BEGIN {exit !($TRACK_AHEAD > 0.01)}"; then
            info "Audio track $idx ($codec [$lang]) starts ${TRACK_AHEAD_MS}ms before video - will trim"
            AUDIO_TRIM_SECS[$i]="$TRACK_AHEAD"
        elif awk "BEGIN {exit !($TRACK_AHEAD < -0.01)}"; then
            warn "Audio track $idx ($codec [$lang]): video starts ${TRACK_AHEAD_MS}ms before audio - may need padding"
            AUDIO_TRIM_SECS[$i]="0"
        else
            AUDIO_TRIM_SECS[$i]="0"
        fi
    else
        AUDIO_TRIM_SECS[$i]="0"
    fi
done

# Legacy AUDIO_TRIM_SEC: use first track's value (for B-frame skip adjustment logging)
if [ ${#AUDIO_TRIM_SECS[@]} -gt 0 ]; then
    AUDIO_TRIM_SEC="${AUDIO_TRIM_SECS[0]}"
fi

# Repair timestamps: generate new PTS, ignore corrupt DTS, shift to start at 0
#
# The repair remux maps only video+audio (-map 0:v:0 -map 0:a?), so the
# repaired TS carries NO subtitle streams. Subtitle extraction must read the
# pre-repair source - keep its input args here, from before $INPUT and
# $FFMPEG_INPUT_ARGS are repointed at the repaired file below. MEASURED
# 2026-08-16: extracting from the repaired file yielded "empty, skipped" on
# every recording, while the same stream on the original carries hundreds of
# KB per 5 min - DVB subtitle export never worked since the repair step.
SUBS_INPUT_ARGS=("${FFMPEG_INPUT_ARGS[@]}")
FFMPEG_LOG="$OUTDIR/.ffmpeg_repair.log"
_CLEANUP_FILES+=("$FFMPEG_LOG")
# This remux is the longest single call of a run without gaps - measured 72s
# on a 10.4 GB recording - and it used to say nothing at all while it ran:
# progress_set 0 stands above it, progress_set 10 only after it returns, so a
# supervising wrapper showed 0% for a third of the whole run. Same treatment
# as the gap repair below: background the call against -progress and map
# out_time_us onto the band. -nostats stays OFF here - the frame=/size= line
# the log parse below picks up is exactly that stats output.
REPAIR_PROGRESS_FILE="$OUTDIR/.ffmpeg_repair.progress"
_CLEANUP_FILES+=("$REPAIR_PROGRESS_FILE")
: > "$REPAIR_PROGRESS_FILE"
ffmpeg -y -v warning -fflags +genpts+igndts "${FFMPEG_INPUT_ARGS[@]}" \
    -c copy \
    -avoid_negative_ts make_zero \
    -progress "$REPAIR_PROGRESS_FILE" \
    -map 0:v:0 -map 0:a? \
    "$REPAIRED_INPUT" > "$FFMPEG_LOG" 2>&1 &
REPAIR_FF_PID=$!
while kill -0 "$REPAIR_FF_PID" 2>/dev/null; do
    sleep 2
    # out_time_us is the output timeline in microseconds; against the source
    # duration measured above that is a fraction of the remux.
    RP_OUT_US=$(grep '^out_time_us=' "$REPAIR_PROGRESS_FILE" 2>/dev/null | tail -1 | cut -d= -f2)
    [ -n "$RP_OUT_US" ] || continue
    progress_set "$(awk -v u="$RP_OUT_US" -v d="$CONTAINER_VIDEO_DURATION" -v e="$PROGRESS_REMUX_END" \
        'BEGIN { p = (d > 0) ? u / (d * 1000000.0) * e : 0
                 if (p > e) p = e; if (p < 0) p = 0; printf "%d", p }')"
done
# wait returns the child's exit code, so capture it rather than test wait itself.
REPAIR_FF_RC=0
wait "$REPAIR_FF_PID" || REPAIR_FF_RC=$?
if [ "$REPAIR_FF_RC" -eq 0 ]; then
    # Show progress line
    grep -E "^(frame=|size=)" "$FFMPEG_LOG" | tail -1 | while IFS= read -r line; do info "$line"; done
    # Show any warnings/errors from ffmpeg. A recording is cut off mid-packet
    # at both ends, so ffmpeg reports that partial packet on nearly every one;
    # when that is all there is, say so once instead of warning three times.
    if ffmpeg_audio_corruption_is_edge_only "$FFMPEG_LOG" "${START_PTS:-}" "${CONTAINER_VIDEO_DURATION:-}"; then
        warn_ffmpeg_log "$FFMPEG_LOG" "" "$FFMPEG_PACKET_CORRUPT_PATTERN"
        info "Audio: partial packet at the recording edge (normal, recording cut mid-packet)"
    else
        warn_ffmpeg_log "$FFMPEG_LOG"
    fi
    # Preserve "Packet corrupt (stream = 0, dts = N)" markers for
    # corrupt_frame_ranges= (.info emission, later) before the log is
    # deleted below. This whole-TS remux pass is where the damaged region
    # is first parsed, so it is the primary source for this marker; the
    # ES extraction pass below merges in anything additional it sees.
    VIDEO_CORRUPT_DTS_TICKS=$(grep -oE 'Packet corrupt \(stream = 0, dts = [0-9]+' \
        "$FFMPEG_LOG" 2>/dev/null | grep -oE '[0-9]+$' || true)
    rm -f "$FFMPEG_LOG"

    # Verify repaired file
    if [ -s "$REPAIRED_INPUT" ]; then
        NEW_VIDEO_PTS=$(ffprobe -v error -select_streams v:0 -show_entries stream=start_time -of csv "$REPAIRED_INPUT" 2>&1 | grep "^stream," | head -1 | cut -d',' -f2)
        NEW_AUDIO_PTS=$(ffprobe -v error -select_streams a:0 -show_entries stream=start_time -of csv "$REPAIRED_INPUT" 2>&1 | grep "^stream," | head -1 | cut -d',' -f2)
        info "Repaired video start time: ${NEW_VIDEO_PTS:-0}s"
        info "Repaired audio start time: ${NEW_AUDIO_PTS:-0}s"

        # Use repaired file for demuxing. Update both $INPUT (for ffprobe
        # paths) and $FFMPEG_INPUT_ARGS (for ffmpeg paths) — the repaired
        # file is a single TS with clean PTS, so the concat-demuxer setup
        # for multi-file recordings is no longer needed past this point.
        INPUT="$REPAIRED_INPUT"
        FFMPEG_INPUT_ARGS=(-i "$REPAIRED_INPUT")
        CLEANUP_REPAIRED=true
    else
        warn "Timestamp repair failed, using original file"
        CLEANUP_REPAIRED=false
    fi
else
    # Show ffmpeg errors
    warn_ffmpeg_log "$FFMPEG_LOG"
    rm -f "$FFMPEG_LOG"
    warn "Timestamp repair failed, using original file"
    CLEANUP_REPAIRED=false
fi
echo ""

#############################################################################
# ELEMENTARY STREAM MODE
#############################################################################
if $ES_MODE; then
    progress_set 8
    step "Extracting Elementary Streams..."

    # Detect available CPU cores for parallel processing
    NPROC=$(nproc 2>/dev/null || echo 4)
    info "Using up to $NPROC parallel processes"
    echo ""

    # Note: Video is extracted as-is, audio padding happens after extraction
    # This matches ProjectX's approach of adding audio frames at the end

    # 1. Prepare video extraction parameters
    OUTPUT_VIDEO="$OUTDIR/${BASENAME}.${VIDEO_EXT}"

    # For MPEG-2: Find first I-frame time to skip initial B-frames (like ProjectX)
    # This removes "überflüssige B-Frames" before the first GOP
    VIDEO_START_TIME="0"
    if [ "$VIDEO_CODEC" = "mpeg2video" ]; then
        # Find the PTS of the first I-frame (picture type 1)
        # Use -read_intervals to only analyze first 10 seconds (MUCH faster!)
        FIRST_I_PTS=$(ffprobe -v error -select_streams v:0 \
            -read_intervals "%+10" \
            -show_entries frame=pts_time,pict_type \
            -of csv=p=0 "$INPUT" 2>/dev/null | \
            grep ",I$" | head -1 | cut -d',' -f1)

        if [ -n "$FIRST_I_PTS" ] && [ "$FIRST_I_PTS" != "0" ]; then
            # Check if first frame is NOT an I-frame (i.e., there are leading B-frames)
            FIRST_FRAME_TYPE=$(ffprobe -v error -select_streams v:0 \
                -read_intervals "%+1" \
                -show_entries frame=pict_type \
                -of csv=p=0 "$INPUT" 2>/dev/null | head -1)

            if [ "$FIRST_FRAME_TYPE" != "I" ]; then
                # Count B-frames before first I-frame (only need first 2 seconds)
                B_FRAME_COUNT=$(ffprobe -v error -select_streams v:0 \
                    -read_intervals "%+2" \
                    -show_entries frame=pts_time,pict_type \
                    -of csv=p=0 "$INPUT" 2>/dev/null | \
                    awk -F',' 'BEGIN{count=0} $2=="I"{exit} $2=="B"{count++} END{print count}')

                VIDEO_START_TIME="$FIRST_I_PTS"
                SKIPPED_MS=$(awk "BEGIN {printf \"%.0f\", $FIRST_I_PTS * 1000}")
                info "  Skipping $B_FRAME_COUNT initial B-frame(s) (${SKIPPED_MS}ms) before first I-frame"
            fi
        fi
    fi

    # Adjust audio trim to account for skipped video B-frames
    # If we skipped video by VIDEO_START_TIME, we need to also skip that much audio
    if [ "$VIDEO_START_TIME" != "0" ]; then
        for i in "${!AUDIO_TRIM_SECS[@]}"; do
            AUDIO_TRIM_SECS[$i]=$(awk "BEGIN {printf \"%.6f\", ${AUDIO_TRIM_SECS[$i]} + $VIDEO_START_TIME}")
        done
        # Legacy variable for logging
        AUDIO_TRIM_SEC="${AUDIO_TRIM_SECS[0]}"
        TOTAL_SKIP_MS=$(awk "BEGIN {printf \"%.0f\", $AUDIO_TRIM_SEC * 1000}")
        info "  Total audio trim adjusted (A/V offset + B-frame skip), e.g. track 0: ${TOTAL_SKIP_MS}ms"
    fi

    # 2. Prepare audio extraction parameters (before parallel extraction)
    AUDIO_FILES=()
    declare -A LANG_COUNT  # Track how many times each language appears
    declare -a AUDIO_EXTRACT_SS=()      # -ss value (empty = no trim)
    declare -a AUDIO_EXTRACT_MAPS=()    # Stream map index

    if [ ${#AUDIO_STREAMS[@]} -gt 0 ]; then
        for i in "${!AUDIO_STREAMS[@]}"; do
            IFS=':' read -r idx codec lang <<< "${AUDIO_STREAMS[$i]}"

            # Determine extension
            EXT=$(audio_ext_for_codec "$codec")

            # Include language in filename
            # If same language+extension appears multiple times, add index
            OUTPUT_AUDIO="$OUTDIR/${BASENAME}_${lang}.${EXT}"
            lang_ext_key="${lang}_${EXT}"
            if [ "${LANG_COUNT[$lang_ext_key]:-0}" -gt 0 ]; then
                OUTPUT_AUDIO="$OUTDIR/${BASENAME}_${lang}_${LANG_COUNT[$lang_ext_key]}.${EXT}"
            fi
            LANG_COUNT[$lang_ext_key]=$((${LANG_COUNT[$lang_ext_key]:-0} + 1))

            AUDIO_FILES+=("$OUTPUT_AUDIO")

            # Build extraction command (will be run in parallel).
            # All tracks use FFMPEG_INPUT_ARGS (which is -i $ORIGINAL_INPUT
            # for single-file recordings and -f concat -safe 0 -i $LIST_FILE
            # for VDR multi-file). The per-track variation is only -ss, used
            # when the audio stream starts before the video and we want to
            # trim the lead-in. -ss MUST be after -i for MPEG-TS audio
            # extraction with -c:a copy (decoder-side seek; an input-side
            # seek silently produces identical output here).
            TRACK_TRIM="${AUDIO_TRIM_SECS[$i]:-0}"
            if awk "BEGIN {exit !($TRACK_TRIM > 0.001)}"; then
                AUDIO_EXTRACT_SS+=("$TRACK_TRIM")
            else
                AUDIO_EXTRACT_SS+=("")
            fi
            AUDIO_EXTRACT_MAPS+=("$idx")
        done
    fi

    #############################################################################
    # PARALLEL EXTRACTION: Video + All Audio Tracks simultaneously
    #############################################################################
    step "Extracting video + ${#AUDIO_STREAMS[@]} audio track(s) in parallel..."

    # Create a temporary directory for extraction logs
    EXTRACT_LOG_DIR="$OUTDIR/.extract_logs_$$"
    mkdir -p "$EXTRACT_LOG_DIR"
    _CLEANUP_DIRS+=("$EXTRACT_LOG_DIR")

    # Start video extraction in background
    info "  Video -> $OUTPUT_VIDEO"
    (
        case "$VIDEO_CODEC" in
            h264)
                ffmpeg -y "${FFMPEG_INPUT_ARGS[@]}" \
                    -map 0:$VIDEO_STREAM \
                    -c:v copy \
                    -bsf:v h264_mp4toannexb,filter_units=remove_types=12 \
                    -f h264 \
                    "$OUTPUT_VIDEO" 2>&1
                ;;
            hevc|h265)
                ffmpeg -y "${FFMPEG_INPUT_ARGS[@]}" \
                    -map 0:$VIDEO_STREAM \
                    -c:v copy \
                    -bsf:v hevc_mp4toannexb,filter_units=remove_types=38 \
                    -f hevc \
                    "$OUTPUT_VIDEO" 2>&1
                ;;
            mpeg2video)
                declare -a FFMPEG_ARGS=()
                if [ "$VIDEO_START_TIME" != "0" ]; then
                    FFMPEG_ARGS+=("-ss" "$VIDEO_START_TIME")
                fi
                ffmpeg -y "${FFMPEG_ARGS[@]}" "${FFMPEG_INPUT_ARGS[@]}" \
                    -map 0:$VIDEO_STREAM \
                    -c:v copy \
                    -f mpeg2video \
                    "$OUTPUT_VIDEO" 2>&1
                ;;
            *)
                ffmpeg -y "${FFMPEG_INPUT_ARGS[@]}" \
                    -map 0:$VIDEO_STREAM \
                    -c:v copy \
                    "$OUTPUT_VIDEO" 2>&1
                ;;
        esac
    ) > "$EXTRACT_LOG_DIR/video.log" 2>&1 &
    VIDEO_PID=$!

    # Start all audio extractions in parallel
    AUDIO_PIDS=()
    for i in "${!AUDIO_STREAMS[@]}"; do
        IFS=':' read -r idx codec lang <<< "${AUDIO_STREAMS[$i]}"
        info "  Audio $idx [$lang] -> $(basename "${AUDIO_FILES[$i]}")"

        # Run each audio extraction in background (direct invocation, no eval)
        if [ -n "${AUDIO_EXTRACT_SS[$i]}" ]; then
            ffmpeg -y "${FFMPEG_INPUT_ARGS[@]}" -ss "${AUDIO_EXTRACT_SS[$i]}" \
                -map "0:${AUDIO_EXTRACT_MAPS[$i]}" -c:a copy \
                "${AUDIO_FILES[$i]}" > "$EXTRACT_LOG_DIR/audio_$i.log" 2>&1 &
        else
            ffmpeg -y "${FFMPEG_INPUT_ARGS[@]}" \
                -map "0:${AUDIO_EXTRACT_MAPS[$i]}" -c:a copy \
                "${AUDIO_FILES[$i]}" > "$EXTRACT_LOG_DIR/audio_$i.log" 2>&1 &
        fi
        AUDIO_PIDS+=($!)
    done

    # Wait for all extractions to complete
    info "  Waiting for parallel extraction to complete..."

    # Wait for video
    wait $VIDEO_PID
    VIDEO_EXIT=$?
    if [ $VIDEO_EXIT -eq 0 ]; then
        # MPEG-2: Truncate trailing null bytes from ES file.
        # ffmpeg stream-copy from TS extracts zero-stuffed PES payload,
        # leaving invalid null padding that has no MPEG-2 start codes.
        if [ "$VIDEO_CODEC" = "mpeg2video" ]; then
            TRAILING=$(python3 -c "
import os
with open('$OUTPUT_VIDEO','rb') as f:
    sz=os.fstat(f.fileno()).st_size
    n=0; f.seek(sz-1)
    while n<sz:
        if f.read(1)!=b'\x00': break
        n+=1; f.seek(sz-n-1)
    print(n)" 2>/dev/null || echo 0)
            if [ "$TRAILING" -gt 0 ]; then
                ORIG_SIZE=$(stat -c%s "$OUTPUT_VIDEO")
                TRUNC_SIZE=$((ORIG_SIZE - TRAILING))
                truncate -s "$TRUNC_SIZE" "$OUTPUT_VIDEO"
                info "  Truncated $TRAILING trailing null bytes from MPEG-2 ES"
            fi
        fi
        VIDEO_SIZE=$(stat -c%s "$OUTPUT_VIDEO" 2>/dev/null || echo 0)
        info "  Video done: $(numfmt --to=iec $VIDEO_SIZE)"
    else
        warn "  Video extraction failed (exit code: $VIDEO_EXIT)"
        warn_ffmpeg_log "$EXTRACT_LOG_DIR/video.log" "  "
        VIDEO_SIZE=$(stat -c%s "$OUTPUT_VIDEO" 2>/dev/null || echo 0)
    fi

    # Wait for all audio extractions
    AUDIO_ERRORS=0
    for i in "${!AUDIO_PIDS[@]}"; do
        wait ${AUDIO_PIDS[$i]}
        if [ $? -ne 0 ]; then
            ((AUDIO_ERRORS++))
            warn "  Audio $i extraction failed"
            warn_ffmpeg_log "$EXTRACT_LOG_DIR/audio_$i.log" "  "
        fi
    done

    if [ $AUDIO_ERRORS -gt 0 ]; then
        warn "  $AUDIO_ERRORS audio extraction(s) had issues"
    else
        info "  All ${#AUDIO_FILES[@]} audio track(s) extracted"
    fi

    # Merge in any "Packet corrupt" markers also seen during the per-track
    # extraction pass (in practice these come from the timestamp-repair log
    # captured above, since that pass re-muxes the whole TS and hits the
    # damaged region first; capturing here too costs nothing and covers the
    # case where extraction re-triggers the same parser warning).
    VIDEO_CORRUPT_DTS_TICKS="${VIDEO_CORRUPT_DTS_TICKS:-}"$'\n'"$(grep -oE 'Packet corrupt \(stream = 0, dts = [0-9]+' \
        "$EXTRACT_LOG_DIR/video.log" 2>/dev/null | grep -oE '[0-9]+$' || true)"

    # Clean up log directory
    rm -rf "$EXTRACT_LOG_DIR"
    echo ""

    #########################################################################
    # PTS ANALYSIS
    # Detect extra frames in elementary streams via PTS comparison.
    # Uses ttcut-pts-analyze (replaces ttcut-esrepair).
    #########################################################################
    ES_TOTAL_AUS=""
    ES_DOUBLED_PTS_CSV=""
    if command -v ttcut-pts-analyze >/dev/null 2>&1; then
        progress_set 16
        step "Running PTS analysis on $ORIGINAL_INPUT ..."
        # stderr goes to its own log: mixing it into stdout (old 2>&1)
        # raced the block-buffered CSV line and truncated the captured
        # list mid-stream (measured: 731 of 1296 entries + garbage).
        PTS_STDERR_LOG="$OUTDIR/.pts_analyze.log"
        _CLEANUP_FILES+=("$PTS_STDERR_LOG")
        set +e
        PTS_OUTPUT=$(ttcut-pts-analyze --verbose "$ORIGINAL_INPUT" 2>"$PTS_STDERR_LOG")
        PTS_EXIT=$?
        set -e

        ES_TOTAL_AUS=$(echo "$PTS_OUTPUT" | grep -oP '^total_aus=\K[0-9]+' || true)
        if [ "$PTS_EXIT" -eq 1 ]; then
            ES_DOUBLED_PTS_CSV=$(echo "$PTS_OUTPUT" | grep -oP '^doubled_pts_aus=\K.*' || true)
            if [ -n "$ES_DOUBLED_PTS_CSV" ]; then
                count=$(echo "$ES_DOUBLED_PTS_CSV" | tr ',' '\n' | wc -l)
                warn "PTS analysis: $count AUs with doubled PTS detected (field-picture pairs or TS corruption)"
            fi
        elif [ "$PTS_EXIT" -eq 2 ]; then
            warn "PTS analysis failed (exit 2)"
        fi
        rm -f "$PTS_STDERR_LOG"
    else
        warn "ttcut-pts-analyze not found, skipping PTS analysis"
    fi

    #########################################################################
    # AC3 HEADER REPAIR
    # Fix corrupt acmod field in DVB AC3 streams (stereo header + 384kbps)
    #########################################################################
    declare -A AC3_FIX_RESULTS  # Track fix results per audio file index
    if $AC3FIX && [ ${#AUDIO_FILES[@]} -gt 0 ]; then
        HAS_AC3=false
        for af in "${AUDIO_FILES[@]}"; do
            [[ "$af" == *.ac3 ]] && HAS_AC3=true && break
        done

        if $HAS_AC3; then
            if command -v ttcut-ac3fix &>/dev/null; then
                step "Checking AC3 headers..."

                for i in "${!AUDIO_FILES[@]}"; do
                    AUDIO_FILE="${AUDIO_FILES[$i]}"
                    [[ "$AUDIO_FILE" != *.ac3 ]] && continue

                    # Analyze: run in analyze mode, capture output
                    ANALYZE_OUT=$(ttcut-ac3fix -a "$AUDIO_FILE" 2>&1)

                    # Extract inconsistent frame count from output
                    INCONSISTENT=$(echo "$ANALYZE_OUT" | grep -oP 'Inconsistent frames:\s+\K[0-9]+' || echo "0")

                    if [ "$INCONSISTENT" -gt 0 ]; then
                        # Decode test: if AC3 decodes fine, skip fix (prevents corrupting valid stereo AC3)
                        if ffmpeg -v error -i "$AUDIO_FILE" -t 2 -f null - 2>/dev/null; then
                            info "  $(basename "$AUDIO_FILE"): $INCONSISTENT inconsistent headers but decode OK — skipping fix"
                            continue
                        fi

                        # Fix: write to temp file, then replace
                        TEMP_FIXED="${AUDIO_FILE}.fixed"
                        if ttcut-ac3fix -F -f "$AUDIO_FILE" "$TEMP_FIXED" 2>&1 | tail -1; then
                            if [ -s "$TEMP_FIXED" ]; then
                                mv "$TEMP_FIXED" "$AUDIO_FILE"
                                info "  $(basename "$AUDIO_FILE"): $INCONSISTENT frames fixed"
                                AC3_FIX_RESULTS[$i]="$INCONSISTENT"
                            else
                                warn "  $(basename "$AUDIO_FILE"): fix produced empty file"
                                rm -f "$TEMP_FIXED"
                            fi
                        else
                            warn "  $(basename "$AUDIO_FILE"): fix failed"
                            rm -f "$TEMP_FIXED"
                        fi
                    else
                        info "  $(basename "$AUDIO_FILE"): headers OK"
                    fi
                done
                echo ""
            else
                warn "ttcut-ac3fix not found in PATH, skipping AC3 header repair"
                echo ""
            fi
        fi
    fi

    # Filler NALUs are stripped automatically during extraction via ffmpeg
    # bitstream filter (filter_units=remove_types=12 for H.264, =38 for HEVC)
    if [ "$VIDEO_CODEC" = "h264" ] || [ "$VIDEO_CODEC" = "hevc" ] || [ "$VIDEO_CODEC" = "h265" ]; then
        FILLER_STRIPPED=true
    else
        FILLER_STRIPPED=false
    fi

    # 2b. Check A/V duration mismatch (like ProjectX does)
    # This detects progressive drift that occurs when audio and video have
    # different durations. The step announcement is printed further below,
    # right before the duration measurement — the interlace correction and
    # the audio ES sanitize run first and report under their own headings.

    # Parse frame rate fraction (e.g., "25/1" or "30000/1001")
    FRAME_RATE_NUM=$(echo "$FRAME_RATE" | cut -d'/' -f1)
    FRAME_RATE_DEN=$(echo "$FRAME_RATE" | cut -d'/' -f2)
    FRAME_RATE_DEN="${FRAME_RATE_DEN:-1}"  # Default to 1 if not fractional

    # Detect interlaced: for PAFF/MBAFF content, ffprobe may report the field
    # rate as r_frame_rate (e.g. 50/1 for 25fps PAFF). The original TS typically
    # reports the correct frame rate (25/1), but the ES after filler stripping
    # may report the field rate (50/1). Only halve if r_frame_rate is actually
    # the field rate (roughly 2x the expected frame rate).
    if $ES_MODE; then
        FIELD_ORDER=$(ffprobe -v error -select_streams v:0 \
            -show_entries stream=field_order \
            -of default=noprint_wrappers=1:nokey=1 "$OUTPUT_VIDEO" 2>/dev/null)

        if [[ -n "$FIELD_ORDER" && "$FIELD_ORDER" != "progressive" && "$FIELD_ORDER" != "unknown" ]]; then
            # Check if FRAME_RATE is actually the field rate by comparing with
            # avg_frame_rate from the ES. If r_frame_rate ≈ 2 × avg_frame_rate,
            # then r_frame_rate is the field rate and needs halving.
            AVG_FPS=$(ffprobe -v error -select_streams v:0 \
                -show_entries stream=avg_frame_rate \
                -of default=noprint_wrappers=1:nokey=1 "$OUTPUT_VIDEO" 2>/dev/null)
            AVG_NUM=$(echo "$AVG_FPS" | cut -d'/' -f1)
            AVG_DEN=$(echo "$AVG_FPS" | cut -d'/' -f2)
            AVG_DEN="${AVG_DEN:-1}"

            # Calculate ratio: r_frame_rate / avg_frame_rate
            # If ≈ 2.0, then r_frame_rate is the field rate → halve it
            if [[ -n "$AVG_NUM" && "$AVG_NUM" -gt 0 && "$AVG_DEN" -gt 0 ]]; then
                RATIO=$(awk "BEGIN {printf \"%.1f\", ($FRAME_RATE_NUM / $FRAME_RATE_DEN) / ($AVG_NUM / $AVG_DEN)}")
                if [[ "$RATIO" == "2.0" ]]; then
                    ORIG_RATE="$FRAME_RATE_NUM/$FRAME_RATE_DEN"
                    FRAME_RATE_NUM=$((FRAME_RATE_NUM / 2))
                    FRAME_RATE="${FRAME_RATE_NUM}/${FRAME_RATE_DEN}"
                    info "  Interlaced ($FIELD_ORDER): corrected field rate $ORIG_RATE to frame rate $FRAME_RATE"
                else
                    info "  Interlaced ($FIELD_ORDER): r_frame_rate=$FRAME_RATE_NUM/$FRAME_RATE_DEN is already frame rate (ratio=$RATIO)"
                fi
            fi
        fi
    fi

    #########################################################################
    # AUDIO ES SANITIZE (ttcut-audiofix)
    # Walk each extracted audio ES frame by frame: drop junk bytes between
    # valid frames, report CRC-damaged frames. Runs BEFORE the Rev-2 audio-gap
    # detection/repair section below so that repair operates on structurally
    # clean material. Placed here (after the interlace field/frame-rate
    # correction above, not right after AC3 header repair) so the ms->video-
    # frame conversion for audio_${i}_corrupt_ranges uses the corrected
    # FRAME_RATE — an interlaced ES can report double (field) rate until that
    # correction runs. Any tool failure leaves the original file untouched.
    #########################################################################
    declare -A AUDIOFIX_CORRUPT_RANGES AUDIOFIX_JUNK_BYTES AUDIOFIX_DROPPED
    if [ ${#AUDIO_FILES[@]} -gt 0 ]; then
        if command -v ttcut-audiofix &>/dev/null; then
            step "Checking audio ES structure..."
            # Decimal frame rate for the ms->video-frame conversion. The Rev-2
            # gap section further below recomputes the same value into the
            # global FRAME_RATE_DEC from the same (by-then-unchanged) FRAME_RATE
            # — that recompute is a harmless no-op duplicate, kept so this block
            # doesn't have to move past AC3 header repair per the original plan.
            _AFIX_FR_NUM=$(echo "$FRAME_RATE" | cut -d'/' -f1)
            _AFIX_FR_DEN=$(echo "$FRAME_RATE" | cut -d'/' -f2)
            _AFIX_FR_DEN="${_AFIX_FR_DEN:-1}"
            FRAME_RATE_DEC=$(awk "BEGIN {printf \"%.6f\", $_AFIX_FR_NUM / $_AFIX_FR_DEN}")
            for i in "${!AUDIO_FILES[@]}"; do
                AF="${AUDIO_FILES[$i]}"
                case "$AF" in *.mp2|*.ac3|*.eac3) ;; *) continue ;; esac
                set +e
                AFIX_OUT=$(ttcut-audiofix -a "$AF" 2>/dev/null)
                AFIX_RC=$?
                set -e
                if [ "$AFIX_RC" -eq 0 ]; then
                    info "  $(basename "$AF"): structure OK"
                    continue
                elif [ "$AFIX_RC" -ge 2 ]; then
                    warn "  $(basename "$AF"): ttcut-audiofix analyze failed (rc=$AFIX_RC), leaving untouched"
                    continue
                fi
                TEMP_FIXED="${AF}.sanitized"
                set +e
                ttcut-audiofix -f "$AF" "$TEMP_FIXED" >/dev/null 2>&1
                FIX_RC=$?
                set -e
                if [ "$FIX_RC" -le 1 ] && [ -s "$TEMP_FIXED" ]; then
                    mv "$TEMP_FIXED" "$AF"
                    JUNK=$(echo "$AFIX_OUT" | grep -oP '^junk_regions=\K.*' || true)
                    CRCB=$(echo "$AFIX_OUT" | grep -oP '^crc_bad_frames=\K.*' || true)
                    # A recording starts and ends mid-frame; ttcut-audiofix
                    # reports those two partial frames as edge_junk_bytes rather
                    # than in junk_regions. They are removed like any junk (that
                    # is why they count towards the byte total below), but they
                    # are not damage and must not reach audio_N_corrupt_ranges -
                    # otherwise TTCut-ng marks a "Tonstoerung" on every single
                    # recording. Empty when an older ttcut-audiofix is in PATH,
                    # which then behaves exactly as before.
                    EDGEB=$(echo "$AFIX_OUT" | grep -oP '^edge_junk_bytes=\K[0-9]+' || echo 0)
                    MIDB=$(echo "$JUNK" | tr ',' '\n' | grep -oP ':\K[0-9]+' | awk '{s+=$1} END{print s+0}')
                    AUDIOFIX_JUNK_BYTES[$i]=$(( MIDB + ${EDGEB:-0} ))
                    AUDIOFIX_DROPPED[$i]=$(echo "$AFIX_OUT" | grep -oP '^dropped_frames=\K[0-9]+' || echo 0)
                    # ms positions (junk + CRC) -> video frames, clustered (<=2s)
                    AUDIOFIX_CORRUPT_RANGES[$i]=$(audiofix_ranges_to_video_frames "$JUNK" "$CRCB" "$FRAME_RATE_DEC")
                    if [ -n "${AUDIOFIX_CORRUPT_RANGES[$i]}" ]; then
                        warn "  $(basename "$AF"): junk removed (${AUDIOFIX_JUNK_BYTES[$i]} bytes) at video frame(s) $(format_ranges_hms "${AUDIOFIX_CORRUPT_RANGES[$i]}" "$FRAME_RATE_DEC")"
                    else
                        info "  $(basename "$AF"): structure OK (trimmed ${AUDIOFIX_JUNK_BYTES[$i]} bytes of partial frame at the recording edges)"
                    fi
                else
                    rm -f "$TEMP_FIXED"
                    warn "  $(basename "$AF"): sanitize failed (rc=$FIX_RC), leaving untouched"
                fi
            done
            echo ""
        else
            warn "ttcut-audiofix not found in PATH, skipping audio ES sanitize"
            echo ""
        fi
    fi

    progress_set 29
    step "Checking A/V duration alignment..."

    # Video duration = video PTS span, NOT the container span.
    # ffprobe format=duration (CONTAINER_VIDEO_DURATION) spans the latest
    # stream end minus the earliest stream start; with DVB audio leading the
    # video it overshoots by the audio lead, inflating the frame count, the
    # padding target and the reported drift. Measure the video stream itself:
    # first display PTS (min over the first 2s -- covers leading B-frames) to
    # last PTS + one frame duration, on the repaired TS (monotonic PTS; also
    # collapses VDR multi-file to one clean timeline).
    VIDEO_DURATION=""
    if [ "$CLEANUP_REPAIRED" = true ]; then
        _FD_NUM=$(echo "$FRAME_RATE" | cut -d'/' -f1)
        _FD_DEN=$(echo "$FRAME_RATE" | cut -d'/' -f2)
        _FD_DEN="${_FD_DEN:-1}"
        FRAME_DUR=$(awk "BEGIN {printf \"%.6f\", $_FD_DEN / $_FD_NUM}")

        # First frame PTS = the stream's start_time (first DECODABLE frame).
        # Not the minimum packet PTS: open-GOP leading B-frames at a mid-
        # recording start have a lower PTS but are dropped by every decoder, so
        # counting them would overstate the duration (by up to M-1 frames) and
        # over-pad the audio. start_time excludes them and matches the decoded
        # frame count. MPEG-2 leading-B skip already trimmed the ES to the
        # first I; align the span start with it in that case.
        if [ "$VIDEO_START_TIME" != "0" ]; then
            SPAN_FIRST_PTS="$VIDEO_START_TIME"
        else
            SPAN_FIRST_PTS=$(ffprobe -v error -select_streams v:0 \
                -show_entries stream=start_time -of default=noprint_wrappers=1:nokey=1 \
                "$INPUT" 2>/dev/null | grep -E '^[0-9]' | head -1)
            # Fallback to min packet PTS if start_time is unavailable.
            if [ -z "$SPAN_FIRST_PTS" ]; then
                SPAN_FIRST_PTS=$(ffprobe -v error -select_streams v:0 \
                    -read_intervals "%+2" -show_entries packet=pts_time \
                    -of csv=p=0 "$INPUT" 2>/dev/null | tr -d ',' | sort -n | head -1)
            fi
        fi

        # Last PTS: probe a window near the end (container span as seek hint),
        # widen once if the first window is empty.
        SPAN_SEEK=$(awk "BEGIN {s = ${CONTAINER_VIDEO_DURATION:-0} - 10; printf \"%.3f\", (s > 0) ? s : 0}")
        SPAN_LAST_PTS=$(ffprobe -v error -select_streams v:0 \
            -read_intervals "${SPAN_SEEK}%+15" -show_entries packet=pts_time \
            -of csv=p=0 "$INPUT" 2>/dev/null | tr -d ',' | sort -n | tail -1)
        if [ -z "$SPAN_LAST_PTS" ]; then
            SPAN_SEEK=$(awk "BEGIN {s = ${CONTAINER_VIDEO_DURATION:-0} - 60; printf \"%.3f\", (s > 0) ? s : 0}")
            SPAN_LAST_PTS=$(ffprobe -v error -select_streams v:0 \
                -read_intervals "${SPAN_SEEK}%+60" -show_entries packet=pts_time \
                -of csv=p=0 "$INPUT" 2>/dev/null | tr -d ',' | sort -n | tail -1)
        fi

        if [ -n "$SPAN_FIRST_PTS" ] && [ -n "$SPAN_LAST_PTS" ]; then
            VIDEO_DURATION=$(awk "BEGIN {d = $SPAN_LAST_PTS + $FRAME_DUR - $SPAN_FIRST_PTS; printf \"%.6f\", (d > 0) ? d : 0}")
            info "  Video duration from PTS span: ${VIDEO_DURATION}s (first=${SPAN_FIRST_PTS}s last=${SPAN_LAST_PTS}s)"
        fi
    fi

    # Fallback: repair failed or PTS probe empty -> container span (honest warning).
    if [ -z "$VIDEO_DURATION" ]; then
        if [ -n "$CONTAINER_VIDEO_DURATION" ]; then
            VIDEO_DURATION="$CONTAINER_VIDEO_DURATION"
            warn "  Video duration from container span (may include the audio lead)"
        else
            # Fallback: probe elementary stream (slower)
            VIDEO_DURATION=$(ffprobe -v error \
                -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 \
                "$OUTPUT_VIDEO" 2>/dev/null | grep -E '^[0-9]' || echo "")

            if [ -z "$VIDEO_DURATION" ] || [ "$VIDEO_DURATION" = "N/A" ]; then
                # Estimate from file size and bitrate (rough approximation)
                VIDEO_SIZE_BYTES=$(stat -c%s "$OUTPUT_VIDEO" 2>/dev/null || echo 0)
                # Assume ~5 Mbit/s for SD, ~15 Mbit/s for HD
                if [ "$VIDEO_WIDTH" -gt 1280 ]; then
                    EST_BITRATE=15000000  # 15 Mbit/s for HD
                else
                    EST_BITRATE=5000000   # 5 Mbit/s for SD
                fi
                VIDEO_DURATION=$(awk "BEGIN {printf \"%.3f\", $VIDEO_SIZE_BYTES * 8 / $EST_BITRATE}")
                warn "  Duration estimated from file size (may be inaccurate)"
            fi
        fi
    fi

    # Loud count-check: counted packets in the output ES vs. what the
    # measured PTS-span duration implies. A silent hole (dropped packets
    # that leave no PTS discontinuity signature, e.g. right after a
    # damaged GOP) would otherwise produce a clean-looking .info; this is
    # a second, independent signal that does not depend on gap detection.
    COUNTED_FRAMES=$(ffprobe -v error -count_packets -select_streams v:0 \
        -show_entries stream=nb_read_packets -of csv=p=0 "$OUTPUT_VIDEO" 2>/dev/null)
    # ffprobe's csv writer appends a trailing comma for a raw .m2v
    # elementary stream (verified: "stream,2964," vs. "stream,184960" for
    # a raw .264 - reproduces even for the plain index/codec_name entries,
    # so it's a demuxer-side csv quirk, not a frame-vs-packet count
    # difference). Not limited to raw mpegvideo: mpegts does it too,
    # which is why detect_video_gaps_multifile() has to strip the same
    # comma. "2964," fails bash's [ -eq ] integer test
    # silently (exit 2, swallowed by the 2>/dev/null), so this whole
    # count-check was a no-op for every MPEG-2 run. Strip it before the
    # numeric test.
    COUNTED_FRAMES="${COUNTED_FRAMES%,}"

    # Sendezeit: was die Aufnahme an Realzeit umfasst, Loecher eingeschlossen.
    VIDEO_SPAN_MS=$(awk "BEGIN {printf \"%.0f\", $VIDEO_DURATION * 1000}")

    # ES-Dauer: was tatsaechlich im erzeugten Video-ES steht. Referenz fuer
    # Drift, Padding und .info - der Ton wird hierauf ausgerichtet, nicht auf
    # die Sendezeit. Beide Groessen getrennt zu halten ist noetig, nicht
    # kosmetisch: wuerde VIDEO_DURATION_MS einfach die Spanne ersetzen, waere
    # EXPECTED_FRAMES == COUNTED_FRAMES und der count-check unten - der
    # unabhaengige Melder fuer stille Loecher ohne PTS-Sprung - koennte nie
    # mehr feuern.
    if [ -n "$COUNTED_FRAMES" ] && [ "$COUNTED_FRAMES" -eq "$COUNTED_FRAMES" ] 2>/dev/null; then
        VIDEO_DURATION_MS=$(awk "BEGIN {printf \"%.0f\", $COUNTED_FRAMES * 1000.0 * $FRAME_RATE_DEN / $FRAME_RATE_NUM}")
        VIDEO_FRAME_COUNT="$COUNTED_FRAMES"
    else
        warn "  Frame count unavailable - falling back to PTS span for the ES duration"
        VIDEO_DURATION_MS="$VIDEO_SPAN_MS"
        VIDEO_FRAME_COUNT=$(awk "BEGIN {printf \"%.0f\", $VIDEO_DURATION * $FRAME_RATE_NUM / $FRAME_RATE_DEN}")
    fi

    # Check first audio file for duration comparison
    AUDIO_DURATION_MS=0
    AV_DRIFT_MS=0
    AV_DRIFT_RATE=0
    if [ ${#AUDIO_FILES[@]} -gt 0 ]; then
        FIRST_AUDIO="${AUDIO_FILES[0]}"
        AUDIO_DURATION=$(audio_es_duration "$FIRST_AUDIO")
        AUDIO_DURATION_MS=$(awk "BEGIN {printf \"%.0f\", $AUDIO_DURATION * 1000}")

        # Calculate drift
        AV_DRIFT_MS=$(awk "BEGIN {printf \"%.0f\", $VIDEO_DURATION_MS - $AUDIO_DURATION_MS}")

        info "  Video: ~$VIDEO_FRAME_COUNT frames = ${VIDEO_DURATION_MS}ms"
        info "  Audio: ${AUDIO_DURATION_MS}ms"
        info "  Duration difference: ${AV_DRIFT_MS}ms"

        # Calculate drift rate (ms per minute)
        if [ "$VIDEO_DURATION_MS" -gt 0 ]; then
            AV_DRIFT_RATE=$(awk "BEGIN {printf \"%.2f\", $AV_DRIFT_MS / ($VIDEO_DURATION_MS / 60000)}")
            info "  Drift rate: ${AV_DRIFT_RATE}ms/min"
        fi

        # === Audio-Gap Detection, Classification, and Mid-Stream Repair (Rev 2) ===
        # Detect audio packet gaps per track. For each gap, compute how many ms of
        # silence to insert to keep A/V sync: silence_ms = audio_gap_ms minus the
        # video content that was also lost in the same PTS range.
        # Video gaps are detected ONCE per recording (not per audio track).

        # Parse frame rate to decimal for awk arithmetic
        _FR_NUM=$(echo "$FRAME_RATE" | cut -d'/' -f1)
        _FR_DEN=$(echo "$FRAME_RATE" | cut -d'/' -f2)
        _FR_DEN="${_FR_DEN:-1}"
        FRAME_RATE_DEC=$(awk "BEGIN {printf \"%.6f\", $_FR_NUM / $_FR_DEN}")

        if [ -n "$COUNTED_FRAMES" ] && [ "$COUNTED_FRAMES" -eq "$COUNTED_FRAMES" ] 2>/dev/null; then
            EXPECTED_FRAMES=$(awk "BEGIN {printf \"%.0f\", ($VIDEO_SPAN_MS / 1000.0) * $FRAME_RATE_DEC}")
            if [ $((EXPECTED_FRAMES - COUNTED_FRAMES)) -gt 1 ]; then
                warn "Video ES is missing $((EXPECTED_FRAMES - COUNTED_FRAMES)) frames mid-stream (counted $COUNTED_FRAMES, PTS span implies $EXPECTED_FRAMES) - audio was adjusted, defect positions are reported below (and as markers in TTCut-ng)"
            fi
        fi

        # Frame-skalige Gap-Schwellen: 2.5 x nominale Paketdauer.
        # Video: Frame-Dauer aus FRAME_RATE (Feld-Kadenz bei MPEG-2 halbiert die
        # Dauer -> Schwelle bleibt trotzdem > jede legale Kadenz-Luecke).
        VIDEO_GAP_THRESHOLD_S=$(awk "BEGIN {printf \"%.6f\", 2.5 / $FRAME_RATE_DEC}")
        # Audio: MP2@48k = 24 ms, AC3 = 32 ms -> 2.5 x 32 ms deckt beide konservativ.
        AUDIO_GAP_THRESHOLD_S=0.080

        VIDEO_GAPS_FILE="$OUTDIR/.video_gaps.txt"
        _CLEANUP_FILES+=("$VIDEO_GAPS_FILE")
        # VDR multi-file: ORIGINAL_INPUT is only the first segment - scan all
        # of them (plus inter-segment splice gaps), see
        # detect_video_gaps_multifile() for why.
        if [ "$VDR_MULTIFILE" = true ]; then
            detect_video_gaps_multifile "$VIDEO_GAPS_FILE" "$VIDEO_GAP_THRESHOLD_S"
        else
            detect_video_gaps "$ORIGINAL_INPUT" "$VIDEO_GAPS_FILE" "$VIDEO_GAP_THRESHOLD_S"
        fi

        GAP_FILES=()
        CLASSIFIED_FILES=()
        HAS_ANY_SILENCE_NEEDED=false
        progress_set 35
        AUDIO_GAP_FRAMES_SOURCE_PTS=()  # entries: "src_start src_end 0" - one per
        # detected audio gap (see the loop over $GAP_FILE below), independent
        # of whether the zone it falls in needed a repair edit; the 3rd
        # field's meaning ("0") is explained there.
        declare -A TRACK_SILENCE_MS TRACK_REMOVED_MS  # per-track repair balance for .info
        declare -A EFFECTIVE_FIRST_AUDIO_PTS_ARR  # per-track, reused by the repair loop below
        # Zone counts for the severity verdict below. Counted as ZONES, not
        # CLASSIFIED_FILE rows: under the zone model a zone with |balance| <
        # the 20ms threshold in build_zone_edits() never produces a row at
        # all (it needs no repair), so counting rows would silently drop
        # every symmetric A+V outage from the tally - exactly the recordings
        # the severity check exists to catch. $ZONES_FILE (all zones) and
        # build_zone_edits' output (zones that got an edit) are both still
        # in scope inside this loop, before the per-track temp files are
        # cleaned up at exit; sum them here while they're available.
        N_NO_SILENCE=0
        N_WITH_SILENCE=0
        for i in "${!AUDIO_FILES[@]}"; do
            # Jede Spur wird einmal ganz durchlaufen; auf einer sauberen
            # Aufnahme ist das der laengste Abschnitt vor dem Ende, und ohne
            # diese Meldung stand der Balken hier gemessene 15s still.
            progress_set $(( 35 + (i + 1) * 5 / ${#AUDIO_FILES[@]} ))
            IFS=':' read -r idx _ _ <<< "${AUDIO_STREAMS[$i]}"
            GAP_FILE="$OUTDIR/.gaps_track_${i}.txt"
            CLASSIFIED_FILE="$OUTDIR/.classified_track_${i}.txt"
            _CLEANUP_FILES+=("$GAP_FILE" "$CLASSIFIED_FILE")
            if [ "$VDR_MULTIFILE" = true ]; then
                detect_audio_gaps_multifile "$idx" "$GAP_FILE" "$AUDIO_GAP_THRESHOLD_S"
            else
                detect_audio_gaps "$ORIGINAL_INPUT" "$idx" "$GAP_FILE" "$AUDIO_GAP_THRESHOLD_S"
            fi
            GAP_FILES[$i]="$GAP_FILE"
            CLASSIFIED_FILES[$i]="$CLASSIFIED_FILE"

            # Melde-Pfad, getrennt vom Reparatur-Pfad: audio_gap_frames zeigt,
            # WO der Ton Luecken hatte - unabhaengig davon, ob die Zonenbilanz
            # eine Reparatur ausgeloest hat. Ein symmetrischer A+V-Ausfall
            # braucht keine Reparatur, ist aber sehr wohl eine Stoerstelle,
            # die in TTCut-ng als Landezone sichtbar sein muss.
            #
            # Drittes Feld bewusst 0, nicht die Gap-Laenge: der Emissionspfad
            # (~Zeile 2794) rechnet daraus die BREITE des Markers in Frames
            # und schreibt jeden einzelnen Frame-Index in die CSV. Mit der
            # echten Gap-Laenge ergaebe allein der 26s-Ausfall der Referenz-
            # aufnahme 03x15 660 Indizes und die Segmentnaht weitere 2700 -
            # die .info-Zeile waere unbrauchbar und liefe in den
            # maxExtraFrames-Cap von ttesinfo.cpp. Mit 0 markiert jeder Gap
            # nur seinen Startframe; wie lang der Verlust war, steht ohnehin
            # in es_missing_ranges.
            if [ -s "$GAP_FILE" ]; then
                while IFS=' ' read -r g_start g_end g_ms; do
                    [ -z "$g_start" ] && continue
                    AUDIO_GAP_FRAMES_SOURCE_PTS+=("$g_start $g_end 0")
                done < "$GAP_FILE"
            fi

            # Erster PTS des GETRIMMTEN Ton-ES. Der Trim schneidet den
            # Vorlauf weg, mit dem der Ton vor dem Video beginnt - die
            # Positionen in build_zone_edits() beziehen sich auf das
            # getrimmte ES, nicht auf den Originalton.
            #
            # Frueher: max(FIRST_AUDIO_PTS_TRACK, ${FIRST_VIDEO_PTS:-0}).
            # Richtig gemeint, aber wirkungslos - FIRST_VIDEO_PTS wird
            # erst weiter unten gesetzt, der Ausdruck lieferte immer den
            # ungetrimmten Audio-PTS und verschob jede Position um den
            # Trim (gemessen 2026-08-24 auf "03x15": 450 ms).
            FIRST_AUDIO_PTS_TRACK="${ORIG_AUDIO_PTS_ARR[$i]:-0}"
            EFFECTIVE_FIRST_AUDIO_PTS=$(awk \
                "BEGIN {printf \"%.6f\", $FIRST_AUDIO_PTS_TRACK + ${AUDIO_TRIM_SECS[$i]:-0}}")
            EFFECTIVE_FIRST_AUDIO_PTS_ARR[$i]="$EFFECTIVE_FIRST_AUDIO_PTS"

            ZONES_FILE="$OUTDIR/.zones_track_${i}.txt"
            _CLEANUP_FILES+=("$ZONES_FILE")
            build_disturbance_zones "$VIDEO_GAPS_FILE" "$GAP_FILE" 2.0 "$ZONES_FILE"

            # Zonen -> CLASSIFIED_FILE. src_end == src_start: der Offset wird
            # jetzt in build_zone_edits() gefuehrt, repair_audio_with_silence_
            # inserts() darf ihn nicht ein zweites Mal aufaddieren.
            : > "$CLASSIFIED_FILE"
            while IFS=' ' read -r z_pos z_bal; do
                [ -z "$z_pos" ] && continue
                Z_SRC=$(awk -v p="$z_pos" -v f="$EFFECTIVE_FIRST_AUDIO_PTS" \
                    'BEGIN {printf "%.6f", p + f}')
                echo "$Z_SRC $Z_SRC ${z_bal#-} $z_bal" >> "$CLASSIFIED_FILE"
                HAS_ANY_SILENCE_NEEDED=true
            done < <(build_zone_edits "$ZONES_FILE" "$EFFECTIVE_FIRST_AUDIO_PTS")

            # Zone tally for the severity verdict (see the comment on
            # N_NO_SILENCE/N_WITH_SILENCE above the loop): every zone in
            # $ZONES_FILE either produced a CLASSIFIED_FILE row (edit
            # needed) or didn't (balance under threshold - pure A+V loss).
            TRACK_ZONE_COUNT=0
            TRACK_EDIT_COUNT=0
            [ -s "$ZONES_FILE" ] && TRACK_ZONE_COUNT=$(grep -c . "$ZONES_FILE")
            [ -s "$CLASSIFIED_FILE" ] && TRACK_EDIT_COUNT=$(grep -c . "$CLASSIFIED_FILE")
            N_WITH_SILENCE=$(( N_WITH_SILENCE + TRACK_EDIT_COUNT ))
            N_NO_SILENCE=$(( N_NO_SILENCE + TRACK_ZONE_COUNT - TRACK_EDIT_COUNT ))

            # Per-track audio repair balance for .info (audio_${i}_silence_ms /
            # audio_${i}_removed_ms): sum the signed sms column (4th field) of
            # CLASSIFIED_FILE — positive rows are inserted silence, negative
            # rows are truncated (removed) audio.
            TRACK_SILENCE_MS[$i]=0
            TRACK_REMOVED_MS[$i]=0
            if [ -s "$CLASSIFIED_FILE" ]; then
                read -r TRACK_SILENCE_MS_I TRACK_REMOVED_MS_I < <(awk '
                    { if ($4 > 0) s += $4; else if ($4 < 0) r += -$4 }
                    END { printf "%.0f %.0f\n", s, r }' "$CLASSIFIED_FILE")
                TRACK_SILENCE_MS[$i]="$TRACK_SILENCE_MS_I"
                TRACK_REMOVED_MS[$i]="$TRACK_REMOVED_MS_I"
            fi
        done

        # Gated on zone counts, not on AUDIO_GAP_FRAMES_SOURCE_PTS: the two
        # can diverge. AUDIO_GAP_FRAMES_SOURCE_PTS is filled only from
        # $GAP_FILE (audio gaps), so a recording whose loss is entirely
        # video-only (audio ran through, video-lost balance -> truncation
        # edit needed) has zones and a nonzero N_WITH_SILENCE but adds
        # nothing there - the severity verdict below must still see it.
        if [ $(( N_NO_SILENCE + N_WITH_SILENCE )) -gt 0 ]; then
            info "  Audio gaps detected across all tracks: $N_NO_SILENCE pure A+V, $N_WITH_SILENCE needing silence"

            # Overall damage verdict. The per-defect lines above say WHERE
            # the holes are; on a recording that lost transmission for good
            # they scroll past by the thousand and the fact that the whole
            # thing is beyond saving gets lost in them. Two independent
            # measures, either one is enough to trip it: the share of video
            # frames that never arrived, and how densely the audio holes sit.
            # Reference case (Futurama 06x03, 2026-08-23): 15.6% of frames
            # missing and ~150 gaps/min - both far past the thresholds. This
            # only reports; the run continues and still produces its output,
            # because where the line between "damaged" and "worthless" falls
            # is the viewer's call, not the demuxer's.
            DEFECT_LOSS_PCT_LIMIT=5
            DEFECT_GAPS_PER_MIN_LIMIT=20
            # Per TRACK, not summed over all of them. N_NO_SILENCE and
            # N_WITH_SILENCE count disturbance ZONES across every audio
            # track's $ZONES_FILE, so one broadcast outage lands once per
            # audio track: on the reference
            # recording that turned ~3419 gaps into 6839 and doubled the rate
            # to 123/min for two tracks. The outage happened once, so the
            # figure has to be per track to mean anything.
            DEFECT_TRACKS=${#AUDIO_FILES[@]}
            [ "$DEFECT_TRACKS" -gt 0 ] || DEFECT_TRACKS=1
            DEFECT_TOTAL_GAPS=$(( (N_NO_SILENCE + N_WITH_SILENCE) / DEFECT_TRACKS ))
            DEFECT_LOSS_PCT=0
            if [ "${EXPECTED_FRAMES:-0}" -gt 0 ] 2>/dev/null; then
                DEFECT_LOSS_PCT=$(awk -v e="$EXPECTED_FRAMES" -v c="${COUNTED_FRAMES:-0}" \
                    'BEGIN {d = e - c; if (d < 0) d = 0; printf "%.1f", d * 100.0 / e}')
            fi
            DEFECT_GAPS_PER_MIN=0
            if [ "${VIDEO_DURATION_MS:-0}" -gt 0 ] 2>/dev/null; then
                # Whole gaps, no decimal: "123.0 gaps/min" claims a precision a
                # per-minute count does not have. The loss share next to it
                # keeps its digit - there 15.6% against 16% is a real
                # difference. Note the rounding happens BEFORE the threshold
                # test below, so the limit applies to the number that is
                # printed; a true 20.4 now reads 20 and does not trip.
                DEFECT_GAPS_PER_MIN=$(awk -v g="$DEFECT_TOTAL_GAPS" -v ms="$VIDEO_DURATION_MS" \
                    'BEGIN {printf "%.0f", g * 60000.0 / ms}')
            fi
            if awk -v l="$DEFECT_LOSS_PCT" -v lm="$DEFECT_LOSS_PCT_LIMIT" \
                   -v g="$DEFECT_GAPS_PER_MIN" -v gm="$DEFECT_GAPS_PER_MIN_LIMIT" \
                   'BEGIN {exit !(l > lm || g > gm)}'; then
                warn "SEVERELY DAMAGED RECORDING: ${DEFECT_LOSS_PCT}% of video frames missing (limit ${DEFECT_LOSS_PCT_LIMIT}%), ${DEFECT_GAPS_PER_MIN} audio gaps/min per track (limit ${DEFECT_GAPS_PER_MIN_LIMIT})"
                warn "  The result is very likely unusable - check it before cutting. Demux continues."
            fi
        fi

        # Bandplanung, unabhaengig davon OB Luecken gefunden wurden: auf einer
        # sauberen Aufnahme lief dieser Zweig frueher gar nicht, der Balken
        # blieb auf dem Wert vor der Erkennung stehen und sprang erst ganz am
        # Ende weiter (gemessen: 33% bis kurz vor "fertig"). Mit
        # N_WITH_SILENCE=0 faellt das Reparaturband auf null, und der Rest
        # verteilt sich auf die Endphase - genau das gewuenschte Verhalten.
        PROGRESS_IN_BYTES=$(du -cb "${VDR_SEGMENTS[@]:-$INPUT}" 2>/dev/null | tail -1 | cut -f1)
        progress_set "$PROGRESS_PRE_END"
        progress_plan "${N_WITH_SILENCE:-0}" "${PROGRESS_IN_BYTES:-0}"

        if $HAS_ANY_SILENCE_NEEDED; then
            info "  Inserting silence for gaps with audio loss exceeding video loss..."
            _REPAIR_TRACK_N=${#AUDIO_FILES[@]}
            [ "$_REPAIR_TRACK_N" -gt 0 ] || _REPAIR_TRACK_N=1
            for i in "${!AUDIO_FILES[@]}"; do
                _REPAIR_TRACK_IDX=$i
                # Count the gaps that need silence (silence_ms != 0) rather
                # than just proving one exists: the count is announced before
                # the repair starts, so a caller tailing the log - the VDR
                # wrapper puts the last line in its progress dialog - can see
                # what is being worked on instead of the same stale line for
                # minutes. The old code found the count a second time after
                # the repair had succeeded; one pass answers both.
                NEEDS_REPAIR=false
                N_TRACK_GAPS=0
                while IFS=' ' read -r _gs _ge _gms sms; do
                    if [ "${sms:-0}" != "0" ]; then
                        NEEDS_REPAIR=true
                        N_TRACK_GAPS=$(( N_TRACK_GAPS + 1 ))
                    fi
                done < "${CLASSIFIED_FILES[$i]}"

                if $NEEDS_REPAIR; then
                    AUDIO_FILE="${AUDIO_FILES[$i]}"
                    EFFECTIVE_FIRST_AUDIO_PTS="${EFFECTIVE_FIRST_AUDIO_PTS_ARR[$i]}"
                    info "    $(basename "$AUDIO_FILE") (track $((i + 1))/${#AUDIO_FILES[@]}): repairing $N_TRACK_GAPS gap(s)..."
                    if repair_audio_with_silence_inserts "$AUDIO_FILE" "${CLASSIFIED_FILES[$i]}" "$EFFECTIVE_FIRST_AUDIO_PTS"; then
                        info "    $(basename "$AUDIO_FILE"): $N_TRACK_GAPS silence-insertion(s) applied"
                    else
                        warn "    $(basename "$AUDIO_FILE"): silence-insert FAILED — leaving original"
                        # Repair didn't happen — don't let the .info claim
                        # a balance (audio_${i}_silence_ms/removed_ms) that
                        # was only ever the INTENDED balance computed from
                        # CLASSIFIED_FILE above, before the actual repair
                        # attempt failed and left the original audio file
                        # untouched.
                        TRACK_SILENCE_MS[$i]=0
                        TRACK_REMOVED_MS[$i]=0
                    fi
                fi
            done

            # Recalculate AV_DRIFT_MS after repair so the end-pad block below
            # operates on the residual drift only.
            FIRST_AUDIO="${AUDIO_FILES[0]}"
            AUDIO_DURATION=$(audio_es_duration "$FIRST_AUDIO")
            AUDIO_DURATION_MS=$(awk "BEGIN {printf \"%.0f\", $AUDIO_DURATION * 1000}")
            AV_DRIFT_MS=$(awk "BEGIN {printf \"%.0f\", $VIDEO_DURATION_MS - $AUDIO_DURATION_MS}")
            info "  After silence-insertion: Audio=${AUDIO_DURATION_MS}ms, residual drift=${AV_DRIFT_MS}ms"
        elif [ ${#AUDIO_GAP_FRAMES_SOURCE_PTS[@]} -gt 0 ]; then
            # AUDIO_GAP_FRAMES_SOURCE_PTS is filled from every detected
            # audio gap (see the loop over $GAP_FILE above), independent of
            # whether its zone needed a repair edit. HAS_ANY_SILENCE_NEEDED
            # only goes true when build_zone_edits() actually emits one, so
            # this branch is reachable again: a recording whose only outages
            # are zero-balance zones (real, symmetric A+V loss - the exact
            # 03x15 reference case, one zone at -16ms, under the 20ms
            # threshold) has audio gaps to report but no repair to run.
            info "  All audio gaps perfectly synchronized with video gaps — no silence insertion needed"
        fi

        # Cleanup gap detection files (handled by _CLEANUP_FILES on exit)

        # If video is longer than audio, pad audio with silence (like ProjectX does)
        # This ensures A/V sync throughout the file
        if [ "$AV_DRIFT_MS" -gt 20 ]; then
            progress_set $(( PROGRESS_REPAIR_END + (100 - PROGRESS_REPAIR_END) * 5 / 10 ))
            info "  Padding ${#AUDIO_FILES[@]} audio track(s) in parallel to match video duration..."

            # Calculate target duration in seconds
            TARGET_AUDIO_DUR=$(awk "BEGIN {printf \"%.6f\", $VIDEO_DURATION_MS / 1000}")

            # Create temp directory for padding logs
            PAD_LOG_DIR="$OUTDIR/.pad_logs_$$"
            mkdir -p "$PAD_LOG_DIR"
            _CLEANUP_DIRS+=("$PAD_LOG_DIR")

            # Start all audio padding in parallel
            # Strategy: Generate silence separately, then concatenate with original
            # using ffmpeg concat demuxer + stream copy. This preserves original
            # AC3 frames bit-for-bit (including per-frame acmod/channel changes).
            PAD_PIDS=()
            for i in "${!AUDIO_FILES[@]}"; do
                AUDIO_FILE="${AUDIO_FILES[$i]}"
                AUDIO_EXT="${AUDIO_FILE##*.}"
                TEMP_PADDED="$OUTDIR/.temp_padded_${i}.${AUDIO_EXT}"
                TEMP_SILENCE="$OUTDIR/.temp_silence_${i}.${AUDIO_EXT}"
                TEMP_CONCAT="$OUTDIR/.temp_concat_${i}.txt"
                _CLEANUP_FILES+=("$TEMP_PADDED" "$TEMP_SILENCE" "$TEMP_CONCAT")

                # Get audio codec, bitrate, channels, and sample rate from original.
                # On probe failure APROBE_CODEC is empty and the ENCODER case
                # below falls through to -c:a copy (same effect as the old
                # `|| echo "copy"` fallback).
                probe_audio_props "$AUDIO_FILE"
                AUDIO_CODEC="$APROBE_CODEC"
                ORIG_BITRATE="$APROBE_BITRATE"
                ORIG_CHANNELS="$APROBE_CHANNELS"
                ORIG_SAMPLE_RATE="$APROBE_SAMPLE_RATE"
                ORIG_DURATION=$(audio_es_duration "$AUDIO_FILE")

                # Calculate padding duration
                PAD_DURATION=$(awk "BEGIN {d = $TARGET_AUDIO_DUR - $ORIG_DURATION; printf \"%.6f\", (d > 0) ? d : 0}")

                # Choose encoder for silence generation (matching original format)
                case "$AUDIO_CODEC" in
                    mp2)
                        ENCODER="-c:a mp2 -b:a ${ORIG_BITRATE:-192000} -ac ${ORIG_CHANNELS:-2}"
                        ;;
                    ac3)
                        ENCODER="-c:a ac3 -b:a ${ORIG_BITRATE:-384000} -ac ${ORIG_CHANNELS:-2}"
                        ;;
                    aac)
                        ENCODER="-c:a aac -b:a ${ORIG_BITRATE:-192000} -ac ${ORIG_CHANNELS:-2}"
                        ;;
                    *)
                        ENCODER="-c:a copy"
                        ;;
                esac

                # Prefer probed channel_layout over bare channel count (e.g. "3.0",
                # "5.1(side)") to avoid acmod mismatch when splicing silence.
                pad_layout="${ORIG_CHANNELS:-2}c"
                [ -n "$APROBE_CHANNEL_LAYOUT" ] && pad_layout="$APROBE_CHANNEL_LAYOUT"

                # Run padding in background
                (
                    # 1. Generate silence matching original audio format
                    ffmpeg -y -f lavfi \
                        -i "anullsrc=r=${ORIG_SAMPLE_RATE:-48000}:cl=${pad_layout}" \
                        -t "$PAD_DURATION" \
                        $ENCODER \
                        "$TEMP_SILENCE" 2>&1

                    # 2. Concatenate original + silence via concat demuxer (stream copy).
                    # realpath: the list lives in $OUTDIR and the concat demuxer
                    # resolves its entries relative to the list file's own
                    # directory. Writing "$OUTDIR/..." entries would therefore be
                    # looked up as "$OUTDIR/$OUTDIR/..." whenever output_dir was
                    # given as a relative path (see the same guard above where the
                    # VDR multi-file list is built).
                    printf "file '%s'\nfile '%s'\n" \
                        "$(realpath "$AUDIO_FILE")" "$(realpath "$TEMP_SILENCE")" > "$TEMP_CONCAT"
                    ffmpeg -y -f concat -safe 0 -i "$TEMP_CONCAT" \
                        -c:a copy \
                        "$TEMP_PADDED" 2>&1

                    rm -f "$TEMP_SILENCE" "$TEMP_CONCAT"
                ) > "$PAD_LOG_DIR/pad_$i.log" 2>&1 &
                PAD_PIDS+=($!)
            done

            # Wait for all padding to complete and process results
            for i in "${!PAD_PIDS[@]}"; do
                wait ${PAD_PIDS[$i]}
                PAD_EXIT=$?

                AUDIO_FILE="${AUDIO_FILES[$i]}"
                AUDIO_EXT="${AUDIO_FILE##*.}"
                TEMP_PADDED="$OUTDIR/.temp_padded_${i}.${AUDIO_EXT}"

                if [ $PAD_EXIT -eq 0 ] && [ -s "$TEMP_PADDED" ]; then
                    # Get original duration for comparison
                    ORIG_DUR=$(audio_es_duration "$AUDIO_FILE")
                    ORIG_DUR_MS=$(awk "BEGIN {printf \"%.0f\", $ORIG_DUR * 1000}")

                    # Replace original with padded version
                    mv "$TEMP_PADDED" "$AUDIO_FILE"

                    # Calculate how much was added
                    NEW_DURATION=$(audio_es_duration "$AUDIO_FILE")
                    NEW_DURATION_MS=$(awk "BEGIN {printf \"%.0f\", $NEW_DURATION * 1000}")
                    ADDED_MS=$((NEW_DURATION_MS - ORIG_DUR_MS))

                    info "    $(basename "$AUDIO_FILE"): +${ADDED_MS}ms padding"
                else
                    warn "    Failed to pad $(basename "$AUDIO_FILE")"
                    warn_ffmpeg_log "$PAD_LOG_DIR/pad_$i.log" "    "
                    rm -f "$TEMP_PADDED"
                fi
            done

            # Clean up log directory
            rm -rf "$PAD_LOG_DIR"

            # Recalculate drift after padding
            FIRST_AUDIO="${AUDIO_FILES[0]}"
            AUDIO_DURATION=$(audio_es_duration "$FIRST_AUDIO")
            AUDIO_DURATION_MS=$(awk "BEGIN {printf \"%.0f\", $AUDIO_DURATION * 1000}")
            AV_DRIFT_MS=$(awk "BEGIN {printf \"%.0f\", $VIDEO_DURATION_MS - $AUDIO_DURATION_MS}")
            # Recalculate drift rate with corrected values
            AV_DRIFT_RATE=$(awk "BEGIN {printf \"%.2f\", $AV_DRIFT_MS / ($VIDEO_DURATION_MS / 60000)}")

            info "  After padding: Video=${VIDEO_DURATION_MS}ms, Audio=${AUDIO_DURATION_MS}ms, Drift=${AV_DRIFT_MS}ms"
        elif [ "${AV_DRIFT_MS#-}" -gt 50 ]; then
            # Negative drift (audio longer than video) - warn but don't fix
            warn "  A/V duration mismatch detected!"
            warn "  Audio is longer than video by ${AV_DRIFT_MS#-}ms"
            warn "  This may cause issues at the end of playback."
        else
            info "  A/V sync is good (drift: ${AV_DRIFT_MS}ms)"
        fi
    fi
    echo ""

    # 3. Try to extract subtitles (opt-in via --subs; an empty SUBTITLE_FILES
    # array keeps the .info [subtitles] section valid with count=0)
    SUBTITLE_FILES=()
    if [ "$EXPORT_SUBS" != true ]; then
        if [ ${#SUBTITLE_STREAMS[@]} -gt 0 ]; then
            info "Subtitle export disabled (${#SUBTITLE_STREAMS[@]} stream(s) present, use --subs to extract)"
            echo ""
        fi
    elif [ ${#SUBTITLE_STREAMS[@]} -gt 0 ]; then
        step "Attempting subtitle extraction..."

        # Get duration for mid-point sampling (subtitles may not exist during pre-roll/ads)
        if [ "$VDR_MULTIFILE" = true ] && [ "$CLEANUP_REPAIRED" != true ]; then
            # Use pre-calculated total duration
            sub_duration="$CONTAINER_VIDEO_DURATION"
        else
            sub_duration=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$INPUT" 2>/dev/null | head -1)
        fi
        sub_midpoint=$(awk "BEGIN {printf \"%.0f\", ${sub_duration:-0} / 2}")
        [ "$sub_midpoint" -lt 60 ] 2>/dev/null && sub_midpoint=0

        for sub in "${SUBTITLE_STREAMS[@]}"; do
            IFS=':' read -r idx codec lang <<< "$sub"

            # Quick check: does the stream contain data? Sample 120s at the
            # mid-point and, if that yields nothing, 120s from the start.
            # MEASURED 2026-08-16: ffprobe -read_intervals enumerates ZERO
            # packets on real DVB subtitle streams that a -c copy extract
            # proves non-empty (678 KB/10 min) - the old ffprobe-based check
            # therefore skipped every such stream as "empty". Byte-counting
            # an ffmpeg stream-copy sample is the reliable probe.
            sub_bytes=$(timeout 90 ffmpeg -v error -ss "$sub_midpoint" -t 120 \
                "${SUBS_INPUT_ARGS[@]}" -map 0:$idx -c copy -f mpegts - 2>/dev/null | wc -c)
            if [ "${sub_bytes:-0}" -eq 0 ]; then
                # Subs may simply be absent during the mid-point window.
                sub_bytes=$(timeout 90 ffmpeg -v error -t 120 \
                    "${SUBS_INPUT_ARGS[@]}" -map 0:$idx -c copy -f mpegts - 2>/dev/null | wc -c)
            fi
            if [ "${sub_bytes:-0}" -eq 0 ]; then
                info "  Subtitle $idx [$lang] ($codec) - empty, skipped"
                continue
            fi

            case "$codec" in
                dvb_subtitle|dvbsub)
                    # One subs-only TS serves bitmap export AND OCR, rebased
                    # to the ES timeline (PTS minus first video PTS) so both
                    # outputs line up with the demuxed streams.
                    # -copyts is essential: without it ffmpeg first rebases
                    # the output to the input start time, and since this
                    # output holds ONLY the subtitle stream, that start time
                    # is the first subtitle packet itself - avoid_negative_ts
                    # then pins it to ~0 regardless of its true position and
                    # -output_ts_offset is nullified (measured on 03x06:
                    # every recording came out with first packet = 1.400s
                    # muxdelay instead of the real 38.540s, shifting all
                    # subtitles ~37s early). With -copyts the offset is a
                    # plain subtraction: source PTS - first video PTS.
                    # A subtitle from before the video start would wrap in
                    # mpegts (no negative PTS) - acceptable, it has no video
                    # to belong to anyway.
                    SUBS_TS="$OUTDIR/.subs_only_${idx}.ts"
                    SUBS_EXTRACT_LOG="$OUTDIR/.subs_extract_${idx}.log"
                    _CLEANUP_FILES+=("$SUBS_TS" "$SUBS_EXTRACT_LOG")
                    ffmpeg -y -v warning "${SUBS_INPUT_ARGS[@]}" \
                        -copyts -output_ts_offset "-${ORIG_VIDEO_PTS:-0}" \
                        -muxdelay 0 -avoid_negative_ts disabled \
                        -map 0:$idx -c copy -f mpegts "$SUBS_TS" > "$SUBS_EXTRACT_LOG" 2>&1 || true
                    warn_ffmpeg_log "$SUBS_EXTRACT_LOG" "  "
                    if [ ! -s "$SUBS_TS" ]; then
                        info "  DVB subtitle $idx [$lang] - no data extracted, skipped"
                        continue
                    fi

                    # Matroska subtitle-only container (.mks): ffmpeg's sup
                    # muxer only accepts PGS, not dvb_subtitle (measured) -
                    # the old .sup output could never be written.
                    OUTPUT_SUB="$OUTDIR/${BASENAME}_${lang}.mks"
                    info "  DVB subtitle $idx [$lang] -> $OUTPUT_SUB (bitmap, matroska)"
                    # -map 0 + generous probe: on a subtitle-only TS ffmpeg's
                    # default stream selection finds no stream (sparse codec
                    # detection) and errors out with "does not contain any
                    # stream" (measured).
                    MKS_MUX_LOG="$OUTDIR/.subs_mks_${idx}.log"
                    _CLEANUP_FILES+=("$MKS_MUX_LOG")
                    # -copyts again: keep the ES-timeline position instead of
                    # rebasing the .mks to start at the first subtitle.
                    ffmpeg -y -v error -probesize 5M -analyzeduration 10M \
                        -copyts -i "$SUBS_TS" -map 0 -c copy -f matroska "$OUTPUT_SUB" > "$MKS_MUX_LOG" 2>&1 || true
                    warn_ffmpeg_log "$MKS_MUX_LOG" "  "
                    [ -s "$OUTPUT_SUB" ] && SUBTITLE_FILES+=("$OUTPUT_SUB") || rm -f "$OUTPUT_SUB"

                    # OCR stage (Ts2MKV-proven pipeline): bitmap -> cuttable
                    # text SRT that TTCut auto-loads. ccextractor zeroes its
                    # clock on the FIRST cue (measured; -noautotimeref does
                    # not change that), so the lead-in is handed back via
                    # -delay from the first packet PTS of the subs-only TS.
                    if command -v ccextractor &>/dev/null; then
                        OCR_SRT="$OUTDIR/${BASENAME}_${lang}.srt"
                        SUB_PTS0=$(ffprobe -v error -read_intervals "%+#1" \
                            -show_entries packet=pts_time -of csv=p=0 "$SUBS_TS" 2>/dev/null | head -1 | tr -d ',')
                        DELAY_MS=$(awk "BEGIN{printf \"%.0f\", ${SUB_PTS0:-0}*1000}")
                        info "  OCR (ccextractor, deu) -> $OCR_SRT (delay ${DELAY_MS} ms)"
                        set +e
                        ccextractor -in=ts -codec dvbsub --ocrlang deu --oem 1 --ignoreptsjumps \
                            -delay "$DELAY_MS" -o "$OCR_SRT" "$SUBS_TS" >/dev/null 2>&1
                        set -e
                        if [ -s "$OCR_SRT" ]; then
                            # Invalid UTF-8 bytes make players fall back to
                            # Latin-1 (Ts2MKV lesson); SubRip wants CRLF line
                            # endings. SRT markup (<font color>, <i>, <b>) is
                            # KEPT - TTCut renders it in the overlay since
                            # 5c37972a (QTextDocument, resources disarmed via
                            # 4d2f3348), and the colors carry speaker identity.
                            _srt_before=$(wc -c < "$OCR_SRT")
                            iconv -c -f UTF-8 -t UTF-8 "$OCR_SRT" > "$OCR_SRT.tmp" 2>/dev/null || true
                            if [ -s "$OCR_SRT.tmp" ]; then mv "$OCR_SRT.tmp" "$OCR_SRT"; else rm -f "$OCR_SRT.tmp"; fi
                            _srt_mid=$(wc -c < "$OCR_SRT")
                            # CRLF normalization GROWS the file - measure the
                            # invalid-byte removal before it, not after.
                            sed -i 's/\r*$/\r/' "$OCR_SRT"
                            [ "$_srt_before" -gt "$_srt_mid" ] && \
                                info "  OCR SRT sanitized ($((_srt_before-_srt_mid)) invalid UTF-8 byte(s) removed)"

                            # Deterministic glyph repair: tesseract cannot emit
                            # glyphs outside its charset (music note) and
                            # guesses junk (">", "}", "$"). The helper compares
                            # each line's edge glyph bitmaps (spupng dump)
                            # against the template library and fixes the SRT.
                            # The dump MUST use the same time handling as the
                            # OCR run (--ignoreptsjumps, same -delay): with
                            # different flags the two ccextractor clocks drift
                            # apart mid-recording (measured: 1.28 s at min 25).
                            GLYPH_BASE="$(dirname "$(readlink -f "$0")")"
                            GLYPH_HELPER="$GLYPH_BASE/ttcut-ocr-glyphs"
                            GLYPH_DIR="$GLYPH_BASE/ocr-glyphs"
                            if [ ! -x "$GLYPH_HELPER" ]; then
                                GLYPH_HELPER="/usr/local/src/TTCut-ng/tools/ttcut-demux/ttcut-ocr-glyphs"
                                GLYPH_DIR="/usr/local/src/TTCut-ng/tools/ttcut-demux/ocr-glyphs"
                            fi
                            # Installed layout (Debian package): helper sits in
                            # /usr/bin, the PNG templates under /usr/share.
                            if [ ! -d "$GLYPH_DIR" ] && [ -d "/usr/share/ttcut-ng/ocr-glyphs" ]; then
                                GLYPH_DIR="/usr/share/ttcut-ng/ocr-glyphs"
                            fi
                            if [ -x "$GLYPH_HELPER" ] && [ -d "$GLYPH_DIR" ] && \
                               command -v python3 &>/dev/null && \
                               ls "$GLYPH_DIR"/*.png &>/dev/null; then
                                SPU_DIR="$OUTDIR/spu_glyphs_tmp_${idx}"
                                _CLEANUP_DIRS+=("$SPU_DIR")
                                mkdir -p "$SPU_DIR"
                                # ccextractor treats everything after the LAST
                                # dot of the WHOLE -o path as an extension and
                                # strips it (measured: -o .../.spu_glyphs_5/cue
                                # put the PNGs into .../.d/ while the XML kept
                                # pointing at cue.d/). Run from inside the dir
                                # with a dot-free relative name to be immune to
                                # dots anywhere in the output path.
                                SUBS_TS_ABS=$(realpath "$SUBS_TS")
                                set +e
                                ( cd "$SPU_DIR" && ccextractor -in=ts -codec dvbsub \
                                    --no-spupngocr --out=spupng \
                                    --ignoreptsjumps -delay "$DELAY_MS" \
                                    -o cue "$SUBS_TS_ABS" ) >/dev/null 2>&1
                                if [ -s "$SPU_DIR/cue" ]; then
                                    "$GLYPH_HELPER" match --srt "$OCR_SRT" --spuxml "$SPU_DIR/cue" \
                                        --templates "$GLYPH_DIR" --delay-ms 0 --apply 2>/dev/null | \
                                        while IFS= read -r gl; do info "  glyph: $gl"; done
                                fi
                                set -e
                            fi
                            SUBTITLE_FILES+=("$OCR_SRT")
                        else
                            rm -f "$OCR_SRT"
                            warn "  OCR produced no captions - keeping the bitmap track only"
                        fi
                    else
                        warn "  ccextractor not found - OCR SRT skipped, bitmap only"
                    fi
                    ;;
                subrip|srt|text)
                    OUTPUT_SUB="$OUTDIR/${BASENAME}_${lang}.srt"
                    info "  Subtitle $idx [$lang] -> $OUTPUT_SUB"
                    ffmpeg -y "${SUBS_INPUT_ARGS[@]}" -map 0:$idx "$OUTPUT_SUB" 2>&1 | grep -E "^(Output|Stream)" || true
                    SUBTITLE_FILES+=("$OUTPUT_SUB")
                    ;;
                *)
                    warn "  Subtitle $idx [$lang]: $codec - not supported"
                    ;;
            esac
        done
        echo ""
    fi

    # 4. Calculate A/V sync offset
    # Get first packet PTS for video and audio from the ORIGINAL input (before repair)
    # The repaired file has timestamps normalized to 0, so we need the original for offset
    progress_set $(( PROGRESS_REPAIR_END + (100 - PROGRESS_REPAIR_END) * 8 / 10 ))
    step "Calculating A/V sync offset..."

    # Reuse the pre-repair measurement (probe_first_video_pts): for a single
    # file $INPUT and $ORIGINAL_INPUT were the same path; for VDR multi-file
    # the concat chain and the first segment share the same first PTS
    # (recording start).
    FIRST_VIDEO_PTS="$ORIG_VIDEO_PTS"
    # Use per-track PTS from earlier probe (ORIG_AUDIO_PTS_ARR)
    # Legacy: FIRST_AUDIO_PTS = first track's PTS (for backwards compat in .info)
    FIRST_AUDIO_PTS="${ORIG_AUDIO_PTS_ARR[0]:-}"

    # Calculate per-track A/V offset and report
    if [ -n "$FIRST_VIDEO_PTS" ]; then
        info "  Original video PTS: ${FIRST_VIDEO_PTS}s"
        for i in "${!AUDIO_STREAMS[@]}"; do
            IFS=':' read -r idx codec lang <<< "${AUDIO_STREAMS[$i]}"
            TRACK_PTS="${ORIG_AUDIO_PTS_ARR[$i]:-}"
            TRACK_TRIM="${AUDIO_TRIM_SECS[$i]:-0}"
            if [ -n "$TRACK_PTS" ]; then
                TRACK_OFFSET_MS=$(awk "BEGIN {printf \"%.0f\", ($TRACK_PTS - $FIRST_VIDEO_PTS) * 1000}")
                TRACK_TRIM_MS=$(awk "BEGIN {printf \"%.0f\", $TRACK_TRIM * 1000}")
                info "  Audio track $idx ($codec [$lang]): PTS=${TRACK_PTS}s offset=${TRACK_OFFSET_MS}ms trimmed=${TRACK_TRIM_MS}ms"
            fi
        done

        # Legacy global av_offset_ms: use first track
        if [ -n "$FIRST_AUDIO_PTS" ]; then
            AV_OFFSET_MS=$(awk "BEGIN {printf \"%.0f\", ($FIRST_AUDIO_PTS - $FIRST_VIDEO_PTS) * 1000}")
            FIRST_TRIM="${AUDIO_TRIM_SECS[0]:-0}"
            if awk "BEGIN {exit !($FIRST_TRIM > 0.01)}"; then
                FIRST_TRIM_MS=$(awk "BEGIN {printf \"%.0f\", $FIRST_TRIM * 1000}")
                AV_OFFSET_MS=$(awk "BEGIN {printf \"%.0f\", $AV_OFFSET_MS + $FIRST_TRIM_MS}")
            fi
            info "  Global av_offset_ms (from track 0): ${AV_OFFSET_MS}ms"
        else
            AV_OFFSET_MS="0"
        fi
    else
        AV_OFFSET="0"
        AV_OFFSET_MS="0"
        warn "  Could not determine A/V offset"
    fi
    echo ""

    # 5. Create info file with metadata
    OUTPUT_INFO="$OUTDIR/${BASENAME}.info"
    progress_set $(( PROGRESS_REPAIR_END + (100 - PROGRESS_REPAIR_END) * 9 / 10 ))
    step "Creating info file: $OUTPUT_INFO"

    # Calculate trimmed ms for info file
    AUDIO_TRIM_MS=$(awk "BEGIN {printf \"%.0f\", $AUDIO_TRIM_SEC * 1000}")

    cat > "$OUTPUT_INFO" << EOF
# TTCut Elementary Stream Info File
# Generated: $(date -Iseconds)
# Source: $INPUT

[video]
file=${BASENAME}.${VIDEO_EXT}
codec=$VIDEO_CODEC
width=$VIDEO_WIDTH
height=$VIDEO_HEIGHT
frame_rate=$FRAME_RATE
start_pts=$START_PTS
filler_stripped=$FILLER_STRIPPED

[timing]
# A/V sync offset in milliseconds (after correction)
# av_offset_ms = audio_pts - video_pts
# Positive = audio starts AFTER video (audio is too early in ES, delay it)
# Negative = audio starts BEFORE video (audio is too late in ES, advance it)
first_video_pts=$FIRST_VIDEO_PTS
first_audio_pts=$FIRST_AUDIO_PTS
audio_trimmed_ms=$AUDIO_TRIM_MS
# Duration mismatch: positive = video longer than audio (progressive desync)
# Values over 50ms may cause noticeable A/V drift
video_duration_ms=$VIDEO_DURATION_MS
audio_duration_ms=$AUDIO_DURATION_MS
duration_drift_ms=$AV_DRIFT_MS
drift_rate_ms_per_min=$AV_DRIFT_RATE
av_offset_ms=$AV_OFFSET_MS

[audio]
count=${#AUDIO_STREAMS[@]}
EOF

    for i in "${!AUDIO_STREAMS[@]}"; do
        IFS=':' read -r idx codec lang <<< "${AUDIO_STREAMS[$i]}"
        TRACK_TRIM="${AUDIO_TRIM_SECS[$i]:-0}"
        TRACK_TRIM_MS=$(awk "BEGIN {printf \"%.0f\", $TRACK_TRIM * 1000}")
        TRACK_PTS="${ORIG_AUDIO_PTS_ARR[$i]:-}"
        echo "audio_${i}_file=$(basename "${AUDIO_FILES[$i]}" 2>/dev/null || echo "")" >> "$OUTPUT_INFO"
        echo "audio_${i}_codec=$codec" >> "$OUTPUT_INFO"
        echo "audio_${i}_lang=$lang" >> "$OUTPUT_INFO"
        echo "audio_${i}_first_pts=$TRACK_PTS" >> "$OUTPUT_INFO"
        echo "audio_${i}_trimmed_ms=$TRACK_TRIM_MS" >> "$OUTPUT_INFO"
        # Repair balance from gap-fix classification (0 = not emitted, see brief).
        if [ -n "${TRACK_SILENCE_MS[$i]:-}" ] && [ "${TRACK_SILENCE_MS[$i]:-0}" != "0" ]; then
            echo "audio_${i}_silence_ms=${TRACK_SILENCE_MS[$i]}" >> "$OUTPUT_INFO"
        fi
        if [ -n "${TRACK_REMOVED_MS[$i]:-}" ] && [ "${TRACK_REMOVED_MS[$i]:-0}" != "0" ]; then
            echo "audio_${i}_removed_ms=${TRACK_REMOVED_MS[$i]}" >> "$OUTPUT_INFO"
        fi
        if [ -n "${AC3_FIX_RESULTS[$i]:-}" ]; then
            echo "audio_${i}_ac3_fixed=true" >> "$OUTPUT_INFO"
            echo "audio_${i}_ac3_fixed_frames=${AC3_FIX_RESULTS[$i]}" >> "$OUTPUT_INFO"
        fi
        # corrupt_ranges is what TTCut-ng turns into a "Tonstoerung" marker, so
        # it carries real damage only. The byte counters are human diagnostics
        # (TTESInfo deliberately does not parse them) and are written whenever
        # the sanitizer removed anything at all - including the partial frames
        # at the recording edges, which are trimmed but are not damage.
        if [ -n "${AUDIOFIX_CORRUPT_RANGES[$i]:-}" ]; then
            echo "audio_${i}_corrupt_ranges=${AUDIOFIX_CORRUPT_RANGES[$i]}" >> "$OUTPUT_INFO"
        fi
        if [ "${AUDIOFIX_JUNK_BYTES[$i]:-0}" != "0" ]; then
            echo "audio_${i}_junk_bytes=${AUDIOFIX_JUNK_BYTES[$i]}" >> "$OUTPUT_INFO"
            echo "audio_${i}_dropped_frames=${AUDIOFIX_DROPPED[$i]:-0}" >> "$OUTPUT_INFO"
        fi
    done

    cat >> "$OUTPUT_INFO" << EOF

[subtitles]
count=${#SUBTITLE_FILES[@]}
EOF

    for i in "${!SUBTITLE_FILES[@]}"; do
        echo "sub_${i}_file=$(basename "${SUBTITLE_FILES[$i]}")" >> "$OUTPUT_INFO"
    done

    WARNINGS_HEADER_WRITTEN=false
    write_warnings_header_if_needed() {
        if ! $WARNINGS_HEADER_WRITTEN; then
            echo "" >> "$OUTPUT_INFO"
            echo "[warnings]" >> "$OUTPUT_INFO"
            WARNINGS_HEADER_WRITTEN=true
        fi
    }

    if [ -n "$ES_TOTAL_AUS" ]; then
        write_warnings_header_if_needed
        echo "es_total_aus=$ES_TOTAL_AUS" >> "$OUTPUT_INFO"
    fi
    if [ -n "$ES_DOUBLED_PTS_CSV" ]; then
        write_warnings_header_if_needed
        echo "es_doubled_pts_aus=$ES_DOUBLED_PTS_CSV" >> "$OUTPUT_INFO"
    fi

    # Emit audio_gap_frames= as comma-separated frame indices spanning each gap.
    # Uses first_video_pts as reference (PTS-derived display-time frames;
    # NOT the raw AU numbering that es_doubled_pts_aus uses).
    if [ ${#AUDIO_GAP_FRAMES_SOURCE_PTS[@]} -gt 0 ] && [ -n "$FIRST_VIDEO_PTS" ]; then
        FRAME_RATE_NUM_LOCAL=$(echo "$FRAME_RATE" | cut -d'/' -f1)
        FRAME_RATE_DEN_LOCAL=$(echo "$FRAME_RATE" | cut -d'/' -f2)
        FRAME_RATE_DEN_LOCAL="${FRAME_RATE_DEN_LOCAL:-1}"

        ALL_GAP_FRAMES=()
        for entry in "${AUDIO_GAP_FRAMES_SOURCE_PTS[@]}"; do
            IFS=' ' read -r gs ge silence_ms <<< "$entry"
            gs_frame=$(awk "BEGIN {printf \"%d\", ($gs - $FIRST_VIDEO_PTS) * $FRAME_RATE_NUM_LOCAL / $FRAME_RATE_DEN_LOCAL + 0.5}")
            [ "$gs_frame" -lt 0 ] && gs_frame=0
            # Compute end-frame from silence_ms (at least 1 frame for visibility)
            silence_frames=$(awk "BEGIN {f = $silence_ms / 1000.0 * $FRAME_RATE_NUM_LOCAL / $FRAME_RATE_DEN_LOCAL; printf \"%d\", (f >= 1) ? f : 0}")
            ge_frame=$(( gs_frame + silence_frames ))
            for ((f = gs_frame; f <= ge_frame; f++)); do
                ALL_GAP_FRAMES+=("$f")
            done
        done

        GAP_FRAMES_SORTED=$(printf '%s\n' "${ALL_GAP_FRAMES[@]}" | sort -n -u | paste -sd,)
        if [ -n "$GAP_FRAMES_SORTED" ]; then
            write_warnings_header_if_needed
            echo "audio_gap_frames=$GAP_FRAMES_SORTED" >> "$OUTPUT_INFO"
        fi
    fi

    # es_missing_frames / es_missing_ranges: video holes (VIDEO_GAPS_FILE rows
    # "src_start src_end gap_ms") mapped to OUTPUT-ES frame coordinates - each
    # hole shifts everything after it earlier by the frames already lost
    # before it, since the output ES has those frames physically missing.
    if [ -s "$VIDEO_GAPS_FILE" ] && [ -n "$FIRST_VIDEO_PTS" ]; then
        MISS_FRAMES=""
        lost_before=0
        MISS_POS_MS=""   # raw "fs ms" rows, one per hole, input to the clustering pass below
        while IFS=' ' read -r vs ve vms; do
            fs=$(awk "BEGIN {printf \"%.0f\", (($vs - $FIRST_VIDEO_PTS) - $lost_before) * $FRAME_RATE_DEC}")
            MISS_FRAMES="${MISS_FRAMES:+$MISS_FRAMES,}$fs"
            MISS_POS_MS="${MISS_POS_MS:+$MISS_POS_MS$'\n'}$fs ${vms%.*}"
            lost_before=$(awk "BEGIN {printf \"%.6f\", $lost_before + ($ve - $vs)}")
        done < "$VIDEO_GAPS_FILE"
        if [ -n "$MISS_FRAMES" ]; then
            write_warnings_header_if_needed
            # es_missing_frames stays the raw, unclustered per-hole list
            # (informational; one entry per row of VIDEO_GAPS_FILE).
            echo "es_missing_frames=$MISS_FRAMES" >> "$OUTPUT_INFO"
            # es_missing_ranges is clustered (same <=2s / 2*fps-frames rule
            # as corrupt_frame_ranges above): every raw hole used to become
            # its own point-range, which on real signal-loss material is
            # dozens to hundreds of degenerate single-frame ranges (measured
            # g1: 5, incl. an exact duplicate position; g2: 137, 13 with
            # negative ms from DTS/PTS boundary artifacts) instead of the
            # handful of actual defect zones a human/consumer cares about.
            # Merged-range end is the LAST member's fs+1 - a single-frame
            # "fs-fs+1" span is the degenerate range for an isolated hole:
            # the gap itself contributes no output-ES frames (it was
            # physically removed by the demux), so the range only marks
            # where it used to sit. Merged ms is the SUM of member ms, each
            # first clamped to >=0 (a negative raw ms is a DTS/PTS boundary
            # artifact, not real silence to subtract).
            MISS_RANGES=$(printf '%s\n' "$MISS_POS_MS" | sort -n -k1,1 | awk -v fps="$FRAME_RATE_DEC" '
                { fs = $1; ms = $2; if (ms < 0) ms = 0
                  if (state && fs - last_fs <= 2*fps) { last_fs = fs; sum_ms += ms; next }
                  if (state) { printf "%s%d-%d:%d", sep, start_fs, last_fs + 1, sum_ms; sep = "," }
                  start_fs = fs; last_fs = fs; sum_ms = ms; state = 1 }
                END { if (state) printf "%s%d-%d:%d", sep, start_fs, last_fs + 1, sum_ms }')
            echo "es_missing_ranges=$MISS_RANGES" >> "$OUTPUT_INFO"
            warn "  Missing video frame(s) at $(format_ranges_hms "$MISS_RANGES" "$FRAME_RATE_DEC")"
        fi
    fi

    # es_lost_ms: total picture loss, summed from the DETECTED video gaps,
    # not from the span difference: the repair stage runs with
    # -fflags +genpts+igndts and smooths the PTS jump at the segment seam
    # before VIDEO_SPAN_MS is measured. The difference therefore only sees
    # the loss INSIDE a segment (measured 2026-08-24 on "03x15": 27178
    # instead of 135520 ms). The gap file knows both parts. Audio stays in
    # sync (padded to fill the same gaps), so this is a picture-only defect
    # the user should be told about, distinct from the AV drift reported
    # above.
    ES_LOST_MS=0
    if [ -s "$VIDEO_GAPS_FILE" ]; then
        ES_LOST_MS=$(awk '{s += $2 - $1} END {printf "%.0f", s * 1000}' "$VIDEO_GAPS_FILE")
    fi
    echo "es_lost_ms=$ES_LOST_MS" >> "$OUTPUT_INFO"
    if [ "$ES_LOST_MS" -gt 1000 ]; then
        # Zweiter Halbsatz ist Absicht: ohne ihn liest sich die Meldung wie ein
        # Sync-Fehler, und genau den gibt es hier nicht mehr.
        LOSS_POS_COUNT=$(echo "$MISS_RANGES" | tr ',' '\n' | grep -c .)
        if [ "$LOSS_POS_COUNT" -gt 0 ]; then
            LOSS_POS_TEXT="$LOSS_POS_COUNT position(s)"
        else
            # MISS_RANGES can be empty while es_lost_ms is still >0 (VIDEO_GAPS_FILE
            # present but its rows didn't cluster into a named range) - "0
            # position(s)" would misreport a defect as absent.
            LOSS_POS_TEXT="an unlisted position"
        fi
        warn "Material loss: $(awk "BEGIN {printf \"%.1f\", $ES_LOST_MS/1000}") s missing at $LOSS_POS_TEXT - picture jumps there, audio stays in sync"
    fi

    # corrupt_frame_ranges: frames present in the output ES but flagged
    # corrupt by the demuxer/parser during extraction (VIDEO_CORRUPT_DTS_TICKS
    # was captured from the video demux log before it was cleaned up, above).
    # Cluster dts ticks <=2s apart into one range (same seam tends to log
    # several corrupt packets close together).
    #
    # dts is a raw 33-bit (90kHz) PES timestamp field, printed by ffmpeg
    # BEFORE its own wrap-correction runs (libavformat/demux.c logs "Packet
    # corrupt" ahead of update_timestamps()). That field wraps every 2^33
    # ticks (~26.5h) from wherever the broadcaster's counter happened to be
    # when this recording started - unrelated to FIRST_VIDEO_PTS's own
    # wrap-relative value. Measured on a real recording (07x11) where
    # first_video_pts's raw tick was only ~1517s short of the 2^33 boundary:
    # every "Packet corrupt" line logged after that point in the recording
    # printed a small post-wrap dts (~1386s-2682s), which naively subtracting
    # fvp_ticks (~8.45G ticks) from turned massively negative and got
    # dropped by "f < 0" below, leaving corrupt_frame_ranges empty despite
    # 69 real corrupt-packet lines in the log. Re-adding 2^33 until the delta
    # is non-negative undoes the wrap (a single wrap covers any recording
    # under ~26.5h, which every TS recording is) and reproduces the correct
    # elapsed-time-since-start value.
    #
    # Ordering matters: wrap-correct and convert to a frame number BEFORE
    # sorting. VDR can re-acquire signal on a different broadcaster PTS
    # base after a full signal loss (a fresh 33-bit counter era); a raw dts
    # tick from that era, once wrap-corrected, can land far outside the
    # recording (frame count massively beyond total, or - after the old
    # "sort raw ticks first" ordering scrambled chronological order -
    # start>end inverted ranges). Measured on g2_final/00001.info: an
    # inverted range "4760978-25194" and 7 ranges beyond 600k frames on a
    # ~187k-frame recording. Sorting raw (pre-wrap) ticks numerically also
    # put post-wrap (small-value) ticks before pre-wrap (large-value) ticks
    # even though the post-wrap ones happened later in the recording -
    # scrambling cluster order. Fix: wrap-correct + convert to frames per
    # tick first, drop anything outside [0, VIDEO_FRAME_COUNT] right there
    # (defense against a foreign PTS era surviving the wrap correction),
    # THEN sort the resulting frame numbers, THEN cluster. Clustering on
    # ascending input guarantees start<=end for every emitted range, but
    # the emission still checks it explicitly as a second line of defense.
    if [ -n "${VIDEO_CORRUPT_DTS_TICKS:-}" ] && [ -n "$FIRST_VIDEO_PTS" ]; then
        CORRUPT_RANGES=$(printf '%s\n' "$VIDEO_CORRUPT_DTS_TICKS" | grep -v '^$' | awk -v fvp="$FIRST_VIDEO_PTS" -v fps="$FRAME_RATE_DEC" -v maxf="${VIDEO_FRAME_COUNT:-0}" '
            BEGIN { fvp_ticks = fvp * 90000.0; wrap33 = 8589934592 }
            { d = $1 - fvp_ticks
              while (d < 0) d += wrap33
              f = int((d/90000.0) * fps)
              if (f < 0 || f > maxf) next
              print f }' | sort -n | awk -v fps="$FRAME_RATE_DEC" '
            { f = $1
              if (state && f - last <= 2*fps) { last = f; next }        # <=2s: same range
              if (state) { if (start <= last) { printf "%s%d-%d", sep, start, last; sep="," } }
              start = f; last = f; state = 1 }
            END { if (state && start <= last) printf "%s%d-%d", sep, start, last }')
        if [ -n "$CORRUPT_RANGES" ]; then
            write_warnings_header_if_needed
            echo "corrupt_frame_ranges=$CORRUPT_RANGES" >> "$OUTPUT_INFO"
            warn "  Corrupt video frame(s) at $(format_ranges_hms "$CORRUPT_RANGES" "$FRAME_RATE_DEC")"
        fi
    fi

    # Add VDR markers if found
    if [ ${#VDR_MARKS[@]} -gt 0 ]; then
        cat >> "$OUTPUT_INFO" << EOF

[markers]
# VDR markad markers (from: $MARKS_FILE)
# Format: index=timestamp|frame|type|verified
# type: start=content starts (ad ends), stop=content stops (ad starts), mark=unknown
count=${#VDR_MARKS[@]}
EOF
        for i in "${!VDR_MARKS[@]}"; do
            echo "marker_${i}=${VDR_MARKS[$i]}" >> "$OUTPUT_INFO"
        done
        info "  Added ${#VDR_MARKS[@]} VDR markers to info file"
    fi

    # Copy markad logo PGM if available
    pgm_file=$(find "$INPUT_DIR" -maxdepth 1 -name '*-P0.pgm' -type f 2>/dev/null | head -1)
    if [ -n "$pgm_file" ]; then
        logo_dest="${OUTDIR}/${BASENAME}.logo.pgm"
        cp "$pgm_file" "$logo_dest"
        info "Logo PGM copied: $(basename "$pgm_file") -> $(basename "$logo_dest")"
    fi

    # Summary
    echo ""
    info "=== Elementary Stream Demux Complete ==="
    echo ""
    info "Output files:"
    while IFS= read -r line; do
        info "  $line"
    done < <(ls -lh "$OUTDIR/${BASENAME}"* 2>/dev/null | grep -v "^total" || true)
    echo ""
    info "Video for TTCut: $OUTPUT_VIDEO"
    info "Info file: $OUTPUT_INFO"
    if [ ${#AUDIO_FILES[@]} -gt 0 ]; then
        info "Audio files: ${#AUDIO_FILES[@]} track(s)"
    fi

fi

#############################################################################
# CLEANUP
#############################################################################
# Remove temporary repaired file
if [ "${CLEANUP_REPAIRED:-false}" = "true" ] && [ -f "$REPAIRED_INPUT" ]; then
    rm -f "$REPAIRED_INPUT"
fi

# Done. The file itself goes away with _CLEANUP_FILES on exit; a wrapper
# polling it sees 100 for as long as it takes to notice the process ended.
progress_set 100
