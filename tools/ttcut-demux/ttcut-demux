#!/bin/bash
#
# ttcut-demux - Demux and normalize TS files for TTCut
# Similar to ProjectX for MPEG-2, but for H.264/H.265 (AVC/HEVC)
#
# Supported video codecs: H.264 (AVC), H.265 (HEVC), MPEG-2
# Supported audio codecs: MP2, AC3, EAC3 (DD+), AAC, MP3
#
# Multi-core optimization: Video and audio streams are extracted in parallel,
# the audio tracks are placed on the picture timeline in parallel too.
#
# Usage: ttcut-demux [-e] [-A] [--subs|--no-subs] [-n name] <input.ts> [output_dir]
#
# Output: elementary streams (.264/.265/.m2v + audio files + .info).
# -e is accepted for compatibility (ES demux has always been the TTCut
# workflow and is the only mode since the normalized-MKV mode was removed).
#

set -e

# Numbers with a decimal point, whatever the user's locale: the script
# passes computed values (frame rates, timestamps, durations) from one awk,
# sort or printf to the next, and mawk - Debian's default awk - prints and
# reads them with the locale's decimal separator. Under de_DE that turned
# 25.000000 into 25,000000 and the next awk call into a syntax error.
# LC_ALL overrides LC_NUMERIC, so a set LC_ALL moves into LANG first - every
# other category keeps the user's locale.
if [ -n "${LC_ALL:-}" ]; then
    export LANG="$LC_ALL"
    unset LC_ALL
fi
export LC_NUMERIC=C

# Track all temp files/dirs we create so a failure (set -e abort, SIGINT,
# disk-full, ...) doesn't leave multi-GB junk in $OUTDIR. Files are removed;
# directories are removed recursively (via rm -rf inside the trap below).
_CLEANUP_FILES=()
_CLEANUP_DIRS=()


_cleanup_temps() {
    local rc=$?
    if [ ${#_CLEANUP_FILES[@]} -gt 0 ]; then
        rm -f "${_CLEANUP_FILES[@]}" 2>/dev/null || true
    fi
    if [ ${#_CLEANUP_DIRS[@]} -gt 0 ]; then
        rm -rf "${_CLEANUP_DIRS[@]}" 2>/dev/null || true
    fi
    exit $rc
}
trap _cleanup_temps EXIT

# INT/TERM must abort the whole run, not just the current step. Bash defers
# the trap until the foreground child returns, and ffmpeg catches SIGINT and
# exits NORMALLY (trailer written, rc 255) - without an explicit abort exit
# here, a Ctrl-C would only skip the current ffmpeg invocation and the
# script would march on to the next step. Kill background jobs (parallel
# extraction / placement subshells), then exit 130; the EXIT trap above does
# the temp cleanup exactly once.
_abort_demux() {
    echo "" >&2
    echo "[ABORT] Interrupted - stopping and cleaning up" >&2
    local pids
    pids=$(jobs -p 2>/dev/null)
    [ -n "$pids" ] && kill $pids 2>/dev/null
    exit 130
}
trap _abort_demux INT TERM

# Colors for output (disabled when stdout is not a terminal)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    CYAN='\033[1;36m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    CYAN=''
    NC=''
fi

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }
step() { echo -e "${CYAN}[STEP]${NC} $1"; }

# Map an ffprobe codec_name to the file extension we use for the demuxed
# audio track.
audio_ext_for_codec() {
    case "$1" in
        mp2|mp3) echo "mp2" ;;
        ac3)     echo "ac3" ;;
        eac3)    echo "eac3" ;;
        aac)     echo "aac" ;;
        *)       echo "$1" ;;
    esac
}

# Quiet ffprobe on one stream: SELECTOR in -select_streams syntax (empty =
# all streams), the remaining arguments verbatim. stderr is dropped, the
# callers below decide what an empty result means.
_ffprobe() {
    local selector=$1
    shift
    local -a sel=()
    if [ -n "$selector" ]; then sel=(-select_streams "$selector"); fi
    ffprobe -v error "${sel[@]}" "$@" 2>/dev/null
}

# First packet PTS of one stream of FILE, as ffprobe prints it (empty when the
# probe fails). An empty SELECTOR probes the first packet of any stream;
# READ_INTERVALS (optional) limits the probe window.
_probe_first_packet_pts() {
    local selector=$1 file=$2 intervals=${3:-}
    local -a win=()
    if [ -n "$intervals" ]; then win=(-read_intervals "$intervals"); fi
    _ffprobe "$selector" "${win[@]}" -show_entries packet=pts_time -of csv=p=0 "$file" \
        | head -1 | tr -d ','
}

# One ffprobe field as a bare value (-of default=noprint_wrappers=1:nokey=1).
# Args: SELECTOR (empty = no -select_streams) ENTRIES FILE
_probe_field() {
    _ffprobe "$1" -show_entries "$2" -of default=noprint_wrappers=1:nokey=1 "$3"
}

# Split "NUM/DEN" (ffprobe frame-rate notation) into two variables; a plain
# number gets DEN=1. Args: VALUE NUM_VAR DEN_VAR
_parse_fraction() {
    local -n _num=$2 _den=$3
    _num=$(echo "$1" | cut -d'/' -f1)
    _den=$(echo "$1" | cut -d'/' -f2)
    _den="${_den:-1}"
}

# Frame rate for the .info: the TS r_frame_rate, halved for interlaced
# material when it is the field rate, i.e. twice the TS avg_frame_rate.
# libav 9.0.2 sums the packet durations for avg_frame_rate, and takes a
# packet's duration from the SPS timing (from r_frame_rate only when the
# stream has none; libavformat/demux.c compute_frame_duration). Measured
# 2026-09-27: 1080i25 PAFF reports r=50/avg=25, MBAFF 25/25, 720p50 50/50.
# Not measured: a PAFF TS without SPS timing may report avg = r and then
# stays at the field rate. The ES avg_frame_rate is no reference - for a
# raw ES it is always the raw demuxer's default 25.
# Args: R_FRAME_RATE AVG_FRAME_RATE FIELD_ORDER; prints NUM/DEN.
video_frame_rate() {
    local rn rd an ad ratio
    _parse_fraction "$1" rn rd
    _parse_fraction "${2:-0/1}" an ad
    if [[ -n "$3" && "$3" != "progressive" && "$3" != "unknown" \
          && "$an" -gt 0 && "$ad" -gt 0 && "$rd" -gt 0 ]]; then
        ratio=$(awk "BEGIN {printf \"%.1f\", ($rn / $rd) / ($an / $ad)}")
        if [[ "$ratio" == "2.0" ]]; then
            if (( rn % 2 == 0 )); then echo "$((rn / 2))/$rd"; else echo "$rn/$((rd * 2))"; fi
            return
        fi
    fi
    echo "$rn/$rd"
}

# PTS of TTCut-ng's frame 0 in $1, codec-aware (reads $VIDEO_CODEC, so call
# only after stream discovery):
# H.264/H.265: the first packet in stream order. The pictures behind it with
# a smaller PTS (open-GOP leading B / RASL) are shown by no decoder on a cold
# start, and TTCut-ng drops them from its frame index
# (TTDisplayOrderMap::markH264ColdStartLeadingPics).
# MPEG-2: the smallest PTS of the first 2 s. TTCut-ng numbers the leading B
# pictures behind the first I as frames 0 and 1.
probe_first_video_pts() {
    local src=$1
    if [ "$VIDEO_CODEC" = "hevc" ] || [ "$VIDEO_CODEC" = "h265" ] || [ "$VIDEO_CODEC" = "h264" ]; then
        _probe_first_packet_pts v:0 "$src"
    else
        ffprobe -v error -select_streams v:0 -read_intervals "%+2" \
            -show_entries packet=pts_time -of csv=p=0 "$src" 2>/dev/null | \
            tr -d ',' | grep -E '^[0-9]' | LC_ALL=C sort -g | head -1
    fi
}

# Probe audio stream properties of $1 into the APROBE_* globals.
# Values failing numeric validation become empty; the bitrate gets the
# codec-dependent default (mp2 192k, ac3 384k, aac 192k). sample_rate,
# channels, and channel_layout are left empty on probe failure — each call
# site applies its own fallback. Used for the silence frame of the slot rule.
#
# Known unfixable limitation: ffprobe cannot distinguish AC3 dual-mono
# (acmod 0, two independent mono programs) from stereo (acmod 2) — both
# report channel_layout=stereo. Silence generated for a dual-mono source
# therefore falls back to plain stereo; there is no ffprobe signal to do
# better.
probe_audio_props() {
    local af=$1
    APROBE_CODEC=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name \
        -of default=noprint_wrappers=1:nokey=1 "$af" 2>/dev/null)
    APROBE_SAMPLE_RATE=$(ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate \
        -of default=noprint_wrappers=1:nokey=1 "$af" 2>/dev/null)
    APROBE_CHANNELS=$(ffprobe -v error -select_streams a:0 -show_entries stream=channels \
        -of default=noprint_wrappers=1:nokey=1 "$af" 2>/dev/null)
    APROBE_BITRATE=$(ffprobe -v error -select_streams a:0 -show_entries stream=bit_rate \
        -of default=noprint_wrappers=1:nokey=1 "$af" 2>/dev/null)
    APROBE_CHANNEL_LAYOUT=$(ffprobe -v error -select_streams a:0 -show_entries stream=channel_layout \
        -of default=noprint_wrappers=1:nokey=1 "$af" 2>/dev/null)
    [[ "$APROBE_SAMPLE_RATE" =~ ^[0-9]+$ ]] || APROBE_SAMPLE_RATE=""
    [[ "$APROBE_CHANNELS" =~ ^[0-9]+$ ]] || APROBE_CHANNELS=""
    [[ "$APROBE_BITRATE" =~ ^[0-9]+$ ]] || APROBE_BITRATE=""
    # "unknown" is ffprobe's literal output when it cannot map the channel
    # count/config to a named layout; treat it the same as empty.
    [ "$APROBE_CHANNEL_LAYOUT" = "unknown" ] && APROBE_CHANNEL_LAYOUT=""
    case "$APROBE_CODEC" in
        mp2)  [ -n "$APROBE_BITRATE" ] || APROBE_BITRATE=192000 ;;
        ac3)  [ -n "$APROBE_BITRATE" ] || APROBE_BITRATE=384000 ;;
        aac)  [ -n "$APROBE_BITRATE" ] || APROBE_BITRATE=192000 ;;
    esac
}

# One shared filter for surfacing ffmpeg log lines as warnings (superset of
# the per-site patterns that existed before; may surface a few more lines).
readonly FFMPEG_WARN_PATTERN='error|warning|invalid|corrupt|failed|suppress|too many|repeated|mismatch'

# Subtitle stream IDX of the source as a subtitle-only TS on the ES timeline.
# All four time flags are load-bearing (see the subtitle export); the
# stream-copy extraction and the re-encode fallback share them here so the
# two cannot drift apart. Arguments after OUT and LOG are the codec options.
_extract_subs_ts() {
    local idx=$1 out=$2 log=$3
    shift 3
    ffmpeg -y -v warning "${ORIG_INPUT_ARGS[@]}" \
        -copyts -output_ts_offset "-${ORIG_VIDEO_PTS:-0}" \
        -muxdelay 0 -avoid_negative_ts disabled \
        -map "0:$idx" "$@" -f mpegts "$out" > "$log" 2>&1 || true
    warn_ffmpeg_log "$log" "  "
}

# ccextractor zeroes its clock on the first cue, so the lead-in is handed
# back via -delay: the first packet PTS of the file it reads, in ms.
_subs_delay_ms() {
    local pts0
    pts0=$(_probe_first_packet_pts "" "$1" "%+#1")
    awk "BEGIN{printf \"%.0f\", ${pts0:-0}*1000}"
}

# OCR of subtitle-only TS into SRT with DELAY_MS; returns ccextractor's exit
# code. The glyph dump later uses the same time flags on the same file.
_run_ocr() {
    ccextractor -in=ts -codec dvbsub --ocrlang deu --oem 1 --ignoreptsjumps \
        -delay "$3" -o "$2" "$1" >/dev/null 2>&1
}

# Echo matching lines of log file $1 as warnings, prefixed with $2 (optional).
# $3 (optional): extended regex; matching lines are skipped.
warn_ffmpeg_log() {
    local logfile=$1 prefix=${2:-} skip=${3:-}
    grep -iE "$FFMPEG_WARN_PATTERN" "$logfile" 2>/dev/null | \
        while IFS= read -r line; do
            [ -n "$skip" ] && [[ "$line" =~ $skip ]] && continue
            warn "${prefix}ffmpeg: $line"
        done
}

# Lines ffmpeg emits for one damaged packet. Only the middle one carries a
# position, so they are silenced as a group or not at all.
readonly FFMPEG_PACKET_CORRUPT_PATTERN='PES packet size mismatch|Packet corrupt \(stream|corrupt input packet in stream'
# How far from either end of the recording still counts as its edge. The
# partial packet a recording is cut off in measures 0.3-0.8 s from the end on
# real material; 2 s is generous towards that and still nowhere near the
# middle of a recording.
readonly FFMPEG_EDGE_WINDOW_S=2

# ffmpeg_audio_corruption_is_edge_only LOGFILE START_PTS DURATION_S
#
# True when the log holds at least one "Packet corrupt (stream = N, dts = M)"
# for an AUDIO stream (N != 0) and EVERY one of them sits within
# FFMPEG_EDGE_WINDOW_S of either end of the recording - i.e. the recording was
# cut mid-packet, which is normal and not worth a warning. False when any of
# them sits further in (then the whole group is reported as before, since the
# context-less companion lines cannot be attributed to one packet or another),
# and false when there are none at all - nothing to silence.
#
# Video (stream 0) is deliberately ignored: those packets already drive
# corrupt_frame_ranges further down.
ffmpeg_audio_corruption_is_edge_only() {
    local logfile=$1 start_pts=$2 duration=$3
    [ -r "$logfile" ] || return 1
    [ -n "$start_pts" ] && [ -n "$duration" ] || return 1

    local ticks
    ticks=$(grep -oE 'Packet corrupt \(stream = [1-9][0-9]*, dts = [0-9]+' "$logfile" 2>/dev/null \
            | grep -oE '[0-9]+$' || true)
    [ -n "$ticks" ] || return 1

    # A flag rather than "exit 1" in the body: awk's exit jumps to END, whose
    # own exit would overwrite the status and report every log as edge-only.
    echo "$ticks" | awk -v s="$start_pts" -v d="$duration" -v w="$FFMPEG_EDGE_WINDOW_S" '
        { off = $1 / 90000.0 - s
          if (off > w && off < d - w) inside = 1 }
        END { exit (inside ? 1 : 0) }'
}

# Poll a background ffmpeg's -progress file every two seconds until the
# process exits, handing each new out_time_us value (output timeline in
# microseconds) to the named reporter function.
_poll_ffmpeg_progress() {
    local pid=$1 prog_file=$2 reporter=$3 out_us
    while kill -0 "$pid" 2>/dev/null; do
        sleep 2
        out_us=$(grep '^out_time_us=' "$prog_file" 2>/dev/null | tail -1 | cut -d= -f2)
        [ -n "$out_us" ] || continue
        "$reporter" "$out_us"
    done
}

# The three slot-rule functions run awk and sort under LC_ALL=C: mawk reads
# and prints numbers with the locale's decimal point (a comma under de_DE).
#
# Run index per PTS line of FILE -> OUT as "run pts". A new run starts where
# the PTS stays more than 0.5 s below the recent level for 10 packets; the
# level is the 3rd-highest PTS of the previous 12 packets, so one stray
# PTS (a corrupt packet) is no jump. N/A lines keep the current run.
pts_runs() {
    LC_ALL=C awk '
        function third_highest(   i, j, t, v, w) {
            for (i = 0; i < 12; i++) v[i] = last[(lp + i) % 12]
            for (i = 0; i < 12; i++) for (j = i + 1; j < 12; j++) if (v[j] > v[i]) { t = v[i]; v[i] = v[j]; v[j] = t }
            return v[2]
        }
        { pts[NR] = $1 }
        END {
            run = 0; n = 0; lp = 0
            for (k = 1; k <= NR; k++) {
                p = pts[k]
                if (p == "N/A") { print run, p; continue }
                if (n >= 12) {
                    ref = third_highest()
                    if (p < ref - 0.5) {
                        low = 1
                        for (m = k; m < k + 10 && m <= NR; m++) if (pts[m] != "N/A" && pts[m] >= ref - 0.5) { low = 0; break }
                        if (low) { run++; n = 0; lp = 0 }
                    }
                }
                last[lp] = p + 0; lp = (lp + 1) % 12; if (n < 12) n++
                print run, p
            }
        }' "$1" > "$2"
}

# Picture slots = TTCut-ng's frame index: pictures in display order, slot i
# shown at i*FRAME_DUR. MODE h26x: the cold start drops every picture of the
# first run with a PTS below V0 (open-GOP leading / RASL pictures, which no
# decoder shows); mpeg2: V0 is the smallest PTS, nothing is dropped.
# A picture less than 0.75 frame durations behind the previous slot of its
# run is the same frame: H.264 PAFF comes as two packets per frame (measured
# on the raw ES: 6000 packets for 3000 frames), the second field with the
# same PTS, half a frame later or without one.
# OUT_HOLES gets one line per picture hole (two slots of one run more than
# 1.5 frame durations apart), "start end lost_ms" with start = frame 0 PTS +
# slot time + what was lost before: the source PTS of the hole inside one
# run, and a usable position across runs too. Holes among the last 16 slots
# are not written: a recording ends inside a GOP, and the pictures not yet
# transmitted (they display before the last ones received; 16 = the largest
# reorder depth of H.264/H.265) are its normal end, not damage. They stay
# holes for the audio placement.
# A stray PTS - one corrupt packet, more than 1 s away from the pictures
# before AND behind it in stream order (median of up to 6 on each side; at a
# hole or a run edge a picture agrees with one side) - is no place on the
# timeline: sorted by its value it would open a hole where it belongs and add
# a slot where it does not (a stray low PTS would even become frame 0). The
# picture goes back into the hole next to its neighbours when there is one,
# and gets no slot otherwise.
# FRAME_DUR may be a fraction ("1001/30000"): 29.97 fps has no finite decimal,
# and a duration rounded to 6 places drifts by an audio frame within 23 min.
# Args: VIDEO_PTS_FILE MODE V0 FRAME_DUR OUT OUT_HOLES  ->  OUT lines "run slot pts"
video_slots() {
    local vpts=$1 mode=$2 v0=$3 fdur=$4 out=$5 holes=$6
    local runs="$out.runs" strays="$out.strays" sorted="$out.sorted"
    : > "$holes"; : > "$strays"
    pts_runs "$vpts" "$runs"
    # stream order: split off the strays as "run level" (level = the median
    # of the side they are nearer to)
    LC_ALL=C awk -v strays="$strays" '
        function side_median(i, step,   j, n, k, t, v) {
            n = 0
            for (j = i + step; j >= 1 && j <= NR && n < 6 && run[j] == run[i] && (j - i) * step <= 24; j += step)
                if (pts[j] != "N/A") v[n++] = pts[j] + 0
            if (n < 3) return "none"
            for (j = 0; j < n; j++) for (k = j + 1; k < n; k++) if (v[k] < v[j]) { t = v[j]; v[j] = v[k]; v[k] = t }
            return v[int(n / 2)]
        }
        function dist(a, b) { return (a > b) ? a - b : b - a }
        { run[NR] = $1; pts[NR] = $2 }
        END {
            for (i = 1; i <= NR; i++) {
                if (pts[i] == "N/A") continue
                before = side_median(i, -1); behind = side_median(i, 1)
                far_before = (before != "none" && dist(pts[i], before) > 1.0)
                far_behind = (behind != "none" && dist(pts[i], behind) > 1.0)
                if ((far_before && far_behind) || (far_before && behind == "none") || (far_behind && before == "none")) {
                    level = (before == "none") ? behind : (behind == "none") ? before \
                          : (dist(pts[i], before) < dist(pts[i], behind)) ? before : behind
                    printf "%d %.6f\n", run[i], level > strays
                } else print run[i], pts[i]
            }
        }' "$runs" | LC_ALL=C sort -k1,1n -k2,2g -u > "$sorted"
    # a stray takes the free picture place nearest to its level, within 1 s
    if [ -s "$strays" ]; then
        LC_ALL=C awk -v strays="$strays" -v fdur="$fdur" '
            function num(s,   a) { return (split(s, a, "/") == 2) ? a[1] / a[2] : s + 0 }
            function dist(a, b) { return (a > b) ? a - b : b - a }
            BEGIN { fdur = num(fdur); ns = 0
                    while ((getline line < strays) > 0) { split(line, f, " "); srun[ns] = f[1]; slev[ns] = f[2] + 0; ns++ } }
            { r[n] = $1; p[n] = $2 + 0; n++ }
            END {
                for (s = 0; s < ns; s++) {
                    best = ""; bestd = 1.0
                    for (i = 1; i < n; i++) {
                        if (r[i] != srun[s] || r[i - 1] != srun[s] || p[i] - p[i - 1] <= 1.5 * fdur) continue
                        free = int((p[i] - p[i - 1]) / fdur + 0.5) - 1          # picture places in this hole
                        for (k = 1; k <= free; k++) {
                            c = p[i - 1] + k * fdur
                            if (!((r[i] SUBSEP k SUBSEP i) in used) && dist(c, slev[s]) < bestd) { best = c; bestd = dist(c, slev[s]); bk = k; bi = i }
                        }
                    }
                    if (best != "") { used[srun[s] SUBSEP bk SUBSEP bi] = 1; printf "%d %.6f\n", srun[s], best }
                }
            }' "$sorted" >> "$sorted"
    fi
    LC_ALL=C sort -k1,1n -k2,2g -u "$sorted" \
    | LC_ALL=C awk -v mode="$mode" -v v0="$v0" -v fdur="$fdur" -v holes="$holes" '
        function num(s,   a) { return (split(s, a, "/") == 2) ? a[1] / a[2] : s + 0 }
        BEGIN { fdur = num(fdur); nh = 0; slot = 0; lost = 0 }
        mode == "h26x" && $1 == 0 && $2 < v0 - 0.000001 { next }
        have && $1 == lrun && $2 - lpts < 0.75 * fdur { next }
        !have { first = $2 }
        have && $1 == lrun && $2 - lpts > 1.5 * fdur {
            gap = $2 - lpts - fdur
            hslot[nh] = slot; hstart[nh] = first + slot * fdur + lost; hgap[nh] = gap; nh++
            lost += gap
        }
        { print $1, slot++, $2; lrun = $1; lpts = $2; have = 1 }
        END {
            for (i = 0; i < nh; i++)
                if (hslot[i] < slot - 16)
                    printf "%.6f %.6f %.0f\n", hstart[i], hstart[i] + hgap[i], hgap[i] * 1000 > holes
        }' > "$out"
    rm -f "$runs" "$strays" "$sorted"
}

# The slot rule. Every audio packet gets the picture slot its PTS names:
#   t   = slot time of the picture at p (+ offset inside it); p in a hole
#         (no picture) or before slot 0 -> the frame is dropped ("d SIZE")
#   k   = last+1 when |t - (last+1)*FD| <= 0.75*FD (a frame continues the
#         run - plain rounding flaps on exact halves), else round(t/FD), an
#         exact half going to the EARLIER slot: Das Erste HD starts its MP2
#         tracks 30.5 frames before frame 0, and the frame 12 ms into the
#         picture belongs on slot 0, not behind a silence frame;
#         k <= last -> dropped; k > last+1 -> that many silence frames ("s N")
#   after the last packet: silence up to the last slot
# Stats count the drops by place: head_dropped (before slot 0), tail_dropped
# (behind the last picture), dropped (in a hole or on a taken slot).
# start_offset_ms (stats) = picture time of the first kept frame minus its
# slot time k*FD: the remainder below one frame the ES cannot express;
# positive = the frame belongs later than the ES plays it.
# Audio runs are matched to video runs by order; when the counts differ, a
# packet takes the first video run whose PTS range contains it. A packet
# with PTS N/A continues the previous packet (prev + FD).
# OUT_SILENCE: "slot_time_s n" per silence insert inside the recording
# (head and tail excluded).
# FRAME_DUR and FD (audio frame duration) may be fractions, see video_slots.
# Args: SLOTS AUDIO_PKT FRAME_DUR FD OUT_PLAN OUT_STATS OUT_SILENCE
plan_audio_slots() {
    local slots=$1 apkt=$2 fdur=$3 fd=$4 plan=$5 stats=$6 sil=$7
    local aruns="$plan.aruns"
    : > "$plan"; : > "$sil"
    LC_ALL=C awk '{ print $1 }' "$apkt" > "$aruns.pts"
    pts_runs "$aruns.pts" "$aruns"
    paste -d' ' "$aruns" <(LC_ALL=C awk '{ print $2 }' "$apkt") \
    | LC_ALL=C awk -v fdur="$fdur" -v fd="$fd" -v plan="$plan" -v stats="$stats" -v sil="$sil" '
        function num(s,   a) { return (split(s, a, "/") == 2) ? a[1] / a[2] : s + 0 }
        BEGIN { fdur = num(fdur); fd = num(fd); nslots = 0; nruns = 0; naruns = 0 }
        FNR == NR {                                   # slots: run slot pts
            r = $1; if (!(r in rfirst)) { rfirst[r] = nslots; nruns = r + 1 }
            rlast[r] = nslots; spts[nslots] = $3; srun[nslots] = r; nslots++
            next
        }
        { na++; apr[na] = $1; app[na] = $2; aps[na] = $3; if ($1 + 1 > naruns) naruns = $1 + 1 }
        END {
            last = -1; kept = 0; dropped = 0; silence = 0; head = 0; taild = 0; prevp = ""
            first_kept_pts = ""; start_off = 0; si = 0
            ptr = 0                                    # moving slot pointer (audio is monotone inside a run)
            for (n = 1; n <= na; n++) {
                p = app[n]; size = aps[n]
                if (p == "N/A") { if (prevp == "") { printf "d %d\n", size > plan; dropped++; continue } ; p = prevp + fd }
                prevp = p
                # video run for this packet
                if (naruns == nruns) vr = apr[n]
                else { vr = -1; for (r = 0; r < nruns; r++) if (p >= spts[rfirst[r]] - 1 && p <= spts[rlast[r]] + 1) { vr = r; break } ; if (vr < 0) vr = 0 }
                if (ptr < rfirst[vr] || ptr > rlast[vr]) ptr = rfirst[vr]
                while (ptr < rlast[vr] && spts[ptr + 1] <= p + 0.000001) ptr++
                while (ptr > rfirst[vr] && spts[ptr] > p + 0.000001) ptr--
                if (p < spts[ptr] - 0.000001 || p >= spts[ptr] + fdur - 0.000001) {
                    printf "d %d\n", size > plan                  # before slot 0 of the run, or in a hole
                    if (last < 0 && vr == 0 && p < spts[0]) head++
                    else if (vr == nruns - 1 && p >= spts[nslots - 1] + fdur - 0.000001) taild++
                    else dropped++
                    continue
                }
                t = ptr * fdur + (p - spts[ptr])
                if (last >= 0 && (t - (last + 1) * fd <= 0.75 * fd) && ((last + 1) * fd - t <= 0.75 * fd)) k = last + 1
                else k = int(t / fd + 0.499999)
                if (k <= last) { printf "d %d\n", size > plan; dropped++; continue }
                if (k > last + 1) {
                    printf "s %d\n", k - last - 1 > plan
                    if (last >= 0) { printf "%.3f %d\n", (last + 1) * fd, k - last - 1 > sil; si++ }
                    silence += k - last - 1
                }
                if (first_kept_pts == "") { first_kept_pts = p; start_off = (t - k * fd) * 1000 }
                printf "k %d\n", size > plan
                last = k; kept++
            }
            tail = int((nslots * fdur) / fd) - (last + 1); if (tail < 0) tail = 0
            if (tail > 0) { printf "s %d\n", tail > plan; silence += tail }
            close(plan); close(sil)
            start_off = (start_off < 0) ? -int(-start_off + 0.5) : int(start_off + 0.5)   # %.0f prints "-0"
            printf "kept=%d dropped=%d silence=%d head_dropped=%d tail_dropped=%d tail_silence=%d first_kept_pts=%s start_offset_ms=%d slots=%d\n", kept, dropped, silence, head, taild, tail, first_kept_pts, start_off, nslots > stats
        }' "$slots" -
    rm -f "$aruns" "$aruns.pts"
}

# Value of KEY in a one-line "key=value key=value" stats file (empty when
# the key is missing). Args: FILE KEY
stats_value() {
    grep -oE "(^| )$2=[^ ]*" "$1" 2>/dev/null | head -1 | cut -d= -f2
}

# audiofix_ranges_to_video_frames JUNK_CSV CRC_CSV FPS
# Takes "IDX@MS:BYTES,..." (junk_regions) and "IDX@MS-IDX@MS,..." or
# "IDX@MS,..." (crc_bad_frames — a single bad frame prints without the
# trailing "-..." part), extracts all ms positions, converts to video
# frames (ms/1000*fps) and clusters with the same <=2s rule as
# corrupt_frame_ranges. Output: "S-E,S-E,...".
audiofix_ranges_to_video_frames() {
    local junk_csv="$1" crc_csv="$2" fps="$3"
    { echo "$junk_csv" | tr ',' '\n' | grep -oP '@\K[0-9]+' ;
      echo "$crc_csv"  | tr ',' '\n' | grep -oP '@\K[0-9]+' ; } |
    sort -n | awk -v fps="$fps" '
        { f = int($1/1000*fps + 0.5); frames[n++] = f }
        END {
            if (n == 0) exit
            gap = 2*fps; s = frames[0]; e = frames[0]; out = ""
            for (i = 1; i < n; i++) {
                if (frames[i] - e <= gap) { e = frames[i] }
                else { out = out (out?",":"") s "-" e; s = frames[i]; e = frames[i] }
            }
            out = out (out?",":"") s "-" e
            print out
        }'
}

# audiofix_report NAME JUNK_CSV CRC_CSV MID_BYTES EDGE_BYTES FPS
# The log lines for one audio track the sanitizer reported on, one per kind
# of finding: junk between frames was removed, a frame with a bad checksum
# stays as it is. One "junk removed" line for both sent the reader looking
# for a cut that is not there, with the size of the partial frames at the
# recording edges as its byte count. Those two frames are no damage and get
# an info line of their own.
audiofix_report() {
    local name="$1" junk_csv="$2" crc_csv="$3" mid_bytes="$4" edge_bytes="$5" fps="$6"
    local junk_ranges crc_ranges
    junk_ranges=$(audiofix_ranges_to_video_frames "$junk_csv" "" "$fps")
    crc_ranges=$(audiofix_ranges_to_video_frames "" "$crc_csv" "$fps")
    if [ -n "$junk_ranges" ]; then
        warn "  $name: junk removed ($mid_bytes bytes) at video frame(s) $(format_ranges_hms "$junk_ranges" "$fps")"
    fi
    if [ -n "$crc_ranges" ]; then
        warn "  $name: bad checksum, frame(s) left untouched, at video frame(s) $(format_ranges_hms "$crc_ranges" "$fps")"
    fi
    if [ -z "$junk_ranges$crc_ranges" ]; then
        info "  $name: structure OK (trimmed $edge_bytes bytes of partial frame at the recording edges)"
    elif [ "$edge_bytes" -gt 0 ]; then
        info "  $name: trimmed $edge_bytes bytes of partial frame at the recording edges"
    fi
}

# format_ranges_hms RANGES FPS
# Render a frame-range CSV ("S-E,S-E,..." — an optional ":MS" suffix per
# range, as in es_missing_ranges, is ignored) human-readable for the log:
# "S-E (~H:MM:SS), ..." with the timestamp of each range start derived
# from the video frame rate. With no usable fps the ranges pass through
# without timestamps — the log line still names the frames.
# Width of the range text itself (the caller's message prefix sits in front of
# the first line) and the indent that marks every continuation line. A badly
# damaged recording produced a single 7189-character line here - unreadable in
# an editor, and it is the caller's last log line that the VDR wrapper puts in
# its progress dialog. Breaks are placed BETWEEN ranges, never inside one, so
# a wrapped list still reads as a list.
RANGES_WRAP_COLS=80
RANGES_WRAP_INDENT="           "

format_ranges_hms() {
    local ranges="$1" fps="$2"
    if ! awk -v f="$fps" 'BEGIN { exit (f+0 > 0) ? 0 : 1 }'; then
        echo "$ranges" | tr ',' '\n' | sed 's/:.*//' | awk -v w="$RANGES_WRAP_COLS" -v ind="$RANGES_WRAP_INDENT" '
            $0 != "" {
                if (n++ == 0) { line = $0; next }
                if (length(line) + 2 + length($0) > w) { out = out line ",\n" ind; line = $0 }
                else { line = line ", " $0 }
            }
            END { if (n) printf "%s%s\n", out, line }'
        return
    fi
    echo "$ranges" | tr ',' '\n' | awk -F'[-:]' -v fps="$fps" \
        -v w="$RANGES_WRAP_COLS" -v ind="$RANGES_WRAP_INDENT" '
        NF >= 2 {
            t = int($1 / fps)
            item = sprintf("%s-%s (~%d:%02d:%02d)", $1, $2,
                           int(t/3600), int((t%3600)/60), t%60)
            if (n++ == 0) { line = item; next }
            if (length(line) + 2 + length(item) > w) {
                out = out line ",\n" ind
                line = item
            } else {
                line = line ", " item
            }
        }
        END { if (n) printf "%s%s\n", out, line }'
}

# True playing time of a raw audio elementary stream, in seconds.
#
# Deliberately NOT ffprobe's format=duration: a raw ES has no container to
# ask, so ffprobe extrapolates the FIRST frame's bitrate across the whole file
# size. One bitrate switch - stereo 192k to 5.1 384k, i.e. the jump between a
# programme and its ad break - and the answer is off by whatever share of the
# file runs at the other rate. Measured on the Tux corpus AC3 (66.9% of frames
# at 192k, 33.1% at 384k): 2391.104s reported against 1797.056s real, +33%.
# That number feeds the drift arithmetic and the repair validation below, so a
# wrong one there discards a good repair or skips a needed pad.
#
# Reading the last packet's timestamp instead costs ~0.17s on a 57MB track
# (against ~0.08s for the wrong answer) and needs no frame duration passed in,
# so a sample-rate change cannot mislead it either. On damaged material it
# stays within a single codec frame of the truth - measured against
# constructed ground truth: junk bytes between frames +24ms, a half-written
# final frame +24ms, a 1000-frame hole exact - three orders of magnitude under
# the 1s tolerance the repair validation works with.
#
# Echoes the duration, or "0" (and returns non-zero) if the track is unreadable.
audio_es_duration() {
    local last
    last=$(ffprobe -v error -select_streams a:0 \
        -show_entries packet=pts_time,duration_time -of csv=p=0 "$1" 2>/dev/null | tail -1)
    if [ -z "$last" ]; then
        echo "0"
        return 1
    fi
    awk -v l="$last" 'BEGIN {
        n = split(l, f, ",")
        if (n < 1 || f[1] == "" || f[1] == "N/A") { print "0"; exit 1 }
        d = (n < 2 || f[2] == "" || f[2] == "N/A") ? 0 : f[2]
        printf "%.6f\n", f[1] + d
    }'
}

# ---- Overall progress for a supervising wrapper ----
#
# A single 0..100 for THIS recording, written to a file the wrapper polls.
# It replaces the wrapper's own guess (bytes written into the output
# directory over 2.2x the input size), which froze for minutes whenever the
# work happened elsewhere and was shown twice, raw in the label and again
# folded into the bar.
#
# The marks are fixed. Up to the A/V check they were spaced by measured
# duration, from a gapless 10.4 GB run on an idle machine (2026-08-26, 63s
# total, before the slot rule replaced gap detection, repair and padding):
# analysis 6s (no mark - several ffprobe calls with nothing to poll), remux
# 8s, ES extraction 8s, PTS analysis 13s, A/V check 6s. Measure on an IDLE
# machine: a parallel transcode stretched the same run to 242s and shifted
# the phases against each other by up to a factor of eight.

PROGRESS_FILE=""
PROGRESS_LAST=-1
PROGRESS_REMUX_END=8            # where the timestamp-repair remux band ends
PROGRESS_PRE_END=40             # everything up to and including the A/V check
PROGRESS_TAIL_BASE=40           # where the tail band starts (set once the A/V check is done)

progress_set() {
    local pct=$1
    [ -n "$PROGRESS_FILE" ] || return 0
    [ "$pct" -gt 100 ] && pct=100
    [ "$pct" -lt 0 ] && pct=0
    # Monotone: never pull the bar backwards, whatever a re-estimate says.
    [ "$pct" -le "$PROGRESS_LAST" ] && return 0
    PROGRESS_LAST=$pct
    printf '%s\n' "$pct" > "$PROGRESS_FILE" 2>/dev/null || true
}

# Map a tenth (0..10) of the band behind the A/V check onto the overall scale.
progress_set_tail() {
    progress_set $(( PROGRESS_TAIL_BASE + (100 - PROGRESS_TAIL_BASE) * $1 / 10 ))
}

# ac3_decode_errors FILE
# Number of error lines of a full decode. "repeat" keeps ffmpeg from folding
# equal lines into one, so the count grows with the damage. The exit status
# of ffmpeg is no measure: it turns non-zero only above an error rate of two
# thirds (measured 2026-10-02: 150 undecodable frames of 250 give 0). The
# input format is named because the repaired copy does not end in ".ac3".
ac3_decode_errors() {
    ffmpeg -nostdin -hide_banner -loglevel repeat+error -f ac3 -i "$1" -f null - 2>&1 | wc -l
}

# repair_ac3_track FILE
# AC3 header repair of one track. ttcut-ac3fix counts stereo headers at a
# 5.1 bitrate, which also fits valid stereo; so the track is repaired only
# when it does not decode cleanly, and replaced only when the repaired copy
# decodes with fewer errors. Every failure leaves the track as it is. Sets
# AC3_FIXED_FRAMES to the number of repaired frames, 0 when nothing changed.
repair_ac3_track() {
    local AUDIO_FILE="$1" NAME OUT RC=0 INCONSISTENT ERRORS_BEFORE ERRORS_AFTER TEMP_FIXED
    NAME=$(basename "$AUDIO_FILE")
    AC3_FIXED_FRAMES=0

    OUT=$(ttcut-ac3fix -a "$AUDIO_FILE" 2>&1) || RC=$?
    if [ "$RC" -ne 0 ]; then
        warn "  $NAME: ttcut-ac3fix analyze failed (rc=$RC), leaving untouched"
        return 0
    fi
    INCONSISTENT=$(echo "$OUT" | grep -oP 'Inconsistent frames:\s+\K[0-9]+' || echo "0")
    if [ "$INCONSISTENT" -eq 0 ]; then
        info "  $NAME: headers OK"
        return 0
    fi

    ERRORS_BEFORE=$(ac3_decode_errors "$AUDIO_FILE")
    if [ "$ERRORS_BEFORE" -eq 0 ]; then
        info "  $NAME: $INCONSISTENT inconsistent headers but decode OK — skipping fix"
        return 0
    fi

    TEMP_FIXED="${AUDIO_FILE}.fixed"
    OUT=$(ttcut-ac3fix -F -f "$AUDIO_FILE" "$TEMP_FIXED" 2>&1) || RC=$?
    if [ "$RC" -ne 0 ] || [ ! -s "$TEMP_FIXED" ]; then
        warn "  $NAME: fix failed (rc=$RC), leaving untouched"
        rm -f "$TEMP_FIXED"
        return 0
    fi

    ERRORS_AFTER=$(ac3_decode_errors "$TEMP_FIXED")
    if [ "$ERRORS_AFTER" -ge "$ERRORS_BEFORE" ]; then
        info "  $NAME: $INCONSISTENT inconsistent headers, repair does not decode better ($ERRORS_BEFORE -> $ERRORS_AFTER errors) — skipping fix"
        rm -f "$TEMP_FIXED"
        return 0
    fi

    mv "$TEMP_FIXED" "$AUDIO_FILE"
    AC3_FIXED_FRAMES=$(echo "$OUT" | grep -oP 'Fixed frames:\s+\K[0-9]+' || echo "$INCONSISTENT")
    info "  $NAME: $AC3_FIXED_FRAMES frames fixed"
    return 0
}

# Parse arguments
ES_MODE=true   # ES demux is the only mode; -e is kept as a no-op for compatibility
AC3FIX=true
OUTPUT_NAME=""
EXPORT_SUBS=false   # subtitle export is opt-in (--subs); default: skip extraction
# Long-option shim: getopts only handles short options, so map the
# documented long forms onto their short equivalents before parsing.
_SHIM_ARGS=()
for _a in "$@"; do
    case "$_a" in
        --subs)    _SHIM_ARGS+=("-s") ;;
        --no-subs) _SHIM_ARGS+=("-S") ;;
        *)         _SHIM_ARGS+=("$_a") ;;
    esac
done
set -- "${_SHIM_ARGS[@]}"
unset _SHIM_ARGS _a
while getopts "ehAsSn:" opt; do
    case $opt in
        e) ES_MODE=true ;;
        A) AC3FIX=false ;;
        s) EXPORT_SUBS=true ;;
        S) EXPORT_SUBS=false ;;
        n) OUTPUT_NAME="$OPTARG" ;;
        h)
            echo "Usage: $0 [-e] [-A] [--subs|--no-subs] [-n name] <input.ts> [output_dir]"
            echo ""
            echo "Demux and normalize H.264/H.265/MPEG-2 TS files for TTCut."
            echo "Similar to ProjectX for MPEG-2."
            echo ""
            echo "Output: video.264/.265/.m2v + audio.mp2/.ac3/.eac3 + info file"
            echo "Filler NALUs are automatically stripped for H.264/H.265."
            echo ""
            echo "Options:"
            echo "  -e  Elementary stream mode (the default; kept for compatibility)"
            echo "  -A  Disable AC3 header repair (enabled by default)"
            echo "      Fixes corrupt acmod field in DVB AC3 streams (stereo->5.1)"
            echo "  --subs / -s     Export subtitle streams (DVB bitmap -> .mks,"
            echo "                  embedded SubRip -> .srt). Default: off."
            echo "  --no-subs / -S  Explicitly disable subtitle export (the default;"
            echo "                  wrappers pass one of the two so runs are explicit)"
            echo "  -n  Set output basename (default: input filename)"
            echo "      Example: -n 'Tatort' → Tatort.264, Tatort_deu.ac3, Tatort.info"
            echo ""
            echo "VDR Integration:"
            echo "  If a 'marks' file exists in the input directory (from vdr-plugin-markad),"
            echo "  the markers are automatically parsed and added to the .info file."
            echo "  See: https://github.com/kfb77/vdr-plugin-markad"
            echo ""
            echo "Examples:"
            echo "  $0 input.ts output_dir/           # Elementary stream output"
            echo "  $0 /video/rec/00001.ts .          # VDR recording (auto-concat splits)"
            echo "  $0 -n Tatort /video/rec/00001.ts  # VDR recording with custom name"
            echo "  $0 -A input.ts output_dir/        # ES without AC3 header repair"
            exit 0
            ;;
        \?) error "Invalid option: -$OPTARG" ;;
    esac
done
shift $((OPTIND-1))

# Check arguments
if [ -z "$1" ]; then
    echo "Usage: $0 [-e] [-A] [--subs|--no-subs] [-n name] <input.ts> [output_dir]"
    echo "Use -h for help."
    exit 1
fi

INPUT="$1"
ORIGINAL_INPUT="$1"  # Save original path before any modifications

# ffmpeg input expression as a bash array. Default for single-file recordings;
# overridden by the VDR multi-file detection block below to use the concat
# demuxer with a list file. ffprobe continues to use $INPUT directly.
declare -a FFMPEG_INPUT_ARGS
FFMPEG_INPUT_ARGS=(-i "$ORIGINAL_INPUT")

# Handle different extensions
BASENAME=$(basename "$INPUT")
BASENAME="${BASENAME%.*}"  # Remove any extension
OUTDIR="${2:-$(dirname "$INPUT")}"

# Check input file exists
[ -f "$INPUT" ] || error "Input file not found: $INPUT"

INPUT_DIR=$(dirname "$INPUT")

#############################################################################
# VDR MULTI-FILE DETECTION
# VDR splits recordings into 2GB segments: 00001.ts, 00002.ts, ...
# Automatically detect siblings and use ffmpeg concat protocol.
#############################################################################
VDR_MULTIFILE=false
VDR_SEGMENTS=()
INPUT_FILENAME=$(basename "$INPUT")

if [[ "$INPUT_FILENAME" =~ ^[0-9]{5}\.ts$ ]]; then
    # VDR >= 1.7.x format: 00001.ts, 00002.ts, ...
    VDR_PATTERN="[0-9][0-9][0-9][0-9][0-9].ts"
elif [[ "$INPUT_FILENAME" =~ ^[0-9]{3}\.vdr$ ]]; then
    # VDR < 1.7.x format: 001.vdr, 002.vdr, ...
    VDR_PATTERN="[0-9][0-9][0-9].vdr"
else
    VDR_PATTERN=""
fi

if [ -n "$VDR_PATTERN" ]; then
    while IFS= read -r -d '' seg; do
        VDR_SEGMENTS+=("$seg")
    done < <(find "$INPUT_DIR" -maxdepth 1 -name "$VDR_PATTERN" -print0 2>/dev/null | sort -z)

    if [ ${#VDR_SEGMENTS[@]} -gt 1 ]; then
        VDR_MULTIFILE=true
        # Build concat protocol string
        CONCAT_STR=""
        TOTAL_SIZE=0
        for seg in "${VDR_SEGMENTS[@]}"; do
            [ -n "$CONCAT_STR" ] && CONCAT_STR="${CONCAT_STR}|"
            CONCAT_STR="${CONCAT_STR}${seg}"
            seg_size=$(stat -c%s "$seg" 2>/dev/null || echo 0)
            TOTAL_SIZE=$((TOTAL_SIZE + seg_size))
        done
        INPUT="concat:${CONCAT_STR}"
        TOTAL_SIZE_GB=$(awk "BEGIN {printf \"%.1f\", $TOTAL_SIZE / 1073741824}")
        info "VDR multi-file recording detected: ${#VDR_SEGMENTS[@]} segments (${TOTAL_SIZE_GB} GB total)"
        for seg in "${VDR_SEGMENTS[@]}"; do
            info "  $(basename "$seg") ($(du -h "$seg" | cut -f1))"
        done
    fi
fi

# If -n was provided, override BASENAME
if [ -n "$OUTPUT_NAME" ]; then
    BASENAME="$OUTPUT_NAME"
fi

# Create output directory if needed
mkdir -p "$OUTDIR"

# Progress file for a supervising wrapper. Registered for cleanup, so it is
# gone when the run ends - including on an abort, which the EXIT trap covers.
PROGRESS_FILE="$OUTDIR/.${BASENAME}.progress"
_CLEANUP_FILES+=("$PROGRESS_FILE")
progress_set 0

# Write concat-demuxer list file for VDR multi-file recordings. ffmpeg's
# concat: protocol mishandles PTS resets at segment boundaries (audio
# packets discarded when DTS appears to go backward); the concat demuxer
# treats each segment as a separate input and stitches them logically,
# surviving PTS resets.
if [ "$VDR_MULTIFILE" = true ]; then
    CONCAT_LIST_FILE="$OUTDIR/.concat_list_$$.txt"
    : > "$CONCAT_LIST_FILE"
    for seg in "${VDR_SEGMENTS[@]}"; do
        # realpath: list file paths must be absolute, otherwise ffmpeg's
        # concat demuxer resolves them relative to the list file's own
        # directory (OUTDIR), not the working directory of ttcut-demux.
        printf "file '%s'\n" "$(realpath "$seg")" >> "$CONCAT_LIST_FILE"
    done
    _CLEANUP_FILES+=("$CONCAT_LIST_FILE")
    FFMPEG_INPUT_ARGS=(-f concat -safe 0 -i "$CONCAT_LIST_FILE")
fi

# Initialize cleanup flag for repaired temp file
CLEANUP_REPAIRED=false

# Check for VDR marks file (markad plugin)
MARKS_FILE=""
VDR_MARKS=()

if [ -f "$INPUT_DIR/marks" ]; then
    MARKS_FILE="$INPUT_DIR/marks"
elif [ -f "$INPUT_DIR/marks.vdr" ]; then
    MARKS_FILE="$INPUT_DIR/marks.vdr"
fi

if [ -n "$MARKS_FILE" ]; then
    info "Found VDR marks file: $MARKS_FILE"

    # Parse marks file
    # Format: H:MM:SS.FF [( FRAME) [*] start|stop method ...]
    while IFS= read -r line || [ -n "$line" ]; do
        # Skip empty lines and comments
        [[ -z "$line" || "$line" =~ ^# ]] && continue

        # Extract timestamp (first field, format H:MM:SS.FF)
        timestamp=$(echo "$line" | grep -oE '^[0-9]+:[0-9]{2}:[0-9]{2}\.[0-9]{2}')
        [ -z "$timestamp" ] && continue

        # Extract frame number if present
        frame=$(echo "$line" | grep -oE '\( *[0-9]+\)' | grep -oE '[0-9]+' | head -1)

        # Determine marker type (start = content starts, stop = content stops/ad starts)
        marker_type="mark"
        if echo "$line" | grep -qi "start"; then
            marker_type="start"  # Content starts (ad ends)
        elif echo "$line" | grep -qi "stop"; then
            marker_type="stop"   # Content stops (ad starts)
        fi

        # Check if verified (has *)
        verified=""
        echo "$line" | grep -q '\*' && verified="*"

        # Store marker: timestamp|frame|type|verified
        VDR_MARKS+=("$timestamp|${frame:-0}|$marker_type|$verified")

    done < "$MARKS_FILE"

    info "  Found ${#VDR_MARKS[@]} markers"
fi

info "Analyzing: $INPUT"
info "Mode: Elementary Stream (for TTCut)"
echo ""

# Get stream information with language tags
VIDEO_STREAM=""
AUDIO_STREAMS=()
SUBTITLE_STREAMS=()
VIDEO_CODEC=""
VIDEO_WIDTH=""
VIDEO_HEIGHT=""
FRAME_RATE=""
TS_AVG_FRAME_RATE=""

# Get video stream info
VIDEO_INFO=$(ffprobe -v error -select_streams v:0 -show_entries stream=index,codec_name,width,height,r_frame_rate,avg_frame_rate -of csv "$INPUT" 2>&1 | grep "^stream," | head -1)
if [ -n "$VIDEO_INFO" ]; then
    IFS=',' read -r _ idx codec_name width height frame_rate avg_rate <<< "$VIDEO_INFO"
    VIDEO_STREAM="$idx"
    VIDEO_CODEC="$codec_name"
    VIDEO_WIDTH="$width"
    VIDEO_HEIGHT="$height"
    FRAME_RATE="$frame_rate"
    TS_AVG_FRAME_RATE="$avg_rate"
    info "Video stream $idx: $codec_name ${width}x${height} @ ${frame_rate}"
fi

# Stream list of one type (a = audio, s = subtitles) as "index:codec:lang"
# entries in the named associative array, keyed by stream index. ffprobe
# lists a stream once per program it belongs to; an entry with a language
# wins over the same index without one.
_collect_streams_by_lang() {
    local selector=$1
    local -n _map=$2
    local _ idx codec_name lang old_lang
    while IFS=',' read -r _ idx codec_name lang; do
        [ -z "$idx" ] && continue
        if [ -n "${_map[$idx]}" ]; then
            old_lang="${_map[$idx]##*:}"
            if [ "$old_lang" = "und" ] && [ -n "$lang" ]; then
                _map[$idx]="$idx:$codec_name:$lang"
            fi
        else
            lang="${lang:-und}"
            _map[$idx]="$idx:$codec_name:$lang"
        fi
    done < <(ffprobe -v error -select_streams "$selector" -show_entries stream=index,codec_name:stream_tags=language -of csv "$INPUT" 2>&1 | grep "^stream,")
}

# Copy an index-keyed stream map into an array sorted by index, one log line
# per stream. Args: MAP_NAME ARRAY_NAME LABEL
_map_to_sorted_array() {
    local -n _src=$1
    local -n _dst=$2
    local label=$3 idx codec lang
    for idx in $(echo "${!_src[@]}" | tr ' ' '\n' | sort -n); do
        _dst+=("${_src[$idx]}")
        IFS=':' read -r _ codec lang <<< "${_src[$idx]}"
        info "$label stream $idx: $codec [$lang]"
    done
}

# Get audio streams with language (deduplicate by index, prefer entries with language)
# shellcheck disable=SC2034  # filled and read by name (nameref) in the two helpers
declare -A AUDIO_MAP
_collect_streams_by_lang a AUDIO_MAP
_map_to_sorted_array AUDIO_MAP AUDIO_STREAMS "Audio"

# Get subtitle streams with language (deduplicate by index, prefer entries with language)
# shellcheck disable=SC2034  # filled and read by name (nameref) in the two helpers
declare -A SUB_MAP
_collect_streams_by_lang s SUB_MAP
_map_to_sorted_array SUB_MAP SUBTITLE_STREAMS "Subtitle"

echo ""

# Check we have video
[ -n "$VIDEO_STREAM" ] || error "No video stream found"

# The audio tracks are placed on the picture timeline by ttcut-audiofix -p
# (slot rule). Without that mode every track would come out as extracted, up
# to a second off the picture - stop before any work is done.
if [ ${#AUDIO_STREAMS[@]} -gt 0 ] && ! { ttcut-audiofix 2>&1 || true; } | grep -q -- '-p <plan>'; then
    error "ttcut-audiofix with the assemble mode (-p) not found in PATH - it places the audio on the picture timeline. Install the ttcut-audiofix that belongs to this ttcut-demux."
fi

# Determine video extension based on codec
case "$VIDEO_CODEC" in
    h264)
        VIDEO_EXT="264"
        info "Video codec: H.264/AVC"
        ;;
    hevc|h265)
        VIDEO_EXT="265"
        info "Video codec: H.265/HEVC"
        ;;
    mpeg2video)
        VIDEO_EXT="m2v"
        info "Video codec: MPEG-2"
        ;;
    *)
        VIDEO_EXT="$VIDEO_CODEC"
        warn "Video codec $VIDEO_CODEC may not be fully supported"
        ;;
esac

# Container start_time of the first stream matching the selector (first
# stream row only: a .ts lists the stream once per program).
_probe_start_time() {
    ffprobe -v error -select_streams "$1" -show_entries stream=start_time -of csv "$2" 2>&1 | grep "^stream," | head -1 | cut -d',' -f2
}

# format=duration of a container, or the given default when ffprobe has
# nothing numeric to say.
_probe_container_duration() {
    ffprobe -v error -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 "$1" 2>/dev/null | grep -E '^[0-9]' || echo "$2"
}

# Smallest (head) or largest (tail) video packet PTS inside a
# -read_intervals window of $INPUT.
_probe_pts_extreme() {
    _ffprobe v:0 -read_intervals "$1" -show_entries packet=pts_time -of csv=p=0 "$INPUT" \
        | tr -d ',' | sort -n | "$2" -1
}

# "pts_time,pict_type" rows of the video frames inside a -read_intervals
# window of $INPUT (the MPEG-2 leading-B probes below all read this).
_probe_frame_types() {
    ffprobe -v error -select_streams v:0 \
        -read_intervals "$1" \
        -show_entries frame=pts_time,pict_type \
        -of csv=p=0 "$INPUT" 2>/dev/null
}

# Get original timestamps and duration for info (from container - fast!)
START_PTS=$(_probe_start_time v:0 "$INPUT")
AUDIO_START_PTS=$(_probe_start_time a:0 "$INPUT")

# Get duration — for VDR multi-file, sum individual segment durations
# (ffprobe with concat protocol only reports first segment's duration)
if [ "$VDR_MULTIFILE" = true ]; then
    CONTAINER_VIDEO_DURATION="0"
    for seg in "${VDR_SEGMENTS[@]}"; do
        seg_dur=$(_probe_container_duration "$seg" "0")
        CONTAINER_VIDEO_DURATION=$(awk "BEGIN {printf \"%.6f\", $CONTAINER_VIDEO_DURATION + $seg_dur}")
    done
    info "Total duration across ${#VDR_SEGMENTS[@]} segments: ${CONTAINER_VIDEO_DURATION}s"
else
    CONTAINER_VIDEO_DURATION=$(_probe_container_duration "$INPUT" "")
    if [ -n "$CONTAINER_VIDEO_DURATION" ]; then
        info "Container duration: ${CONTAINER_VIDEO_DURATION}s"
    fi
fi

info "Original video start time: ${START_PTS:-unknown}s"
info "Original audio start time: ${AUDIO_START_PTS:-unknown}s"
echo ""

#############################################################################
# TIMESTAMP REPAIR (normalize timestamps before demuxing)
# This fixes A/V sync issues similar to ProjectX stream repair
#############################################################################
step "Repairing timestamps (normalizing to start at 0)..."

REPAIRED_INPUT="$OUTDIR/.${BASENAME}_repaired.ts"
_CLEANUP_FILES+=("$REPAIRED_INPUT")

# PTS of frame 0 and of every audio track's first packet, from the original
# (the repaired file below has re-stamped timestamps). The head of each track
# is cut by the slot rule after the extraction: frames before frame 0 are
# dropped, a track that starts later gets leading silence.
ORIG_VIDEO_PTS=$(probe_first_video_pts "$INPUT")
declare -a ORIG_AUDIO_PTS_ARR=()   # first packet PTS per audio track
for i in "${!AUDIO_STREAMS[@]}"; do
    IFS=':' read -r idx codec lang <<< "${AUDIO_STREAMS[$i]}"
    TRACK_PTS=$(_probe_first_packet_pts "$idx" "$INPUT")
    ORIG_AUDIO_PTS_ARR[i]="${TRACK_PTS:-0}"
    info "Audio track $idx ($codec [$lang]) first PTS ${TRACK_PTS:-unknown}s"
done

# Repair timestamps: generate new PTS, ignore corrupt DTS, shift to start at 0
#
# Subtitles AND audio read the pre-repair source - keep its input args here,
# from before $INPUT and $FFMPEG_INPUT_ARGS are repointed at the repaired
# file below.
# Subtitles: the repair remux maps only video+audio (-map 0:v:0 -map 0:a?),
# so the repaired TS carries NO subtitle streams. MEASURED 2026-08-16:
# extracting from the repaired file yielded "empty, skipped" on every
# recording, while the same stream on the original carries hundreds of KB
# per 5 min.
# Audio: the remux (+igndts) stamps the first 5-10 packets of an audio track
# about 140 ms early (measured 2026-10-07, ffmpeg 9.0.2, 4 of 5 Das Erste HD
# recordings), and the slot rule needs the sender's own PTS of every packet.
ORIG_INPUT_ARGS=("${FFMPEG_INPUT_ARGS[@]}")
FFMPEG_LOG="$OUTDIR/.ffmpeg_repair.log"
_CLEANUP_FILES+=("$FFMPEG_LOG")
# This remux is the longest single call of a run without gaps - measured 72s
# on a 10.4 GB recording - and it used to say nothing at all while it ran:
# progress_set 0 stands above it, progress_set 10 only after it returns, so a
# supervising wrapper showed 0% for a third of the whole run. Same treatment
# as the gap repair below: background the call against -progress and map
# out_time_us onto the band. -nostats stays OFF here - the frame=/size= line
# the log parse below picks up is exactly that stats output.
REPAIR_PROGRESS_FILE="$OUTDIR/.ffmpeg_repair.progress"
_CLEANUP_FILES+=("$REPAIR_PROGRESS_FILE")
: > "$REPAIR_PROGRESS_FILE"
ffmpeg -y -v warning -fflags +genpts+igndts "${FFMPEG_INPUT_ARGS[@]}" \
    -c copy \
    -avoid_negative_ts make_zero \
    -progress "$REPAIR_PROGRESS_FILE" \
    -map 0:v:0 -map 0:a? \
    "$REPAIRED_INPUT" > "$FFMPEG_LOG" 2>&1 &
REPAIR_FF_PID=$!
# Against the source duration measured above out_time_us is a fraction of
# the remux, mapped onto the progress range that ends at PROGRESS_REMUX_END.
_report_remux_progress() {
    progress_set "$(awk -v u="$1" -v d="$CONTAINER_VIDEO_DURATION" -v e="$PROGRESS_REMUX_END" \
        'BEGIN { p = (d > 0) ? u / (d * 1000000.0) * e : 0
                 if (p > e) p = e; if (p < 0) p = 0; printf "%d", p }')"
}
_poll_ffmpeg_progress "$REPAIR_FF_PID" "$REPAIR_PROGRESS_FILE" _report_remux_progress
# wait returns the child's exit code, so capture it rather than test wait itself.
REPAIR_FF_RC=0
wait "$REPAIR_FF_PID" || REPAIR_FF_RC=$?
if [ "$REPAIR_FF_RC" -eq 0 ]; then
    # Show progress line
    grep -E "^(frame=|size=)" "$FFMPEG_LOG" | tail -1 | while IFS= read -r line; do info "$line"; done
    # Show any warnings/errors from ffmpeg. A recording is cut off mid-packet
    # at both ends, so ffmpeg reports that partial packet on nearly every one;
    # when that is all there is, say so once instead of warning three times.
    if ffmpeg_audio_corruption_is_edge_only "$FFMPEG_LOG" "${START_PTS:-}" "${CONTAINER_VIDEO_DURATION:-}"; then
        warn_ffmpeg_log "$FFMPEG_LOG" "" "$FFMPEG_PACKET_CORRUPT_PATTERN"
        info "Audio: partial packet at the recording edge (normal, recording cut mid-packet)"
    else
        warn_ffmpeg_log "$FFMPEG_LOG"
    fi
    # Preserve "Packet corrupt (stream = 0, dts = N)" markers for
    # corrupt_frame_ranges= (.info emission, later) before the log is
    # deleted below. This whole-TS remux pass is where the damaged region
    # is first parsed, so it is the primary source for this marker; the
    # ES extraction pass below merges in anything additional it sees.
    VIDEO_CORRUPT_DTS_TICKS=$(grep -oE 'Packet corrupt \(stream = 0, dts = [0-9]+' \
        "$FFMPEG_LOG" 2>/dev/null | grep -oE '[0-9]+$' || true)
    rm -f "$FFMPEG_LOG"

    # Verify repaired file
    if [ -s "$REPAIRED_INPUT" ]; then
        NEW_VIDEO_PTS=$(_probe_start_time v:0 "$REPAIRED_INPUT")
        NEW_AUDIO_PTS=$(_probe_start_time a:0 "$REPAIRED_INPUT")
        info "Repaired video start time: ${NEW_VIDEO_PTS:-0}s"
        info "Repaired audio start time: ${NEW_AUDIO_PTS:-0}s"

        # Use repaired file for demuxing. Update both $INPUT (for ffprobe
        # paths) and $FFMPEG_INPUT_ARGS (for ffmpeg paths) — the repaired
        # file is a single TS with clean PTS, so the concat-demuxer setup
        # for multi-file recordings is no longer needed past this point.
        INPUT="$REPAIRED_INPUT"
        FFMPEG_INPUT_ARGS=(-i "$REPAIRED_INPUT")
        CLEANUP_REPAIRED=true
    else
        warn "Timestamp repair failed, using original file"
        CLEANUP_REPAIRED=false
    fi
else
    # Show ffmpeg errors
    warn_ffmpeg_log "$FFMPEG_LOG"
    rm -f "$FFMPEG_LOG"
    warn "Timestamp repair failed, using original file"
    CLEANUP_REPAIRED=false
fi
echo ""

#############################################################################
# ELEMENTARY STREAM MODE
#############################################################################
if $ES_MODE; then
    progress_set 8
    step "Extracting Elementary Streams..."

    # Detect available CPU cores for parallel processing
    NPROC=$(nproc 2>/dev/null || echo 4)
    info "Using up to $NPROC parallel processes"
    echo ""

    # Note: video and audio are extracted as they are; the audio tracks are
    # placed on the picture timeline afterwards (slot rule below).

    # 1. Prepare video extraction parameters
    OUTPUT_VIDEO="$OUTDIR/${BASENAME}.${VIDEO_EXT}"

    # For MPEG-2: Find first I-frame time to skip initial B-frames (like ProjectX)
    # This removes "überflüssige B-Frames" before the first GOP
    VIDEO_START_TIME="0"
    if [ "$VIDEO_CODEC" = "mpeg2video" ]; then
        # Find the PTS of the first I-frame (picture type 1)
        # Use -read_intervals to only analyze first 10 seconds (MUCH faster!)
        FIRST_I_PTS=$(_probe_frame_types "%+10" | grep ",I$" | head -1 | cut -d',' -f1)

        if [ -n "$FIRST_I_PTS" ] && [ "$FIRST_I_PTS" != "0" ]; then
            # Check if first frame is NOT an I-frame (i.e., there are leading B-frames)
            FIRST_FRAME_TYPE=$(_probe_frame_types "%+1" | head -1 | cut -d',' -f2)

            if [ "$FIRST_FRAME_TYPE" != "I" ]; then
                # Count B-frames before first I-frame (only need first 2 seconds)
                B_FRAME_COUNT=$(_probe_frame_types "%+2" | \
                    awk -F',' 'BEGIN{count=0} $2=="I"{exit} $2=="B"{count++} END{print count}')

                VIDEO_START_TIME="$FIRST_I_PTS"
                SKIPPED_MS=$(awk "BEGIN {printf \"%.0f\", $FIRST_I_PTS * 1000}")
                info "  Skipping $B_FRAME_COUNT initial B-frame(s) (${SKIPPED_MS}ms) before first I-frame"
            fi
        fi
    fi

    # 2. Prepare audio extraction parameters (before parallel extraction)
    AUDIO_FILES=()
    declare -A LANG_COUNT  # Track how many times each language appears
    declare -a AUDIO_EXTRACT_MAPS=()    # Stream map index

    if [ ${#AUDIO_STREAMS[@]} -gt 0 ]; then
        for i in "${!AUDIO_STREAMS[@]}"; do
            IFS=':' read -r idx codec lang <<< "${AUDIO_STREAMS[$i]}"

            # Determine extension
            EXT=$(audio_ext_for_codec "$codec")

            # Include language in filename
            # If same language+extension appears multiple times, add index
            OUTPUT_AUDIO="$OUTDIR/${BASENAME}_${lang}.${EXT}"
            lang_ext_key="${lang}_${EXT}"
            if [ "${LANG_COUNT[$lang_ext_key]:-0}" -gt 0 ]; then
                OUTPUT_AUDIO="$OUTDIR/${BASENAME}_${lang}_${LANG_COUNT[$lang_ext_key]}.${EXT}"
            fi
            LANG_COUNT[$lang_ext_key]=$((${LANG_COUNT[$lang_ext_key]:-0} + 1))

            AUDIO_FILES+=("$OUTPUT_AUDIO")

            # Every track is extracted whole from the ORIGINAL (see
            # ORIG_INPUT_ARGS): the file is the track's packet list in
            # order, head and holes are handled by the slot rule below.
            # -ss is no usable trim: on a single file it counts from the
            # track's own first packet, on the concat input of a recording
            # in several files from the earliest stream (measured
            # 2026-10-07).
            AUDIO_EXTRACT_MAPS+=("$idx")
        done
    fi

    #############################################################################
    # PARALLEL EXTRACTION: Video + All Audio Tracks simultaneously
    #############################################################################
    step "Extracting video + ${#AUDIO_STREAMS[@]} audio track(s) in parallel..."

    # Create a temporary directory for extraction logs
    EXTRACT_LOG_DIR="$OUTDIR/.extract_logs_$$"
    mkdir -p "$EXTRACT_LOG_DIR"
    _CLEANUP_DIRS+=("$EXTRACT_LOG_DIR")

    # Start video extraction in background
    info "  Video -> $OUTPUT_VIDEO"
    (
        case "$VIDEO_CODEC" in
            h264|hevc|h265)
                # Annex-B ES with the filler NALUs stripped (type 12 for
                # H.264, 38 for HEVC).
                if [ "$VIDEO_CODEC" = "h264" ]; then
                    ES_BSF="h264_mp4toannexb,filter_units=remove_types=12"; ES_FMT="h264"
                else
                    ES_BSF="hevc_mp4toannexb,filter_units=remove_types=38"; ES_FMT="hevc"
                fi
                ffmpeg -y "${FFMPEG_INPUT_ARGS[@]}" \
                    -map "0:$VIDEO_STREAM" \
                    -c:v copy \
                    -bsf:v "$ES_BSF" \
                    -f "$ES_FMT" \
                    "$OUTPUT_VIDEO" 2>&1
                ;;
            mpeg2video)
                declare -a FFMPEG_ARGS=()
                if [ "$VIDEO_START_TIME" != "0" ]; then
                    FFMPEG_ARGS+=("-ss" "$VIDEO_START_TIME")
                fi
                ffmpeg -y "${FFMPEG_ARGS[@]}" "${FFMPEG_INPUT_ARGS[@]}" \
                    -map "0:$VIDEO_STREAM" \
                    -c:v copy \
                    -f mpeg2video \
                    "$OUTPUT_VIDEO" 2>&1
                ;;
            *)
                ffmpeg -y "${FFMPEG_INPUT_ARGS[@]}" \
                    -map "0:$VIDEO_STREAM" \
                    -c:v copy \
                    "$OUTPUT_VIDEO" 2>&1
                ;;
        esac
    ) > "$EXTRACT_LOG_DIR/video.log" 2>&1 &
    VIDEO_PID=$!

    # Start all audio extractions in parallel
    AUDIO_PIDS=()
    for i in "${!AUDIO_STREAMS[@]}"; do
        IFS=':' read -r idx codec lang <<< "${AUDIO_STREAMS[$i]}"
        info "  Audio $idx [$lang] -> $(basename "${AUDIO_FILES[$i]}")"

        # Run each audio extraction in background (direct invocation, no eval)
        ffmpeg -y "${ORIG_INPUT_ARGS[@]}" \
            -map "0:${AUDIO_EXTRACT_MAPS[$i]}" -c:a copy \
            "${AUDIO_FILES[$i]}" > "$EXTRACT_LOG_DIR/audio_$i.log" 2>&1 &
        AUDIO_PIDS+=($!)
    done

    # Wait for all extractions to complete
    info "  Waiting for parallel extraction to complete..."

    # Wait for video
    wait $VIDEO_PID
    VIDEO_EXIT=$?
    if [ $VIDEO_EXIT -eq 0 ]; then
        # MPEG-2: Truncate trailing null bytes from ES file.
        # ffmpeg stream-copy from TS extracts zero-stuffed PES payload,
        # leaving invalid null padding that has no MPEG-2 start codes.
        if [ "$VIDEO_CODEC" = "mpeg2video" ]; then
            TRAILING=$(python3 -c "
import os
with open('$OUTPUT_VIDEO','rb') as f:
    sz=os.fstat(f.fileno()).st_size
    n=0; f.seek(sz-1)
    while n<sz:
        if f.read(1)!=b'\x00': break
        n+=1; f.seek(sz-n-1)
    print(n)" 2>/dev/null || echo 0)
            if [ "$TRAILING" -gt 0 ]; then
                ORIG_SIZE=$(stat -c%s "$OUTPUT_VIDEO")
                TRUNC_SIZE=$((ORIG_SIZE - TRAILING))
                truncate -s "$TRUNC_SIZE" "$OUTPUT_VIDEO"
                info "  Truncated $TRAILING trailing null bytes from MPEG-2 ES"
            fi
        fi
        VIDEO_SIZE=$(stat -c%s "$OUTPUT_VIDEO" 2>/dev/null || echo 0)
        info "  Video done: $(numfmt --to=iec "$VIDEO_SIZE")"
    else
        warn "  Video extraction failed (exit code: $VIDEO_EXIT)"
        warn_ffmpeg_log "$EXTRACT_LOG_DIR/video.log" "  "
        VIDEO_SIZE=$(stat -c%s "$OUTPUT_VIDEO" 2>/dev/null || echo 0)
    fi

    # Wait for all audio extractions
    AUDIO_ERRORS=0
    for i in "${!AUDIO_PIDS[@]}"; do
        if ! wait "${AUDIO_PIDS[$i]}"; then
            ((AUDIO_ERRORS++))
            warn "  Audio $i extraction failed"
            warn_ffmpeg_log "$EXTRACT_LOG_DIR/audio_$i.log" "  "
        fi
    done

    if [ $AUDIO_ERRORS -gt 0 ]; then
        warn "  $AUDIO_ERRORS audio extraction(s) had issues"
    else
        info "  All ${#AUDIO_FILES[@]} audio track(s) extracted"
    fi

    # Merge in any "Packet corrupt" markers also seen during the per-track
    # extraction pass (in practice these come from the timestamp-repair log
    # captured above, since that pass re-muxes the whole TS and hits the
    # damaged region first; capturing here too costs nothing and covers the
    # case where extraction re-triggers the same parser warning).
    VIDEO_CORRUPT_DTS_TICKS="${VIDEO_CORRUPT_DTS_TICKS:-}"$'\n'"$(grep -oE 'Packet corrupt \(stream = 0, dts = [0-9]+' \
        "$EXTRACT_LOG_DIR/video.log" 2>/dev/null | grep -oE '[0-9]+$' || true)"

    # Clean up log directory
    rm -rf "$EXTRACT_LOG_DIR"
    echo ""

    # Parse frame rate fraction (e.g., "25/1" or "30000/1001")
    _parse_fraction "$FRAME_RATE" FRAME_RATE_NUM FRAME_RATE_DEN

    # Interlaced material: the TS may report the field rate as r_frame_rate
    # (1080i25 PAFF: 50/1); video_frame_rate halves it against the TS
    # avg_frame_rate. field_order comes from the extracted ES. Runs before
    # the slot rule, which works in frame durations.
    if $ES_MODE; then
        FIELD_ORDER=$(_probe_field v:0 stream=field_order "$OUTPUT_VIDEO")
        if [[ -n "$FIELD_ORDER" && "$FIELD_ORDER" != "progressive" && "$FIELD_ORDER" != "unknown" ]]; then
            # shellcheck disable=SC2153  # FRAME_RATE_DEN is assigned through _parse_fraction's nameref
            ORIG_RATE="$FRAME_RATE_NUM/$FRAME_RATE_DEN"
            FRAME_RATE=$(video_frame_rate "$ORIG_RATE" "$TS_AVG_FRAME_RATE" "$FIELD_ORDER")
            _parse_fraction "$FRAME_RATE" FRAME_RATE_NUM FRAME_RATE_DEN
            if [[ "$FRAME_RATE" != "$ORIG_RATE" ]]; then
                info "  Interlaced ($FIELD_ORDER): corrected field rate $ORIG_RATE to frame rate $FRAME_RATE"
            else
                info "  Interlaced ($FIELD_ORDER): r_frame_rate=$ORIG_RATE is already frame rate (TS avg_frame_rate=$TS_AVG_FRAME_RATE)"
            fi
        fi
    fi

    # Frame rate as a decimal for awk arithmetic (all later sections).
    FRAME_RATE_DEC=$(awk "BEGIN {printf \"%.6f\", $FRAME_RATE_NUM / $FRAME_RATE_DEN}")

    #########################################################################
    # SLOT RULE: every audio frame on the picture slot its PTS names
    # (design 2026-10-07; replaces the head trim, the disturbance-zone
    # balance and the end padding). One ffprobe pass per segment of the
    # ORIGINAL gives the packet lists - video: PTS and key flag, audio: PTS
    # and size; the extracted audio file is exactly that list of packets in
    # order. plan_audio_slots decides keep / drop / silence per packet,
    # ttcut-audiofix -p assembles the ES from the plan.
    #########################################################################
    progress_set 10
    step "Placing audio frames on the picture timeline..."
    SLOT_DIR="$OUTDIR/.slots_$$"
    mkdir -p "$SLOT_DIR"
    _CLEANUP_DIRS+=("$SLOT_DIR")
    if [ "$VDR_MULTIFILE" = true ]; then
        SLOT_SEGMENTS=("${VDR_SEGMENTS[@]}")
    else
        SLOT_SEGMENTS=("$ORIGINAL_INPUT")
    fi
    # Durations go to the slot functions as fractions: 1001/30000 or
    # 1152/44100 have no finite decimal, and six places drift by an audio
    # frame within 23 minutes.
    SLOT_FRAME_DUR="$FRAME_RATE_DEN/$FRAME_RATE_NUM"

    # csv row of the probe: stream_index,pts_time,size,flags
    VIDEO_PKT_FILE="$SLOT_DIR/video.pkt"          # "pts flags" per video packet
    : > "$VIDEO_PKT_FILE"
    SLOT_AUDIO_MAP=""                             # "streamindex:track ..." for the splitter
    for i in "${!AUDIO_STREAMS[@]}"; do
        : > "$SLOT_DIR/a$i.pkt"                   # "pts size" per audio packet
        SLOT_AUDIO_MAP="$SLOT_AUDIO_MAP ${AUDIO_STREAMS[$i]%%:*}:$i"
    done
    for seg in "${SLOT_SEGMENTS[@]}"; do
        ffprobe -v error -show_entries packet=stream_index,pts_time,size,flags -of csv=p=0 "$seg" 2>/dev/null \
        | LC_ALL=C awk -F, -v vidx="$VIDEO_STREAM" -v amap="$SLOT_AUDIO_MAP" -v dir="$SLOT_DIR" '
            BEGIN { n = split(amap, m, " ")
                    for (k = 1; k <= n; k++) { split(m[k], kv, ":"); out[kv[1]] = dir "/a" kv[2] ".pkt" } }
            $1 == vidx  { print $2, $4 >> (dir "/video.pkt"); next }
            ($1 in out) { print $2, $3 >> out[$1] }' || true
    done

    # Frame 0. H.264/H.265: the first packet, what is displayed before it is
    # dropped (mode h26x). MPEG-2: the smallest PTS, nothing is dropped (mode
    # mpeg2). MPEG-2 with the leading-B skip: the video ES starts at the
    # first I picture and holds nothing displayed before it, so the list
    # starts at the first key packet and is treated like the H.26x case.
    SLOT_V0_ARG="$ORIG_VIDEO_PTS"
    case "$VIDEO_CODEC" in h264|hevc|h265) SLOT_MODE=h26x ;; *) SLOT_MODE=mpeg2 ;; esac
    if [ "$VIDEO_START_TIME" != "0" ]; then
        awk 'f || $2 ~ /^K/ { f = 1; print }' "$VIDEO_PKT_FILE" > "$VIDEO_PKT_FILE.cut" \
            && mv "$VIDEO_PKT_FILE.cut" "$VIDEO_PKT_FILE"
        SLOT_V0_ARG=$(awk '$1 != "N/A" { print $1; exit }' "$VIDEO_PKT_FILE")
        SLOT_MODE=h26x
    fi
    VIDEO_PTS_FILE="$SLOT_DIR/video.pts"
    VIDEO_GAPS_FILE="$SLOT_DIR/holes"                 # picture holes, read by the es_missing_* emission
    cut -d' ' -f1 "$VIDEO_PKT_FILE" > "$VIDEO_PTS_FILE"
    SLOTS_FILE="$SLOT_DIR/slots"
    video_slots "$VIDEO_PTS_FILE" "$SLOT_MODE" "$SLOT_V0_ARG" "$SLOT_FRAME_DUR" "$SLOTS_FILE" "$VIDEO_GAPS_FILE"
    SLOT_COUNT=$(grep -c . "$SLOTS_FILE" || true)
    SLOT_V0=$(awk 'NR == 1 { print $3 }' "$SLOTS_FILE")       # PTS of frame 0
    SLOT_RUNS=$(awk 'END { print (NR > 0) ? $1 + 1 : 0 }' "$SLOTS_FILE")

    declare -A TRACK_SILENCE_MS TRACK_REMOVED_MS TRACK_HEAD_MS TRACK_START_OFFSET_MS SLOT_TRACK_OF_PID
    AUDIO_SILENCE_POS_FILE="$SLOT_DIR/silence.pos"   # "slot_time_s n" of every track, for audio_gap_frames
    : > "$AUDIO_SILENCE_POS_FILE"
    SLOT_TRACKS_PLACED=0
    SLOT_PIDS=()
    if [ "${SLOT_COUNT:-0}" -eq 0 ]; then
        warn "  No video packet timestamps in the source - audio tracks are left as extracted (NOT aligned to the picture)"
    else
        SLOT_RUN_NOTE=""
        [ "$SLOT_RUNS" -gt 1 ] && SLOT_RUN_NOTE=", $SLOT_RUNS timestamp runs"
        info "  Picture slots: $SLOT_COUNT (frame 0 at PTS ${SLOT_V0}s, $SLOT_MODE$SLOT_RUN_NOTE)"
        for i in "${!AUDIO_FILES[@]}"; do
            IFS=':' read -r idx codec lang <<< "${AUDIO_STREAMS[$i]}"
            AF="${AUDIO_FILES[$i]}"
            # Samples per frame. E-AC3 is taken as 6 blocks per frame, the
            # form DVB transmits.
            case "$codec" in
                mp2)       FD_SAMPLES=1152 ;;
                ac3|eac3)  FD_SAMPLES=1536 ;;
                *) warn "  $(basename "$AF"): $codec has no known frame length - left as extracted (NOT aligned to the picture)"; continue ;;
            esac
            (
                APKT="$SLOT_DIR/a$i.pkt"
                # The plan addresses the file by packet sizes; they must
                # add up to the file, or every later frame would be read
                # from the wrong place.
                PKT_BYTES=$(awk '{ s += $2 } END { printf "%d", s }' "$APKT")
                ES_BYTES=$(stat -c%s "$AF" 2>/dev/null || echo 0)
                if [ "$PKT_BYTES" != "$ES_BYTES" ]; then
                    echo "packet list ($PKT_BYTES bytes) and extracted file ($ES_BYTES bytes) differ"
                    exit 1
                fi
                probe_audio_props "$AF"
                SR="${APROBE_SAMPLE_RATE:-48000}"
                plan_audio_slots "$SLOTS_FILE" "$APKT" "$SLOT_FRAME_DUR" "$FD_SAMPLES/$SR" \
                    "$SLOT_DIR/a$i.plan" "$SLOT_DIR/a$i.stats" "$SLOT_DIR/a$i.sil"
                # Silence in the track's own format; -p takes the first frame.
                sil_layout="${APROBE_CHANNELS:-2}c"
                [ -n "$APROBE_CHANNEL_LAYOUT" ] && sil_layout="$APROBE_CHANNEL_LAYOUT"
                SIL_FILE="$SLOT_DIR/a$i.silence.${AF##*.}"
                ffmpeg -y -hide_banner -loglevel error -f lavfi -t 1 \
                    -i "anullsrc=r=${SR}:cl=${sil_layout}" \
                    -c:a "$codec" -b:a "${APROBE_BITRATE:-192000}" "$SIL_FILE" || exit 1
                ttcut-audiofix -p "$SLOT_DIR/a$i.plan" -s "$SIL_FILE" "$AF" "$AF.placed" \
                    > "$SLOT_DIR/a$i.asm" || exit 1
                awk -v s="$FD_SAMPLES" -v r="$SR" 'BEGIN {printf "%.3f\n", s * 1000 / r}' > "$SLOT_DIR/a$i.fd_ms"
                mv "$AF.placed" "$AF"
            ) > "$SLOT_DIR/a$i.log" 2>&1 &
            SLOT_PIDS+=($!)
            SLOT_TRACK_OF_PID[${SLOT_PIDS[-1]}]=$i
        done
    fi
    frames_ms() { awk -v n="$1" -v f="$FD_MS" 'BEGIN {printf "%.0f", n * f}'; }   # frames of this track -> ms
    for pid in "${SLOT_PIDS[@]}"; do
        i=${SLOT_TRACK_OF_PID[$pid]}
        AF="${AUDIO_FILES[$i]}"
        IFS=':' read -r idx codec lang <<< "${AUDIO_STREAMS[$i]}"
        if ! wait "$pid"; then
            warn "  $(basename "$AF"): placement failed - left as extracted (NOT aligned to the picture)"
            while IFS= read -r line; do warn "    $line"; done < <(tail -3 "$SLOT_DIR/a$i.log" 2>/dev/null)
            rm -f "$AF.placed"
            continue
        fi
        SLOT_TRACKS_PLACED=$((SLOT_TRACKS_PLACED + 1))
        ST="$SLOT_DIR/a$i.stats"
        S_KEPT=$(stats_value "$ST" kept);            S_DROPPED=$(stats_value "$ST" dropped)
        S_SILENCE=$(stats_value "$ST" silence);      S_HEAD=$(stats_value "$ST" head_dropped)
        S_TAIL_DROPPED=$(stats_value "$ST" tail_dropped); S_TAIL_SILENCE=$(stats_value "$ST" tail_silence)
        S_FIRST_PTS=$(stats_value "$ST" first_kept_pts); S_OFFSET=$(stats_value "$ST" start_offset_ms)
        S_REPLACED=$(stats_value "$SLOT_DIR/a$i.asm" replaced); S_SHORT=$(stats_value "$SLOT_DIR/a$i.asm" short)
        S_TAIL_BYTES=$(stats_value "$SLOT_DIR/a$i.asm" tail_bytes)
        FD_MS=$(cat "$SLOT_DIR/a$i.fd_ms")
        TRACK_HEAD_MS[$i]=$(frames_ms "$S_HEAD")
        TRACK_REMOVED_MS[$i]=$(frames_ms "$S_DROPPED")
        TRACK_SILENCE_MS[$i]=$(frames_ms "$S_SILENCE")
        cat "$SLOT_DIR/a$i.sil" >> "$AUDIO_SILENCE_POS_FILE"
        info "  $(basename "$AF"): $S_KEPT frames kept; head -$S_HEAD (${TRACK_HEAD_MS[$i]} ms), in picture holes -$S_DROPPED (${TRACK_REMOVED_MS[$i]} ms), behind the last picture -$S_TAIL_DROPPED; silence +$S_SILENCE (${TRACK_SILENCE_MS[$i]} ms, of which tail $S_TAIL_SILENCE)"
        if [ "$((S_REPLACED + S_SHORT))" -gt 0 ] || [ "${S_TAIL_BYTES:-0}" -gt 0 ]; then
            info "    $((S_REPLACED + S_SHORT)) packet(s) were no whole frame (partial frame at a recording edge, or damage) - their slots hold silence"
        fi

        # Start offset = the remainder below one frame between the first kept
        # frame and its slot. Written only when the finished file proves the
        # plan: the first frame ttcut-audiofix COPIED (a partial first packet
        # is replaced by silence and proves nothing) must be the source
        # packet with that index and PTS - same MD5.
        COPY_PKT=$(stats_value "$SLOT_DIR/a$i.asm" first_copy_packet)
        COPY_OFF=$(stats_value "$SLOT_DIR/a$i.asm" first_copy_offset)
        if [ -n "$S_FIRST_PTS" ]; then
            ES_MD5=""; PKT_ROW=""; C_PTS=""; C_SIZE=""
            if [ "${COPY_PKT:--1}" -ge 0 ] && [ "$COPY_PKT" -lt 20000 ]; then
                read -r C_PTS C_SIZE < <(sed -n "$((COPY_PKT + 1))p" "$SLOT_DIR/a$i.pkt") || true
            fi
            if [ -n "$C_SIZE" ]; then
                ES_MD5=$(tail -c +$(( COPY_OFF + 1 )) "$AF" | head -c "$C_SIZE" | md5sum | cut -d' ' -f1)
                PKT_ROW=$(_ffprobe "$idx" -read_intervals "%+#$((COPY_PKT + 1))" -show_data_hash md5 \
                    -show_entries packet=pts_time,data_hash -of csv=p=0 "${SLOT_SEGMENTS[0]}" | tail -1)
            fi
            if [ -n "$ES_MD5" ] && [ "$PKT_ROW" = "$C_PTS,MD5:$ES_MD5," ]; then
                TRACK_START_OFFSET_MS[$i]="$S_OFFSET"
                info "    start offset ${S_OFFSET} ms (verified on the frame with PTS ${C_PTS}s)"
            else
                warn "    first copied frame does not match its source packet - audio_${i}_start_offset_ms not written"
            fi
        fi
    done
    echo ""

    #########################################################################
    # PTS ANALYSIS
    # Detect extra frames in elementary streams via PTS comparison.
    # Uses ttcut-pts-analyze (replaces ttcut-esrepair).
    #########################################################################
    ES_TOTAL_AUS=""
    ES_DOUBLED_PTS_CSV=""
    if command -v ttcut-pts-analyze >/dev/null 2>&1; then
        progress_set 16
        step "Running PTS analysis on $ORIGINAL_INPUT ..."
        # stderr goes to its own log: mixing it into stdout (old 2>&1)
        # raced the block-buffered CSV line and truncated the captured
        # list mid-stream (measured: 731 of 1296 entries + garbage).
        PTS_STDERR_LOG="$OUTDIR/.pts_analyze.log"
        _CLEANUP_FILES+=("$PTS_STDERR_LOG")
        set +e
        PTS_OUTPUT=$(ttcut-pts-analyze --verbose "$ORIGINAL_INPUT" 2>"$PTS_STDERR_LOG")
        PTS_EXIT=$?
        set -e

        ES_TOTAL_AUS=$(echo "$PTS_OUTPUT" | grep -oP '^total_aus=\K[0-9]+' || true)
        if [ "$PTS_EXIT" -eq 1 ]; then
            ES_DOUBLED_PTS_CSV=$(echo "$PTS_OUTPUT" | grep -oP '^doubled_pts_aus=\K.*' || true)
            if [ -n "$ES_DOUBLED_PTS_CSV" ]; then
                count=$(echo "$ES_DOUBLED_PTS_CSV" | tr ',' '\n' | wc -l)
                warn "PTS analysis: $count AUs with doubled PTS detected (field-picture pairs or TS corruption)"
            fi
        elif [ "$PTS_EXIT" -eq 2 ]; then
            warn "PTS analysis failed (exit 2)"
        fi
        rm -f "$PTS_STDERR_LOG"
    else
        warn "ttcut-pts-analyze not found, skipping PTS analysis"
    fi

    #########################################################################
    # AC3 HEADER REPAIR
    # Fix corrupt acmod field in DVB AC3 streams (stereo header + 384kbps)
    #########################################################################
    declare -A AC3_FIX_RESULTS  # Track fix results per audio file index
    if $AC3FIX && [ ${#AUDIO_FILES[@]} -gt 0 ]; then
        HAS_AC3=false
        for af in "${AUDIO_FILES[@]}"; do
            [[ "$af" == *.ac3 ]] && HAS_AC3=true && break
        done

        if $HAS_AC3; then
            if command -v ttcut-ac3fix &>/dev/null; then
                step "Checking AC3 headers..."

                for i in "${!AUDIO_FILES[@]}"; do
                    AUDIO_FILE="${AUDIO_FILES[$i]}"
                    [[ "$AUDIO_FILE" != *.ac3 ]] && continue
                    repair_ac3_track "$AUDIO_FILE"
                    if [ "$AC3_FIXED_FRAMES" -gt 0 ]; then
                        AC3_FIX_RESULTS[$i]="$AC3_FIXED_FRAMES"
                    fi
                done
                echo ""
            else
                warn "ttcut-ac3fix not found in PATH, skipping AC3 header repair"
                echo ""
            fi
        fi
    fi

    # Filler NALUs are stripped automatically during extraction via ffmpeg
    # bitstream filter (filter_units=remove_types=12 for H.264, =38 for HEVC)
    if [ "$VIDEO_CODEC" = "h264" ] || [ "$VIDEO_CODEC" = "hevc" ] || [ "$VIDEO_CODEC" = "h265" ]; then
        FILLER_STRIPPED=true
    else
        FILLER_STRIPPED=false
    fi

    # 2b. Check A/V duration mismatch (like ProjectX does)
    # This detects progressive drift that occurs when audio and video have
    # different durations. The step announcement is printed further below,
    # right before the duration measurement — the interlace correction and
    # the audio ES sanitize run first and report under their own headings.

    # (The frame rate is parsed, and halved for interlaced material, right
    # after the extraction - the slot rule needs it. FRAME_RATE_DEC too.)

    #########################################################################
    # AUDIO ES SANITIZE (ttcut-audiofix)
    # Walk each audio ES frame by frame: drop junk bytes between valid
    # frames, report CRC-damaged frames. Runs on the PLACED files (slot rule
    # above), so the positions it reports are positions in the final ES; the
    # partial frames at the recording edges are already gone there. Runs
    # after the interlace field/frame-rate correction, so the ms->video-frame
    # conversion for audio_${i}_corrupt_ranges uses the corrected frame rate.
    # Any tool failure leaves the file untouched.
    #########################################################################
    declare -A AUDIOFIX_CORRUPT_RANGES AUDIOFIX_JUNK_BYTES AUDIOFIX_DROPPED
    if [ ${#AUDIO_FILES[@]} -gt 0 ]; then
        step "Checking audio ES structure..."
        for i in "${!AUDIO_FILES[@]}"; do
            AF="${AUDIO_FILES[$i]}"
            case "$AF" in *.mp2|*.ac3|*.eac3) ;; *) continue ;; esac
            set +e
            AFIX_OUT=$(ttcut-audiofix -a "$AF" 2>/dev/null)
            AFIX_RC=$?
            set -e
            if [ "$AFIX_RC" -eq 0 ]; then
                info "  $(basename "$AF"): structure OK"
                continue
            elif [ "$AFIX_RC" -ge 2 ]; then
                warn "  $(basename "$AF"): ttcut-audiofix analyze failed (rc=$AFIX_RC), leaving untouched"
                continue
            fi
            TEMP_FIXED="${AF}.sanitized"
            set +e
            ttcut-audiofix -f "$AF" "$TEMP_FIXED" >/dev/null 2>&1
            FIX_RC=$?
            set -e
            if [ "$FIX_RC" -le 1 ] && [ -s "$TEMP_FIXED" ]; then
                mv "$TEMP_FIXED" "$AF"
                JUNK=$(echo "$AFIX_OUT" | grep -oP '^junk_regions=\K.*' || true)
                CRCB=$(echo "$AFIX_OUT" | grep -oP '^crc_bad_frames=\K.*' || true)
                # A recording starts and ends mid-frame; ttcut-audiofix
                # reports those two partial frames as edge_junk_bytes rather
                # than in junk_regions. They are removed like any junk (that
                # is why they count towards the byte total below), but they
                # are not damage and must not reach audio_N_corrupt_ranges -
                # otherwise TTCut-ng puts a "Ton-Datenfehler" marker on every single
                # recording. Empty when an older ttcut-audiofix is in PATH,
                # which then behaves exactly as before.
                EDGEB=$(echo "$AFIX_OUT" | grep -oP '^edge_junk_bytes=\K[0-9]+' || echo 0)
                MIDB=$(echo "$JUNK" | tr ',' '\n' | grep -oP ':\K[0-9]+' | awk '{s+=$1} END{print s+0}')
                AUDIOFIX_JUNK_BYTES[$i]=$(( MIDB + ${EDGEB:-0} ))
                AUDIOFIX_DROPPED[$i]=$(echo "$AFIX_OUT" | grep -oP '^dropped_frames=\K[0-9]+' || echo 0)
                # ms positions (junk + CRC) -> video frames, clustered (<=2s)
                AUDIOFIX_CORRUPT_RANGES[$i]=$(audiofix_ranges_to_video_frames "$JUNK" "$CRCB" "$FRAME_RATE_DEC")
                audiofix_report "$(basename "$AF")" "$JUNK" "$CRCB" "$MIDB" "${EDGEB:-0}" "$FRAME_RATE_DEC"
            else
                rm -f "$TEMP_FIXED"
                warn "  $(basename "$AF"): sanitize failed (rc=$FIX_RC), leaving untouched"
            fi
        done
        echo ""
    fi

    progress_set 29
    step "Checking A/V duration alignment..."

    # Video duration = video PTS span, NOT the container span.
    # ffprobe format=duration (CONTAINER_VIDEO_DURATION) spans the latest
    # stream end minus the earliest stream start; with DVB audio leading the
    # video it overshoots by the audio lead, inflating the frame count and
    # the reported drift. Measure the video stream itself:
    # first display PTS (min over the first 2s -- covers leading B-frames) to
    # last PTS + one frame duration, on the repaired TS (monotonic PTS; also
    # collapses VDR multi-file to one clean timeline).
    VIDEO_DURATION=""
    if [ "$CLEANUP_REPAIRED" = true ]; then
        # FRAME_RATE_NUM/DEN are current here: parsed once above and halved
        # together with FRAME_RATE by the interlace correction.
        FRAME_DUR=$(awk "BEGIN {printf \"%.6f\", $FRAME_RATE_DEN / $FRAME_RATE_NUM}")

        # First frame PTS = the stream's start_time (first DECODABLE frame).
        # Not the minimum packet PTS: open-GOP leading B-frames at a mid-
        # recording start have a lower PTS but are dropped by every decoder, so
        # counting them would overstate the duration (by up to M-1 frames).
        # start_time excludes them and matches the decoded
        # frame count. MPEG-2 leading-B skip already trimmed the ES to the
        # first I; align the span start with it in that case.
        if [ "$VIDEO_START_TIME" != "0" ]; then
            SPAN_FIRST_PTS="$VIDEO_START_TIME"
        else
            SPAN_FIRST_PTS=$(_probe_field v:0 stream=start_time "$INPUT" | grep -E '^[0-9]' | head -1)
            # Fallback to min packet PTS if start_time is unavailable.
            if [ -z "$SPAN_FIRST_PTS" ]; then
                SPAN_FIRST_PTS=$(_probe_pts_extreme "%+2" head)
            fi
        fi

        # Last PTS: probe a window near the end (container span as seek hint),
        # widen once if the first window is empty.
        SPAN_SEEK=$(awk "BEGIN {s = ${CONTAINER_VIDEO_DURATION:-0} - 10; printf \"%.3f\", (s > 0) ? s : 0}")
        SPAN_LAST_PTS=$(_probe_pts_extreme "${SPAN_SEEK}%+15" tail)
        if [ -z "$SPAN_LAST_PTS" ]; then
            SPAN_SEEK=$(awk "BEGIN {s = ${CONTAINER_VIDEO_DURATION:-0} - 60; printf \"%.3f\", (s > 0) ? s : 0}")
            SPAN_LAST_PTS=$(_probe_pts_extreme "${SPAN_SEEK}%+60" tail)
        fi

        if [ -n "$SPAN_FIRST_PTS" ] && [ -n "$SPAN_LAST_PTS" ]; then
            VIDEO_DURATION=$(awk "BEGIN {d = $SPAN_LAST_PTS + $FRAME_DUR - $SPAN_FIRST_PTS; printf \"%.6f\", (d > 0) ? d : 0}")
            info "  Video duration from PTS span: ${VIDEO_DURATION}s (first=${SPAN_FIRST_PTS}s last=${SPAN_LAST_PTS}s)"
        fi
    fi

    # Fallback: repair failed or PTS probe empty -> container span (honest warning).
    if [ -z "$VIDEO_DURATION" ]; then
        if [ -n "$CONTAINER_VIDEO_DURATION" ]; then
            VIDEO_DURATION="$CONTAINER_VIDEO_DURATION"
            warn "  Video duration from container span (may include the audio lead)"
        else
            # Fallback: probe elementary stream (slower)
            VIDEO_DURATION=$(_probe_field "" format=duration "$OUTPUT_VIDEO" | grep -E '^[0-9]' || echo "")

            if [ -z "$VIDEO_DURATION" ] || [ "$VIDEO_DURATION" = "N/A" ]; then
                # Estimate from file size and bitrate (rough approximation)
                VIDEO_SIZE_BYTES=$(stat -c%s "$OUTPUT_VIDEO" 2>/dev/null || echo 0)
                # Assume ~5 Mbit/s for SD, ~15 Mbit/s for HD
                if [ "$VIDEO_WIDTH" -gt 1280 ]; then
                    EST_BITRATE=15000000  # 15 Mbit/s for HD
                else
                    EST_BITRATE=5000000   # 5 Mbit/s for SD
                fi
                VIDEO_DURATION=$(awk "BEGIN {printf \"%.3f\", $VIDEO_SIZE_BYTES * 8 / $EST_BITRATE}")
                warn "  Duration estimated from file size (may be inaccurate)"
            fi
        fi
    fi

    # Loud count-check: counted packets in the output ES vs. what the
    # measured PTS-span duration implies. A silent hole (dropped packets
    # that leave no PTS discontinuity signature, e.g. right after a
    # damaged GOP) would otherwise produce a clean-looking .info; this is
    # a second, independent signal that does not depend on gap detection.
    COUNTED_FRAMES=$(ffprobe -v error -count_packets -select_streams v:0 \
        -show_entries stream=nb_read_packets -of csv=p=0 "$OUTPUT_VIDEO" 2>/dev/null)
    # ffprobe's csv writer appends a trailing comma for a raw .m2v
    # elementary stream (verified: "stream,2964," vs. "stream,184960" for
    # a raw .264 - reproduces even for the plain index/codec_name entries,
    # so it's a demuxer-side csv quirk, not a frame-vs-packet count
    # difference). Not limited to raw mpegvideo: mpegts does it too.
    # "2964," fails bash's [ -eq ] integer test
    # silently (exit 2, swallowed by the 2>/dev/null), so this whole
    # count-check was a no-op for every MPEG-2 run. Strip it before the
    # numeric test.
    COUNTED_FRAMES="${COUNTED_FRAMES%,}"
    COUNTED_FRAMES_VALID=false
    if [ -n "$COUNTED_FRAMES" ] && [ "$COUNTED_FRAMES" -eq "$COUNTED_FRAMES" ] 2>/dev/null; then
        COUNTED_FRAMES_VALID=true
    fi

    # Sendezeit: was die Aufnahme an Realzeit umfasst, Loecher eingeschlossen.
    VIDEO_SPAN_MS=$(awk "BEGIN {printf \"%.0f\", $VIDEO_DURATION * 1000}")

    # ES-Dauer: was tatsaechlich im erzeugten Video-ES steht. Referenz fuer
    # Drift, Padding und .info - der Ton wird hierauf ausgerichtet, nicht auf
    # die Sendezeit. Beide Groessen getrennt zu halten ist noetig, nicht
    # kosmetisch: wuerde VIDEO_DURATION_MS einfach die Spanne ersetzen, waere
    # EXPECTED_FRAMES == COUNTED_FRAMES und der count-check unten - der
    # unabhaengige Melder fuer stille Loecher ohne PTS-Sprung - koennte nie
    # mehr feuern.
    if $COUNTED_FRAMES_VALID; then
        VIDEO_DURATION_MS=$(awk "BEGIN {printf \"%.0f\", $COUNTED_FRAMES * 1000.0 * $FRAME_RATE_DEN / $FRAME_RATE_NUM}")
        VIDEO_FRAME_COUNT="$COUNTED_FRAMES"
    else
        warn "  Frame count unavailable - falling back to PTS span for the ES duration"
        VIDEO_DURATION_MS="$VIDEO_SPAN_MS"
        VIDEO_FRAME_COUNT=$(awk "BEGIN {printf \"%.0f\", $VIDEO_DURATION * $FRAME_RATE_NUM / $FRAME_RATE_DEN}")
    fi

    # With a slot table the reference is TTCut-ng's frame index: the pictures
    # it shows, at one frame duration each. The packet count of the ES is not
    # that number - it includes the cold-start leading pictures TTCut-ng
    # drops (7 on Das Erste HD = 140 ms), and counts an H.264 PAFF frame as
    # two packets. The audio was placed on the slots, so the drift below is
    # measured against them.
    if [ "${SLOT_COUNT:-0}" -gt 0 ]; then
        VIDEO_DURATION_MS=$(awk "BEGIN {printf \"%.0f\", $SLOT_COUNT * 1000.0 * $FRAME_RATE_DEN / $FRAME_RATE_NUM}")
        VIDEO_FRAME_COUNT="$SLOT_COUNT"
    fi

    # Duration of the first audio track and its drift against the video ES
    # (AUDIO_DURATION, AUDIO_DURATION_MS, AV_DRIFT_MS), measured on the placed
    # file.
    _recalc_av_drift() {
        FIRST_AUDIO="${AUDIO_FILES[0]}"
        AUDIO_DURATION=$(audio_es_duration "$FIRST_AUDIO")
        AUDIO_DURATION_MS=$(awk "BEGIN {printf \"%.0f\", $AUDIO_DURATION * 1000}")
        AV_DRIFT_MS=$(awk "BEGIN {printf \"%.0f\", $VIDEO_DURATION_MS - $AUDIO_DURATION_MS}")
    }

    # Loud count-check, second half: a hole the PTS list does not show.
    if $COUNTED_FRAMES_VALID; then
        EXPECTED_FRAMES=$(awk "BEGIN {printf \"%.0f\", ($VIDEO_SPAN_MS / 1000.0) * $FRAME_RATE_DEC}")
        if [ $((EXPECTED_FRAMES - COUNTED_FRAMES)) -gt 1 ]; then
            warn "Video ES is missing $((EXPECTED_FRAMES - COUNTED_FRAMES)) frames mid-stream (counted $COUNTED_FRAMES, PTS span implies $EXPECTED_FRAMES) - audio was placed around the holes, defect positions are reported below (and as markers in TTCut-ng)"
        fi
    fi

    # audio_gap_frames: one entry per silence insert inside the recording.
    # The position is a slot time, i.e. already an output-ES time; adding the
    # PTS of frame 0 puts it into the form the emission further down reads
    # ("src_start src_end 0", third field 0 = mark the start frame only: with
    # the real length a single long outage would write hundreds of frame
    # indices into the .info and run into the maxExtraFrames cap of
    # ttesinfo.cpp; how long the loss was is in es_missing_ranges).
    AUDIO_GAP_FRAMES_SOURCE_PTS=()
    N_SILENCE_INSERTS=0
    if [ -s "${AUDIO_SILENCE_POS_FILE:-}" ]; then
        N_SILENCE_INSERTS=$(grep -c . "$AUDIO_SILENCE_POS_FILE")
        while IFS=' ' read -r st _; do
            [ -z "$st" ] && continue
            AUDIO_GAP_FRAMES_SOURCE_PTS+=("$(awk -v v="$SLOT_V0" -v t="$st" 'BEGIN {printf "%.6f", v + t}') 0 0")
        done < <(LC_ALL=C sort -g -u "$AUDIO_SILENCE_POS_FILE")
    fi
    N_HOLES=0
    [ -s "${VIDEO_GAPS_FILE:-}" ] && N_HOLES=$(grep -c . "$VIDEO_GAPS_FILE")
    if [ $((N_HOLES + N_SILENCE_INSERTS)) -gt 0 ]; then
        info "  Picture holes: $N_HOLES; silence inserts inside the recording: $N_SILENCE_INSERTS (all tracks)"

        # Overall damage verdict. The per-defect lines say WHERE the holes
        # are; on a recording that lost transmission for good they scroll
        # past by the thousand and the fact that the whole thing is beyond
        # saving gets lost in them. Two independent measures, either one is
        # enough to trip it: the share of video frames that never arrived,
        # and how densely the defects sit. Reference case (Futurama 06x03,
        # 2026-08-23, measured with the gap detection of that time): 15.6%
        # of frames missing and ~150 gaps/min. This only reports; the run
        # continues and still produces its output, because where the line
        # between "damaged" and "worthless" falls is the viewer's call.
        DEFECT_LOSS_PCT_LIMIT=5
        DEFECT_GAPS_PER_MIN_LIMIT=20
        # Silence inserts per TRACK, not summed: one outage shows up once in
        # every audio track.
        DEFECT_TRACKS=${SLOT_TRACKS_PLACED:-0}
        [ "$DEFECT_TRACKS" -gt 0 ] || DEFECT_TRACKS=1
        DEFECT_TOTAL_GAPS=$(( N_HOLES + N_SILENCE_INSERTS / DEFECT_TRACKS ))
        DEFECT_LOSS_PCT=0
        if [ "${EXPECTED_FRAMES:-0}" -gt 0 ] 2>/dev/null; then
            DEFECT_LOSS_PCT=$(awk -v e="$EXPECTED_FRAMES" -v c="${COUNTED_FRAMES:-0}" \
                'BEGIN {d = e - c; if (d < 0) d = 0; printf "%.1f", d * 100.0 / e}')
        fi
        DEFECT_GAPS_PER_MIN=0
        if [ "${VIDEO_DURATION_MS:-0}" -gt 0 ] 2>/dev/null; then
            # Whole numbers: a per-minute count has no decimal precision. The
            # rounding happens BEFORE the threshold test, so the limit
            # applies to the number that is printed.
            DEFECT_GAPS_PER_MIN=$(awk -v g="$DEFECT_TOTAL_GAPS" -v ms="$VIDEO_DURATION_MS" \
                'BEGIN {printf "%.0f", g * 60000.0 / ms}')
        fi
        if awk -v l="$DEFECT_LOSS_PCT" -v lm="$DEFECT_LOSS_PCT_LIMIT" \
               -v g="$DEFECT_GAPS_PER_MIN" -v gm="$DEFECT_GAPS_PER_MIN_LIMIT" \
               'BEGIN {exit !(l > lm || g > gm)}'; then
            # The wording is a contract: the VDR wrapper (tools/vdr-demux-example.sh)
            # reads the percentage and the "N audio gaps/min" figure from this
            # line. N counts picture holes plus silence inserts per track.
            warn "SEVERELY DAMAGED RECORDING: ${DEFECT_LOSS_PCT}% of video frames missing (limit ${DEFECT_LOSS_PCT_LIMIT}%), ${DEFECT_GAPS_PER_MIN} audio gaps/min per track (limit ${DEFECT_GAPS_PER_MIN_LIMIT})"
            warn "  The result is very likely unusable - check it before cutting. Demux continues."
        fi
    fi

    # Duration comparison on the first audio track: by the slot rule it ends
    # on the last picture slot, so anything beyond one audio frame is a
    # failed placement.
    AUDIO_DURATION_MS=0
    AV_DRIFT_MS=0
    AV_DRIFT_RATE=0
    if [ ${#AUDIO_FILES[@]} -gt 0 ]; then
        _recalc_av_drift

        info "  Video: $VIDEO_FRAME_COUNT frames = ${VIDEO_DURATION_MS}ms"
        info "  Audio: ${AUDIO_DURATION_MS}ms"
        if [ "$VIDEO_DURATION_MS" -gt 0 ]; then
            AV_DRIFT_RATE=$(awk "BEGIN {printf \"%.2f\", $AV_DRIFT_MS / ($VIDEO_DURATION_MS / 60000)}")
        fi
        if [ "${AV_DRIFT_MS#-}" -gt 50 ]; then
            warn "  A/V duration mismatch: video minus audio = ${AV_DRIFT_MS}ms (the first audio track should end on the last picture slot)"
        else
            info "  A/V durations match (difference: ${AV_DRIFT_MS}ms)"
        fi
    fi
    progress_set "$PROGRESS_PRE_END"
    PROGRESS_TAIL_BASE=$PROGRESS_LAST
    echo ""

    # 3. Try to extract subtitles (opt-in via --subs; an empty SUBTITLE_FILES
    # array keeps the .info [subtitles] section valid with count=0)
    SUBTITLE_FILES=()
    if [ "$EXPORT_SUBS" != true ]; then
        if [ ${#SUBTITLE_STREAMS[@]} -gt 0 ]; then
            info "Subtitle export disabled (${#SUBTITLE_STREAMS[@]} stream(s) present, use --subs to extract)"
            echo ""
        fi
    elif [ ${#SUBTITLE_STREAMS[@]} -gt 0 ]; then
        step "Attempting subtitle extraction..."

        # Get duration for mid-point sampling (subtitles may not exist during pre-roll/ads)
        if [ "$VDR_MULTIFILE" = true ] && [ "$CLEANUP_REPAIRED" != true ]; then
            # Use pre-calculated total duration
            sub_duration="$CONTAINER_VIDEO_DURATION"
        else
            sub_duration=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$INPUT" 2>/dev/null | head -1)
        fi
        sub_midpoint=$(awk "BEGIN {printf \"%.0f\", ${sub_duration:-0} / 2}")
        [ "$sub_midpoint" -lt 60 ] 2>/dev/null && sub_midpoint=0

        for sub in "${SUBTITLE_STREAMS[@]}"; do
            IFS=':' read -r idx codec lang <<< "$sub"

            # Quick check: does the stream contain data? Sample 120s at the
            # mid-point and, if that yields nothing, 120s from the start.
            # MEASURED 2026-08-16: ffprobe -read_intervals enumerates ZERO
            # packets on real DVB subtitle streams that a -c copy extract
            # proves non-empty (678 KB/10 min) - the old ffprobe-based check
            # therefore skipped every such stream as "empty". Byte-counting
            # an ffmpeg stream-copy sample is the reliable probe.
            sub_bytes=$(timeout 90 ffmpeg -v error -ss "$sub_midpoint" -t 120 \
                "${ORIG_INPUT_ARGS[@]}" -map "0:$idx" -c copy -f mpegts - 2>/dev/null | wc -c)
            if [ "${sub_bytes:-0}" -eq 0 ]; then
                # Subs may simply be absent during the mid-point window.
                sub_bytes=$(timeout 90 ffmpeg -v error -t 120 \
                    "${ORIG_INPUT_ARGS[@]}" -map "0:$idx" -c copy -f mpegts - 2>/dev/null | wc -c)
            fi
            if [ "${sub_bytes:-0}" -eq 0 ]; then
                info "  Subtitle $idx [$lang] ($codec) - empty, skipped"
                continue
            fi

            case "$codec" in
                dvb_subtitle|dvbsub)
                    # One subs-only TS serves bitmap export AND OCR, rebased
                    # to the ES timeline (PTS minus first video PTS) so both
                    # outputs line up with the demuxed streams.
                    # -copyts is essential: without it ffmpeg first rebases
                    # the output to the input start time, and since this
                    # output holds ONLY the subtitle stream, that start time
                    # is the first subtitle packet itself - avoid_negative_ts
                    # then pins it to ~0 regardless of its true position and
                    # -output_ts_offset is nullified (measured on 03x06:
                    # every recording came out with first packet = 1.400s
                    # muxdelay instead of the real 38.540s, shifting all
                    # subtitles ~37s early). With -copyts the offset is a
                    # plain subtraction: source PTS - first video PTS.
                    # A subtitle from before the video start would wrap in
                    # mpegts (no negative PTS) - acceptable, it has no video
                    # to belong to anyway.
                    SUBS_TS="$OUTDIR/.subs_only_${idx}.ts"
                    SUBS_EXTRACT_LOG="$OUTDIR/.subs_extract_${idx}.log"
                    _CLEANUP_FILES+=("$SUBS_TS" "$SUBS_EXTRACT_LOG")
                    _extract_subs_ts "$idx" "$SUBS_TS" "$SUBS_EXTRACT_LOG" -c copy
                    if [ ! -s "$SUBS_TS" ]; then
                        info "  DVB subtitle $idx [$lang] - no data extracted, skipped"
                        continue
                    fi

                    # Matroska subtitle-only container (.mks): ffmpeg's sup
                    # muxer only accepts PGS, not dvb_subtitle (measured) -
                    # the old .sup output could never be written.
                    OUTPUT_SUB="$OUTDIR/${BASENAME}_${lang}.mks"
                    info "  DVB subtitle $idx [$lang] -> $OUTPUT_SUB (bitmap, matroska)"
                    # -map 0 + generous probe: on a subtitle-only TS ffmpeg's
                    # default stream selection finds no stream (sparse codec
                    # detection) and errors out with "does not contain any
                    # stream" (measured).
                    MKS_MUX_LOG="$OUTDIR/.subs_mks_${idx}.log"
                    _CLEANUP_FILES+=("$MKS_MUX_LOG")
                    # -copyts again: keep the ES-timeline position instead of
                    # rebasing the .mks to start at the first subtitle.
                    ffmpeg -y -v error -probesize 5M -analyzeduration 10M \
                        -copyts -i "$SUBS_TS" -map 0 -c copy -f matroska "$OUTPUT_SUB" > "$MKS_MUX_LOG" 2>&1 || true
                    warn_ffmpeg_log "$MKS_MUX_LOG" "  "
                    if [ -s "$OUTPUT_SUB" ]; then
                        SUBTITLE_FILES+=("$OUTPUT_SUB")
                    else
                        rm -f "$OUTPUT_SUB"
                    fi

                    # OCR stage (Ts2MKV-proven pipeline): bitmap -> cuttable
                    # text SRT that TTCut auto-loads. ccextractor zeroes its
                    # clock on the FIRST cue (measured; -noautotimeref does
                    # not change that), so the lead-in is handed back via
                    # -delay from the first packet PTS of the subs-only TS.
                    if command -v ccextractor &>/dev/null; then
                        OCR_SRT="$OUTDIR/${BASENAME}_${lang}.srt"
                        DELAY_MS=$(_subs_delay_ms "$SUBS_TS")
                        info "  OCR (ccextractor, deu) -> $OCR_SRT (delay ${DELAY_MS} ms)"
                        OCR_RC=0
                        _run_ocr "$SUBS_TS" "$OCR_SRT" "$DELAY_MS" || OCR_RC=$?
                        # The stream ccextractor actually read - the glyph dump
                        # below must use the SAME file, or the two ccextractor
                        # clocks drift apart (see the comment there).
                        OCR_TS="$SUBS_TS"

                        # ccextractor 0.96.6 segfaults on some DVB subtitle
                        # streams. Measured 2026-09-20 on "The Silent Hour"
                        # (Sat.1 HD, rc=139 after 300 s of material, SRT empty);
                        # the same crash on ZDF HD recordings was measured
                        # 2026-09-02 outside this project, where re-encoding the
                        # stream with ffmpeg's dvbsub encoder produced a stream
                        # it decodes fine. Detour only on failure: recordings
                        # whose direct run works keep the proven path.
                        # The encoder keeps its default depth of 4 bit (16
                        # colours): -min_bpp 8 was tried to preserve a larger
                        # palette and makes ccextractor fail outright (measured
                        # 2026-09-20: rc=10 and no captions, while the same
                        # stream at 4 bit gives rc=0 and a full SRT). 4 bit is
                        # also the usual depth of broadcast DVB subtitles.
                        # Whether a colour palette survives the detour unchanged
                        # is UNVERIFIED: no recording with coloured subtitles was
                        # available to measure it, and ffmpeg cannot build one
                        # from a text SRT (no text -> dvbsub encoder). The
                        # alternative here is no SRT at all.
                        if [ "$OCR_RC" -ne 0 ] || [ ! -s "$OCR_SRT" ]; then
                            warn "  OCR failed (ccextractor exit $OCR_RC) - retrying with a re-encoded subtitle stream"
                            SUBS_TS_RE="$OUTDIR/.subs_reenc_${idx}.ts"
                            SUBS_REENC_LOG="$OUTDIR/.subs_reenc_${idx}.log"
                            _CLEANUP_FILES+=("$SUBS_TS_RE" "$SUBS_REENC_LOG")
                            # Re-encode from the SOURCE, not from $SUBS_TS:
                            # measured 2026-09-20 that re-encoding the
                            # subtitle-only TS yields a degenerate stream
                            # (37 KB instead of 5 MB, renders nothing, no
                            # captions), while the same re-encode straight from
                            # the recording decodes fine. Same rebasing as the
                            # stream-copy extraction above, so both outputs sit
                            # on the ES timeline.
                            _extract_subs_ts "$idx" "$SUBS_TS_RE" "$SUBS_REENC_LOG" -c:s dvbsub
                            if [ -s "$SUBS_TS_RE" ]; then
                                # Same rule as above: the delay comes from the
                                # first packet of the file handed to ccextractor.
                                DELAY_MS=$(_subs_delay_ms "$SUBS_TS_RE")
                                OCR_RC=0
                                _run_ocr "$SUBS_TS_RE" "$OCR_SRT" "$DELAY_MS" || OCR_RC=$?
                                if [ -s "$OCR_SRT" ]; then
                                    OCR_TS="$SUBS_TS_RE"
                                    info "  OCR via re-encoded stream succeeded (delay ${DELAY_MS} ms)"
                                fi
                            else
                                warn "  Re-encoding the subtitle stream produced nothing"
                            fi
                        fi
                        if [ -s "$OCR_SRT" ]; then
                            # Invalid UTF-8 bytes make players fall back to
                            # Latin-1 (Ts2MKV lesson); SubRip wants CRLF line
                            # endings. SRT markup (<font color>, <i>, <b>) is
                            # KEPT - TTCut renders it in the overlay since
                            # 5c37972a (QTextDocument, resources disarmed via
                            # 4d2f3348), and the colors carry speaker identity.
                            _srt_before=$(wc -c < "$OCR_SRT")
                            iconv -c -f UTF-8 -t UTF-8 "$OCR_SRT" > "$OCR_SRT.tmp" 2>/dev/null || true
                            if [ -s "$OCR_SRT.tmp" ]; then mv "$OCR_SRT.tmp" "$OCR_SRT"; else rm -f "$OCR_SRT.tmp"; fi
                            _srt_mid=$(wc -c < "$OCR_SRT")
                            # CRLF normalization GROWS the file - measure the
                            # invalid-byte removal before it, not after.
                            sed -i 's/\r*$/\r/' "$OCR_SRT"
                            [ "$_srt_before" -gt "$_srt_mid" ] && \
                                info "  OCR SRT sanitized ($((_srt_before-_srt_mid)) invalid UTF-8 byte(s) removed)"

                            # Deterministic glyph repair: tesseract cannot emit
                            # glyphs outside its charset (music note) and
                            # guesses junk (">", "}", "$"). The helper compares
                            # each line's edge glyph bitmaps (spupng dump)
                            # against the template library and fixes the SRT.
                            # The dump MUST use the same time handling as the
                            # OCR run (--ignoreptsjumps, same -delay): with
                            # different flags the two ccextractor clocks drift
                            # apart mid-recording (measured: 1.28 s at min 25).
                            GLYPH_BASE="$(dirname "$(readlink -f "$0")")"
                            GLYPH_HELPER="$GLYPH_BASE/ttcut-ocr-glyphs"
                            GLYPH_DIR="$GLYPH_BASE/ocr-glyphs"
                            if [ ! -x "$GLYPH_HELPER" ]; then
                                GLYPH_HELPER="/usr/local/src/TTCut-ng/tools/ttcut-demux/ttcut-ocr-glyphs"
                                GLYPH_DIR="/usr/local/src/TTCut-ng/tools/ttcut-demux/ocr-glyphs"
                            fi
                            # Installed layout (Debian package): helper sits in
                            # /usr/bin, the PNG templates under /usr/share.
                            if [ ! -d "$GLYPH_DIR" ] && [ -d "/usr/share/ttcut-ng/ocr-glyphs" ]; then
                                GLYPH_DIR="/usr/share/ttcut-ng/ocr-glyphs"
                            fi
                            # The helper needs Pillow (python3-pil, only suggested by
                            # the package); its stderr is dropped below, so without
                            # this check the repair would vanish without a word.
                            GLYPH_READY=0
                            if [ -x "$GLYPH_HELPER" ] && [ -d "$GLYPH_DIR" ] && \
                               command -v python3 &>/dev/null && \
                               ls "$GLYPH_DIR"/*.png &>/dev/null; then
                                if python3 -c "import PIL" 2>/dev/null; then
                                    GLYPH_READY=1
                                else
                                    warn "  glyph repair skipped: python3-pil (Pillow) is not installed"
                                fi
                            fi
                            if [ "$GLYPH_READY" -eq 1 ]; then
                                SPU_DIR="$OUTDIR/spu_glyphs_tmp_${idx}"
                                _CLEANUP_DIRS+=("$SPU_DIR")
                                mkdir -p "$SPU_DIR"
                                # ccextractor treats everything after the LAST
                                # dot of the WHOLE -o path as an extension and
                                # strips it (measured: -o .../.spu_glyphs_5/cue
                                # put the PNGs into .../.d/ while the XML kept
                                # pointing at cue.d/). Run from inside the dir
                                # with a dot-free relative name to be immune to
                                # dots anywhere in the output path.
                                SUBS_TS_ABS=$(realpath "$OCR_TS")
                                set +e
                                ( cd "$SPU_DIR" && ccextractor -in=ts -codec dvbsub \
                                    --no-spupngocr --out=spupng \
                                    --ignoreptsjumps -delay "$DELAY_MS" \
                                    -o cue "$SUBS_TS_ABS" ) >/dev/null 2>&1
                                if [ -s "$SPU_DIR/cue" ]; then
                                    "$GLYPH_HELPER" match --srt "$OCR_SRT" --spuxml "$SPU_DIR/cue" \
                                        --templates "$GLYPH_DIR" --delay-ms 0 --apply 2>/dev/null | \
                                        while IFS= read -r gl; do info "  glyph: $gl"; done
                                fi
                                set -e
                            fi
                            SUBTITLE_FILES+=("$OCR_SRT")
                        else
                            rm -f "$OCR_SRT"
                            warn "  OCR produced no captions - keeping the bitmap track only"
                        fi
                    else
                        warn "  ccextractor not found - OCR SRT skipped, bitmap only"
                    fi
                    ;;
                subrip|srt|text)
                    OUTPUT_SUB="$OUTDIR/${BASENAME}_${lang}.srt"
                    info "  Subtitle $idx [$lang] -> $OUTPUT_SUB"
                    ffmpeg -y "${ORIG_INPUT_ARGS[@]}" -map "0:$idx" "$OUTPUT_SUB" 2>&1 | grep -E "^(Output|Stream)" || true
                    SUBTITLE_FILES+=("$OUTPUT_SUB")
                    ;;
                *)
                    warn "  Subtitle $idx [$lang]: $codec - not supported"
                    ;;
            esac
        done
        echo ""
    fi

    # 4. A/V start report
    progress_set_tail 8
    step "A/V start..."

    # PTS of frame 0: slot 0 of the slot table, else the pre-repair probe.
    FIRST_VIDEO_PTS="${SLOT_V0:-$ORIG_VIDEO_PTS}"
    # Legacy: FIRST_AUDIO_PTS = first track's PTS (for backwards compat in .info)
    FIRST_AUDIO_PTS="${ORIG_AUDIO_PTS_ARR[0]:-}"

    if [ -n "$FIRST_VIDEO_PTS" ]; then
        info "  Frame 0 PTS: ${FIRST_VIDEO_PTS}s"
        for i in "${!AUDIO_STREAMS[@]}"; do
            IFS=':' read -r idx codec lang <<< "${AUDIO_STREAMS[$i]}"
            TRACK_PTS="${ORIG_AUDIO_PTS_ARR[$i]:-}"
            if [ -n "$TRACK_PTS" ]; then
                TRACK_OFFSET_MS=$(awk "BEGIN {printf \"%.0f\", ($TRACK_PTS - $FIRST_VIDEO_PTS) * 1000}")
                info "  Audio track $idx ($codec [$lang]): first PTS=${TRACK_PTS}s (${TRACK_OFFSET_MS}ms against frame 0), head cut=${TRACK_HEAD_MS[$i]:-0}ms, start offset=${TRACK_START_OFFSET_MS[$i]:-not written}ms"
            fi
        done
    else
        warn "  Could not determine the PTS of frame 0"
    fi
    # Legacy global av_offset_ms: the first track's start offset, so a reader
    # that knows no per-track key still gets the best single value.
    AV_OFFSET_MS="${TRACK_START_OFFSET_MS[0]:-0}"
    echo ""

    # 5. Create info file with metadata
    OUTPUT_INFO="$OUTDIR/${BASENAME}.info"
    progress_set_tail 9
    step "Creating info file: $OUTPUT_INFO"

    # Legacy global audio_trimmed_ms: the first track's head cut
    AUDIO_TRIM_MS="${TRACK_HEAD_MS[0]:-0}"

    cat > "$OUTPUT_INFO" << EOF
# TTCut Elementary Stream Info File
# Generated: $(date -Iseconds)
# Source: $INPUT

[video]
file=${BASENAME}.${VIDEO_EXT}
codec=$VIDEO_CODEC
width=$VIDEO_WIDTH
height=$VIDEO_HEIGHT
frame_rate=$FRAME_RATE
start_pts=$START_PTS
filler_stripped=$FILLER_STRIPPED

[timing]
# first_video_pts = PTS of frame 0. The audio tracks are placed on the
# picture timeline frame by frame; what remains is below one audio frame and
# stands per track in audio_N_start_offset_ms (positive = the track belongs
# later than its ES plays it). av_offset_ms repeats track 0's value for
# readers that know no per-track key.
first_video_pts=$FIRST_VIDEO_PTS
first_audio_pts=$FIRST_AUDIO_PTS
audio_trimmed_ms=$AUDIO_TRIM_MS
# Duration mismatch: positive = video longer than audio (progressive desync)
# Values over 50ms may cause noticeable A/V drift
video_duration_ms=$VIDEO_DURATION_MS
audio_duration_ms=$AUDIO_DURATION_MS
duration_drift_ms=$AV_DRIFT_MS
drift_rate_ms_per_min=$AV_DRIFT_RATE
av_offset_ms=$AV_OFFSET_MS

[audio]
count=${#AUDIO_STREAMS[@]}
EOF

    for i in "${!AUDIO_STREAMS[@]}"; do
        IFS=':' read -r idx codec lang <<< "${AUDIO_STREAMS[$i]}"
        TRACK_PTS="${ORIG_AUDIO_PTS_ARR[$i]:-}"
        echo "audio_${i}_file=$(basename "${AUDIO_FILES[$i]}" 2>/dev/null || echo "")" >> "$OUTPUT_INFO"
        echo "audio_${i}_codec=$codec" >> "$OUTPUT_INFO"
        echo "audio_${i}_lang=$lang" >> "$OUTPUT_INFO"
        echo "audio_${i}_first_pts=$TRACK_PTS" >> "$OUTPUT_INFO"
        echo "audio_${i}_trimmed_ms=${TRACK_HEAD_MS[$i]:-0}" >> "$OUTPUT_INFO"
        if [ -n "${TRACK_START_OFFSET_MS[$i]:-}" ]; then
            echo "audio_${i}_start_offset_ms=${TRACK_START_OFFSET_MS[$i]}" >> "$OUTPUT_INFO"
        fi
        # Balance of the slot rule: silence frames written (head, holes, tail)
        # and frames dropped in picture holes (0 = not emitted).
        if [ -n "${TRACK_SILENCE_MS[$i]:-}" ] && [ "${TRACK_SILENCE_MS[$i]:-0}" != "0" ]; then
            echo "audio_${i}_silence_ms=${TRACK_SILENCE_MS[$i]}" >> "$OUTPUT_INFO"
        fi
        if [ -n "${TRACK_REMOVED_MS[$i]:-}" ] && [ "${TRACK_REMOVED_MS[$i]:-0}" != "0" ]; then
            echo "audio_${i}_removed_ms=${TRACK_REMOVED_MS[$i]}" >> "$OUTPUT_INFO"
        fi
        if [ -n "${AC3_FIX_RESULTS[$i]:-}" ]; then
            echo "audio_${i}_ac3_fixed=true" >> "$OUTPUT_INFO"
            echo "audio_${i}_ac3_fixed_frames=${AC3_FIX_RESULTS[$i]}" >> "$OUTPUT_INFO"
        fi
        # corrupt_ranges is what TTCut-ng turns into a "Ton-Datenfehler" marker, so
        # it carries real damage only. The byte counters are human diagnostics
        # (TTESInfo deliberately does not parse them) and are written whenever
        # the sanitizer removed anything at all - including the partial frames
        # at the recording edges, which are trimmed but are not damage.
        if [ -n "${AUDIOFIX_CORRUPT_RANGES[$i]:-}" ]; then
            echo "audio_${i}_corrupt_ranges=${AUDIOFIX_CORRUPT_RANGES[$i]}" >> "$OUTPUT_INFO"
        fi
        if [ "${AUDIOFIX_JUNK_BYTES[$i]:-0}" != "0" ]; then
            echo "audio_${i}_junk_bytes=${AUDIOFIX_JUNK_BYTES[$i]}" >> "$OUTPUT_INFO"
            echo "audio_${i}_dropped_frames=${AUDIOFIX_DROPPED[$i]:-0}" >> "$OUTPUT_INFO"
        fi
    done

    cat >> "$OUTPUT_INFO" << EOF

[subtitles]
count=${#SUBTITLE_FILES[@]}
EOF

    for i in "${!SUBTITLE_FILES[@]}"; do
        echo "sub_${i}_file=$(basename "${SUBTITLE_FILES[$i]}")" >> "$OUTPUT_INFO"
    done

    WARNINGS_HEADER_WRITTEN=false
    write_warnings_header_if_needed() {
        if ! $WARNINGS_HEADER_WRITTEN; then
            echo "" >> "$OUTPUT_INFO"
            echo "[warnings]" >> "$OUTPUT_INFO"
            WARNINGS_HEADER_WRITTEN=true
        fi
    }

    if [ -n "$ES_TOTAL_AUS" ]; then
        write_warnings_header_if_needed
        echo "es_total_aus=$ES_TOTAL_AUS" >> "$OUTPUT_INFO"
    fi
    if [ -n "$ES_DOUBLED_PTS_CSV" ]; then
        write_warnings_header_if_needed
        echo "es_doubled_pts_aus=$ES_DOUBLED_PTS_CSV" >> "$OUTPUT_INFO"
    fi

    # Emit audio_gap_frames= as comma-separated frame indices spanning each gap.
    # Uses first_video_pts as reference (PTS-derived display-time frames;
    # NOT the raw AU numbering that es_doubled_pts_aus uses).
    if [ ${#AUDIO_GAP_FRAMES_SOURCE_PTS[@]} -gt 0 ] && [ -n "$FIRST_VIDEO_PTS" ]; then
        ALL_GAP_FRAMES=()
        for entry in "${AUDIO_GAP_FRAMES_SOURCE_PTS[@]}"; do
            IFS=' ' read -r gs _ silence_ms <<< "$entry"
            gs_frame=$(awk "BEGIN {printf \"%d\", ($gs - $FIRST_VIDEO_PTS) * $FRAME_RATE_NUM / $FRAME_RATE_DEN + 0.5}")
            [ "$gs_frame" -lt 0 ] && gs_frame=0
            # Compute end-frame from silence_ms (at least 1 frame for visibility)
            silence_frames=$(awk "BEGIN {f = $silence_ms / 1000.0 * $FRAME_RATE_NUM / $FRAME_RATE_DEN; printf \"%d\", (f >= 1) ? f : 0}")
            ge_frame=$(( gs_frame + silence_frames ))
            for ((f = gs_frame; f <= ge_frame; f++)); do
                ALL_GAP_FRAMES+=("$f")
            done
        done

        GAP_FRAMES_SORTED=$(printf '%s\n' "${ALL_GAP_FRAMES[@]}" | sort -n -u | paste -sd,)
        if [ -n "$GAP_FRAMES_SORTED" ]; then
            write_warnings_header_if_needed
            echo "audio_gap_frames=$GAP_FRAMES_SORTED" >> "$OUTPUT_INFO"
        fi
    fi

    # es_missing_frames / es_missing_ranges: video holes (VIDEO_GAPS_FILE rows
    # "src_start src_end gap_ms") mapped to OUTPUT-ES frame coordinates - each
    # hole shifts everything after it earlier by the frames already lost
    # before it, since the output ES has those frames physically missing.
    if [ -s "$VIDEO_GAPS_FILE" ] && [ -n "$FIRST_VIDEO_PTS" ]; then
        MISS_FRAMES=""
        lost_before=0
        MISS_POS_MS=""   # raw "fs ms" rows, one per hole, input to the clustering pass below
        while IFS=' ' read -r vs ve vms; do
            fs=$(awk "BEGIN {printf \"%.0f\", (($vs - $FIRST_VIDEO_PTS) - $lost_before) * $FRAME_RATE_DEC}")
            MISS_FRAMES="${MISS_FRAMES:+$MISS_FRAMES,}$fs"
            MISS_POS_MS="${MISS_POS_MS:+$MISS_POS_MS$'\n'}$fs ${vms%.*}"
            lost_before=$(awk "BEGIN {printf \"%.6f\", $lost_before + ($ve - $vs)}")
        done < "$VIDEO_GAPS_FILE"
        if [ -n "$MISS_FRAMES" ]; then
            write_warnings_header_if_needed
            # es_missing_frames stays the raw, unclustered per-hole list
            # (informational; one entry per row of VIDEO_GAPS_FILE).
            echo "es_missing_frames=$MISS_FRAMES" >> "$OUTPUT_INFO"
            # es_missing_ranges is clustered (same <=2s / 2*fps-frames rule
            # as corrupt_frame_ranges above): every raw hole used to become
            # its own point-range, which on real signal-loss material is
            # dozens to hundreds of degenerate single-frame ranges (measured
            # g1: 5, incl. an exact duplicate position; g2: 137, 13 with
            # negative ms from DTS/PTS boundary artifacts) instead of the
            # handful of actual defect zones a human/consumer cares about.
            # Merged-range end is the LAST member's fs+1 - a single-frame
            # "fs-fs+1" span is the degenerate range for an isolated hole:
            # the gap itself contributes no output-ES frames (it was
            # physically removed by the demux), so the range only marks
            # where it used to sit. Merged ms is the SUM of member ms, each
            # first clamped to >=0 (a negative raw ms is a DTS/PTS boundary
            # artifact, not real silence to subtract).
            MISS_RANGES=$(printf '%s\n' "$MISS_POS_MS" | sort -n -k1,1 | awk -v fps="$FRAME_RATE_DEC" '
                { fs = $1; ms = $2; if (ms < 0) ms = 0
                  if (state && fs - last_fs <= 2*fps) { last_fs = fs; sum_ms += ms; next }
                  if (state) { printf "%s%d-%d:%d", sep, start_fs, last_fs + 1, sum_ms; sep = "," }
                  start_fs = fs; last_fs = fs; sum_ms = ms; state = 1 }
                END { if (state) printf "%s%d-%d:%d", sep, start_fs, last_fs + 1, sum_ms }')
            echo "es_missing_ranges=$MISS_RANGES" >> "$OUTPUT_INFO"
            warn "  Missing video frame(s) at $(format_ranges_hms "$MISS_RANGES" "$FRAME_RATE_DEC")"
        fi
    fi

    # es_lost_ms: total picture loss, summed from the picture holes of the
    # slot table, not from the span difference: the repair stage runs with
    # -fflags +genpts+igndts and smooths the PTS jump at the segment seam
    # before VIDEO_SPAN_MS is measured. The difference therefore only sees
    # the loss INSIDE a segment (measured 2026-08-24 on "03x15": 27178
    # instead of 135520 ms). The hole list knows both parts. Audio stays in
    # sync (its frames of that time are dropped), so this is a picture-only
    # defect the user should be told about.
    ES_LOST_MS=0
    if [ -s "$VIDEO_GAPS_FILE" ]; then
        ES_LOST_MS=$(awk '{s += $2 - $1} END {printf "%.0f", s * 1000}' "$VIDEO_GAPS_FILE")
    fi
    echo "es_lost_ms=$ES_LOST_MS" >> "$OUTPUT_INFO"
    if [ "$ES_LOST_MS" -gt 1000 ]; then
        # Zweiter Halbsatz ist Absicht: ohne ihn liest sich die Meldung wie ein
        # Sync-Fehler, und genau den gibt es hier nicht mehr.
        LOSS_POS_COUNT=$(echo "$MISS_RANGES" | tr ',' '\n' | grep -c .)
        if [ "$LOSS_POS_COUNT" -gt 0 ]; then
            LOSS_POS_TEXT="$LOSS_POS_COUNT position(s)"
        else
            # MISS_RANGES can be empty while es_lost_ms is still >0 (VIDEO_GAPS_FILE
            # present but its rows didn't cluster into a named range) - "0
            # position(s)" would misreport a defect as absent.
            LOSS_POS_TEXT="an unlisted position"
        fi
        warn "Material loss: $(awk "BEGIN {printf \"%.1f\", $ES_LOST_MS/1000}") s missing at $LOSS_POS_TEXT - picture jumps there, audio stays in sync"
    fi

    # corrupt_frame_ranges: frames present in the output ES but flagged
    # corrupt by the demuxer/parser during extraction (VIDEO_CORRUPT_DTS_TICKS
    # was captured from the video demux log before it was cleaned up, above).
    # Cluster dts ticks <=2s apart into one range (same seam tends to log
    # several corrupt packets close together).
    #
    # dts is a raw 33-bit (90kHz) PES timestamp field, printed by ffmpeg
    # BEFORE its own wrap-correction runs (libavformat/demux.c logs "Packet
    # corrupt" ahead of update_timestamps()). That field wraps every 2^33
    # ticks (~26.5h) from wherever the broadcaster's counter happened to be
    # when this recording started - unrelated to FIRST_VIDEO_PTS's own
    # wrap-relative value. Measured on a real recording (07x11) where
    # first_video_pts's raw tick was only ~1517s short of the 2^33 boundary:
    # every "Packet corrupt" line logged after that point in the recording
    # printed a small post-wrap dts (~1386s-2682s), which naively subtracting
    # fvp_ticks (~8.45G ticks) from turned massively negative and got
    # dropped by "f < 0" below, leaving corrupt_frame_ranges empty despite
    # 69 real corrupt-packet lines in the log. Re-adding 2^33 until the delta
    # is non-negative undoes the wrap (a single wrap covers any recording
    # under ~26.5h, which every TS recording is) and reproduces the correct
    # elapsed-time-since-start value.
    #
    # Ordering matters: wrap-correct and convert to a frame number BEFORE
    # sorting. VDR can re-acquire signal on a different broadcaster PTS
    # base after a full signal loss (a fresh 33-bit counter era); a raw dts
    # tick from that era, once wrap-corrected, can land far outside the
    # recording (frame count massively beyond total, or - after the old
    # "sort raw ticks first" ordering scrambled chronological order -
    # start>end inverted ranges). Measured on g2_final/00001.info: an
    # inverted range "4760978-25194" and 7 ranges beyond 600k frames on a
    # ~187k-frame recording. Sorting raw (pre-wrap) ticks numerically also
    # put post-wrap (small-value) ticks before pre-wrap (large-value) ticks
    # even though the post-wrap ones happened later in the recording -
    # scrambling cluster order. Fix: wrap-correct + convert to frames per
    # tick first, drop anything outside [0, VIDEO_FRAME_COUNT] right there
    # (defense against a foreign PTS era surviving the wrap correction),
    # THEN sort the resulting frame numbers, THEN cluster. Clustering on
    # ascending input guarantees start<=end for every emitted range, but
    # the emission still checks it explicitly as a second line of defense.
    if [ -n "${VIDEO_CORRUPT_DTS_TICKS:-}" ] && [ -n "$FIRST_VIDEO_PTS" ]; then
        CORRUPT_RANGES=$(printf '%s\n' "$VIDEO_CORRUPT_DTS_TICKS" | grep -v '^$' | awk -v fvp="$FIRST_VIDEO_PTS" -v fps="$FRAME_RATE_DEC" -v maxf="${VIDEO_FRAME_COUNT:-0}" '
            BEGIN { fvp_ticks = fvp * 90000.0; wrap33 = 8589934592 }
            { d = $1 - fvp_ticks
              while (d < 0) d += wrap33
              f = int((d/90000.0) * fps)
              if (f < 0 || f > maxf) next
              print f }' | sort -n | awk -v fps="$FRAME_RATE_DEC" '
            { f = $1
              if (state && f - last <= 2*fps) { last = f; next }        # <=2s: same range
              if (state) { if (start <= last) { printf "%s%d-%d", sep, start, last; sep="," } }
              start = f; last = f; state = 1 }
            END { if (state && start <= last) printf "%s%d-%d", sep, start, last }')
        if [ -n "$CORRUPT_RANGES" ]; then
            write_warnings_header_if_needed
            echo "corrupt_frame_ranges=$CORRUPT_RANGES" >> "$OUTPUT_INFO"
            warn "  Corrupt video frame(s) at $(format_ranges_hms "$CORRUPT_RANGES" "$FRAME_RATE_DEC")"
        fi
    fi

    # Add VDR markers if found
    if [ ${#VDR_MARKS[@]} -gt 0 ]; then
        cat >> "$OUTPUT_INFO" << EOF

[markers]
# VDR markad markers (from: $MARKS_FILE)
# Format: index=timestamp|frame|type|verified
# type: start=content starts (ad ends), stop=content stops (ad starts), mark=unknown
count=${#VDR_MARKS[@]}
EOF
        for i in "${!VDR_MARKS[@]}"; do
            echo "marker_${i}=${VDR_MARKS[$i]}" >> "$OUTPUT_INFO"
        done
        info "  Added ${#VDR_MARKS[@]} VDR markers to info file"
    fi

    # Copy markad logo PGM if available
    pgm_file=$(find "$INPUT_DIR" -maxdepth 1 -name '*-P0.pgm' -type f 2>/dev/null | head -1)
    if [ -n "$pgm_file" ]; then
        logo_dest="${OUTDIR}/${BASENAME}.logo.pgm"
        cp "$pgm_file" "$logo_dest"
        info "Logo PGM copied: $(basename "$pgm_file") -> $(basename "$logo_dest")"
    fi

    # Summary
    echo ""
    info "=== Elementary Stream Demux Complete ==="
    echo ""
    info "Output files:"
    while IFS= read -r line; do
        info "  $line"
    done < <(ls -lh "$OUTDIR/${BASENAME}"* 2>/dev/null | grep -v "^total" || true)
    echo ""
    info "Video for TTCut: $OUTPUT_VIDEO"
    info "Info file: $OUTPUT_INFO"
    if [ ${#AUDIO_FILES[@]} -gt 0 ]; then
        info "Audio files: ${#AUDIO_FILES[@]} track(s)"
    fi

fi

#############################################################################
# CLEANUP
#############################################################################
# Remove temporary repaired file
if [ "${CLEANUP_REPAIRED:-false}" = "true" ] && [ -f "$REPAIRED_INPUT" ]; then
    rm -f "$REPAIRED_INPUT"
fi

# Done. The file itself goes away with _CLEANUP_FILES on exit; a wrapper
# polling it sees 100 for as long as it takes to notice the process ended.
progress_set 100
