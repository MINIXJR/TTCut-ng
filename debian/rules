#!/usr/bin/make -f
# -*- makefile -*-

%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=build-deb

# No ctest suite (tests are the standalone tools/diag harnesses); the ninja
# buildsystem would otherwise run 'ninja test', which has no such target.
override_dh_auto_test:

# Native package: dh would ship only debian/changelog. Pass CHANGELOG.md so the
# full user-facing history is installed as changelog.gz (debian/changelog then
# becomes changelog.Debian.gz, matching the pre-native layout).
override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md

override_dh_auto_build:
	# Compile translation files
	/usr/lib/qt6/bin/lrelease trans/ttcut-ng_de_DE.ts
	dh_auto_build

override_dh_auto_install:
	install -D -m 0755 build-deb/ttcut-ng $(CURDIR)/debian/ttcut-ng/usr/bin/ttcut-ng
	install -D -m 0755 tools/ttcut-demux/ttcut-demux $(CURDIR)/debian/ttcut-ng/usr/bin/ttcut-demux
	install -D -m 0755 tools/ttcut-ac3fix/ttcut-ac3fix $(CURDIR)/debian/ttcut-ng/usr/bin/ttcut-ac3fix
	install -D -m 0755 tools/ttcut-audiofix/ttcut-audiofix $(CURDIR)/debian/ttcut-ng/usr/bin/ttcut-audiofix
	install -D -m 0755 tools/ttcut-demux/ttcut-ocr-glyphs $(CURDIR)/debian/ttcut-ng/usr/bin/ttcut-ocr-glyphs
	install -d $(CURDIR)/debian/ttcut-ng/usr/share/ttcut-ng/ocr-glyphs
	install -m 0644 tools/ttcut-demux/ocr-glyphs/*.png $(CURDIR)/debian/ttcut-ng/usr/share/ttcut-ng/ocr-glyphs/
	# Sidecars carry the per-glyph OCR confusion lists - without them
	# the packaged helper falls back to punctuation-only repair.
	install -m 0644 tools/ttcut-demux/ocr-glyphs/*.txt $(CURDIR)/debian/ttcut-ng/usr/share/ttcut-ng/ocr-glyphs/
	install -D -m 0755 tools/ttcut-pts-analyze/ttcut-pts-analyze $(CURDIR)/debian/ttcut-ng/usr/bin/ttcut-pts-analyze
	install -D -m 0755 tools/ttcut-quality-check/ttcut-quality-check.py $(CURDIR)/debian/ttcut-ng/usr/bin/ttcut-quality-check
	install -D -m 0644 ttcut.desktop $(CURDIR)/debian/ttcut-ng/usr/share/applications/ttcut-ng.desktop
	install -D -m 0644 ui/pixmaps/ttcut_logo_001.png $(CURDIR)/debian/ttcut-ng/usr/share/pixmaps/ttcut-ng.png
	# Install translation files
	install -d $(CURDIR)/debian/ttcut-ng/usr/share/ttcut-ng/trans
	install -D -m 0644 trans/*.qm $(CURDIR)/debian/ttcut-ng/usr/share/ttcut-ng/trans/

override_dh_auto_clean:
	dh_auto_clean
	# Tool binaries land in the source tree (RUNTIME_OUTPUT_DIRECTORY)
	rm -f tools/ttcut-pts-analyze/ttcut-pts-analyze tools/ttcut-ac3fix/ttcut-ac3fix tools/ttcut-audiofix/ttcut-audiofix
