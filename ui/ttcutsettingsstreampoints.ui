     <item row="8" column="0" colspan="2">
      <widget class="QLabel" name="laVideoMpeg2Only">
       <property name="text"><string>MPEG-2 only</string></property>
       <property name="styleSheet"><string notr="true">QLabel { font-style: italic; padding-left: 10px; }</string></property>
