     </item>
     <item row="9" column="0" colspan="2">
      <widget class="QCheckBox" name="cbAspectChange">
       <property name="text"><string>Aspect ratio (4:3/16:9)</string></property>
       <property name="styleSheet"><string notr="true">padding-left: 20px;</string></property>
       <property name="toolTip"><string>Reads the aspect ratio from MPEG-2 sequence headers. Has no effect on H.264/H.265, which carry no such headers.</string></property>
      </widget>
