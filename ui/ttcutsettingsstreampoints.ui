      </widget>
     </item>

     <item row="2" column="0" colspan="2">
      <widget class="QCheckBox" name="cbSilence">
       <property name="text"><string>Silence</string></property>
       <property name="styleSheet"><string notr="true">padding-left: 20px;</string></property>
       <property name="toolTip"><string>Finds passages quieter than the threshold for at least the minimum duration.</string></property>
      </widget>
     </item>
     <item row="3" column="0">
      <widget class="QLabel" name="laSilenceThreshold">
       <property name="text"><string>Threshold (dB):</string></property>
       <property name="styleSheet"><string notr="true">padding-left: 40px;</string></property>
      </widget>
     </item>
     <item row="3" column="1">
      <widget class="QSpinBox" name="sbSilenceThreshold">
       <property name="minimum"><number>-80</number></property>
       <property name="maximum"><number>-20</number></property>
       <property name="suffix"><string> dB</string></property>
      </widget>
     </item>
     <item row="4" column="0">
      <widget class="QLabel" name="laSilenceMinDuration">
       <property name="text"><string>Minimum duration (s):</string></property>
       <property name="styleSheet"><string notr="true">padding-left: 40px;</string></property>
      </widget>
     </item>
     <item row="4" column="1">
      <widget class="QDoubleSpinBox" name="sbSilenceMinDuration">
       <property name="minimum"><double>0.100000000000000</double></property>
       <property name="maximum"><double>5.000000000000000</double></property>
       <property name="singleStep"><double>0.100000000000000</double></property>
       <property name="decimals"><number>1</number></property>
       <property name="suffix"><string> s</string></property>
      </widget>
     </item>

     <item row="5" column="0" colspan="2">
      <widget class="QCheckBox" name="cbAudioChange">
       <property name="text"><string>Audio format change</string></property>
       <property name="styleSheet"><string notr="true">padding-left: 20px;</string></property>
       <property name="toolTip"><string>Finds points where the audio format changes (e.g. stereo to 5.1).</string></property>
      </widget>
     </item>

     <!-- Blank row: without it the Video heading sits as close to the last
